+        const int sc32 = sc[kqsx/2] >> (6*(kqsx%2));
+        const float dl0 = d * (2*((sc32 >> 0) & 0x07) + 1);
+        const float dl1 = d * (2*((sc32 >> 3) & 0x07) + 1);
