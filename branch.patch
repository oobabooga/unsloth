+    assert _lsa.resolve_effective_memory_state(out, env, auto_unmapped = True) == (False, False)
+    # Off an iGPU auto already maps; a chosen mmap needs nothing either way.
+    assert _lsa.force_pageable_load([], {}) == ([], [])
