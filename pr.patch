+def _sdpa_by_backend(monkeypatch, torch, behaviour):
+    """Route F.scaled_dot_product_attention by the backend sdpa_kernel selected."""
+    real = torch.nn.functional.scaled_dot_product_attention
+
+    def _sdpa(q, k, v, *a, **kw):
+        if torch.backends.cuda.math_sdp_enabled():
+            return real(q, k, v, *a, **kw)
+        name = att.SDPA_FLASH if torch.backends.cuda.flash_sdp_enabled() else att.SDPA_MEM_EFFICIENT
+        return behaviour.get(name, real)(q, k, v, *a, **kw)
+
+    monkeypatch.setattr(torch.nn.functional, "scaled_dot_product_attention", _sdpa)
+
+
+def test_the_failing_backend_probe_tells_a_broken_kernel_from_a_refused_shape(monkeypatch):
+    torch = pytest.importorskip("torch")
+
+    class _Pending:
+        def float(self):
+            raise RuntimeError("CUDA error: invalid argument")
+
+    def _late_failure(*a, **kw):
+        return _Pending()
+
+    def _refused(*a, **kw):
+        raise RuntimeError("No available kernel. Aborting execution.")
+
+    # A late hipErrorInvalidValue is broken; a dispatcher refusal is not (the dispatch never picks it there).
+    _sdpa_by_backend(
+        monkeypatch, torch, {att.SDPA_FLASH: _late_failure, att.SDPA_MEM_EFFICIENT: _refused}
+    )
+    assert att._rocm_windows_failing_sdpa_backends("cpu", torch.float32) == (att.SDPA_FLASH,)
+
+
+def test_the_failing_backend_probe_flags_wrong_output(monkeypatch):
+    torch = pytest.importorskip("torch")
+    real = torch.nn.functional.scaled_dot_product_attention
+
+    def _garbage(q, k, v, *a, **kw):
+        return torch.zeros_like(real(q, k, v, *a, **kw))
+
+    _sdpa_by_backend(monkeypatch, torch, {att.SDPA_MEM_EFFICIENT: _garbage})
+    assert att._rocm_windows_failing_sdpa_backends("cpu", torch.float32) == (
+        att.SDPA_MEM_EFFICIENT,
+    )
+
+
