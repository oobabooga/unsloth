+# Windows ROCm wheels whose fused SDPA kernels misfire (torch 2.11.0+rocm7.14.1, or a venv missing the AOTriton
+# kernel pack) fail with hipErrorInvalidValue, raised only at the next checked launch, so a generation dies on an
+# unrelated op. `import unsloth` turns those backends off (fix_rocm_windows_fused_sdpa); this process never imports it.
+ROCM_FUSED_SDPA_ALLOW_ENV = "UNSLOTH_ALLOW_ROCM_FUSED_SDPA"
+_ROCM_FUSED_SDPA_LOCK = threading.Lock()
+# (device, dtype) -> fused backends that failed there. Only answers are cached.
+_ROCM_FUSED_SDPA_BROKEN: dict[tuple[str, str], tuple[str, ...]] = {}
+
+
+def _rocm_windows_failing_sdpa_backends(device: str, dtype: Any) -> Optional[tuple[str, ...]]:
+    """The fused SDPA backends that raise or disagree with math on ``device``; None when math itself fails."""
+    import torch
+    import torch.nn.functional as F
+    from torch.nn.attention import SDPBackend, sdpa_kernel
+
+    # The denoiser's non-causal head-128 attention, a text encoder's causal one, and #12639's small probe.
+    g = torch.Generator(device = device).manual_seed(0)
+    cases = [
+        (
+            tuple(torch.randn(*shape, device = device, dtype = dtype, generator = g) for _ in range(3)),
+            causal,
+        )
+        for shape, causal in (
+            ((1, 4, 1024, 128), False),
+            ((1, 4, 256, 128), True),
+            ((1, 2, 16, 64), True),
+        )
+    ]
+
+    def attend(backend: Any, qkv: tuple, causal: bool) -> Any:
+        with sdpa_kernel([backend]):
+            out = F.scaled_dot_product_attention(*qkv, is_causal = causal)
+        out = out.float()  # checked launch: a failed attention launch raises here
+        out.sum().item()
+        return out
+
+    with torch.no_grad():
+        try:
+            reference = [attend(SDPBackend.MATH, qkv, causal) for qkv, causal in cases]
+        except Exception:  # noqa: BLE001 - math fails too: nothing to learn about the fused kernels
+            return None
+        broken = []
+        for name, backend in (
+            (SDPA_FLASH, SDPBackend.FLASH_ATTENTION),
+            (SDPA_MEM_EFFICIENT, SDPBackend.EFFICIENT_ATTENTION),
+        ):
+            for (qkv, causal), ref in zip(cases, reference):
+                try:
+                    ok = torch.allclose(attend(backend, qkv, causal), ref, atol = 2e-2, rtol = 2e-2)
+                except Exception as exc:  # noqa: BLE001
+                    # The dispatcher refusing a shape is not a broken kernel: it never picks it there.
+                    ok = "No available kernel" in str(exc)
+                if not ok:
+                    broken.append(name)
+                    break
+    return tuple(broken)
+
+
+def guard_rocm_windows_fused_sdpa(target: Any, logger: Any = None) -> tuple[str, ...]:
+    """On Windows ROCm, turn off the fused SDPA backends that fail on ``target``, so attention runs on math.
+
+    Process-wide, like the flags it sets, and re-applied on every load; probe-gated, so a healthy wheel keeps its
+    kernels. Returns what it turned off. ``UNSLOTH_ALLOW_ROCM_FUSED_SDPA=1`` skips it."""
+    import sys
+
+    if sys.platform != "win32" or not _is_cuda_rocm(target):
+        return ()
+    if os.environ.get(ROCM_FUSED_SDPA_ALLOW_ENV, "").strip().lower() in ("1", "true", "yes", "on"):
+        return ()
+    fresh = False
+    try:
+        import torch
+
+        device = _indexed_cuda_device(
+            str(getattr(target, "torch_device", None) or getattr(target, "device", None) or "")
+        )
+        dtype = getattr(target, "dtype", None)
+        if dtype not in (torch.float16, torch.bfloat16):
+            # The fused kernels are half precision only; an fp32 pipeline still runs a half-precision text encoder.
+            from core.inference.rocm_bf16 import rocm_bf16_supported
+            dtype = (
+                torch.bfloat16
+                if rocm_bf16_supported(torch, torch.device(device).index)
+                else torch.float16
+            )
+        key = (device, str(dtype))
+        with _ROCM_FUSED_SDPA_LOCK:
+            broken = _ROCM_FUSED_SDPA_BROKEN.get(key)
+            if broken is None:
+                broken = _rocm_windows_failing_sdpa_backends(device, dtype)
+                if broken is None:
+                    return ()
+                _ROCM_FUSED_SDPA_BROKEN[key] = broken
+                fresh = True
+            if SDPA_FLASH in broken:
+                torch.backends.cuda.enable_flash_sdp(False)
+            if SDPA_MEM_EFFICIENT in broken:
+                torch.backends.cuda.enable_mem_efficient_sdp(False)
+        if fresh and broken:
+            # After the flags: a kernel list cached before them still counts what was just switched off.
+            with _SDPA_PROBE_LOCK:
+                _SDPA_PROBE_CACHE.clear()
+    except Exception as exc:  # noqa: BLE001 - a probe is a guard, never a load failure
+        _module_logger().info(
+            "diffusion.attention: skipped the Windows ROCm fused SDPA check (%s)", exc
+        )
+        return ()
+    if fresh and broken:
+        names = " or ".join("flash" if b == SDPA_FLASH else "memory-efficient" for b in broken)
+        (logger or _module_logger()).warning(
+            "diffusion.attention: this Windows ROCm torch cannot run %s attention on %s (%s); using %s instead "
+            "(set %s=1 to keep them)",
+            names,
+            device,
+            dtype,
+            "the math kernel" if len(broken) == 2 else "the remaining kernels",
+            ROCM_FUSED_SDPA_ALLOW_ENV,
+        )
+    return broken
+
+
 def select_attention_backend(
     target: Any,
     requested: Optional[str],
@@ -1776,6 +1903,8 @@ def apply_attention_backend(
     a fresh transformer's processors follow it (default None). So a load wanting native must
     restore it explicitly, else it inherits a backend an earlier load pinned (e.g. cuDNN under a
     speed profile), breaking the ``off`` guarantee. Best-effort."""
+    if target is not None:
+        guard_rocm_windows_fused_sdpa(target, logger)
     setters = [
         s
         for s in (getattr(t, "set_attention_backend", None) for t in _attention_dits(pipe))
diff --git a/studio/backend/tests/test_diffusion_attention.py b/studio/backend/tests/test_diffusion_attention.py
index ce4bc63a44..59e5e740b4 100644
--- a/studio/backend/tests/test_diffusion_attention.py
+++ b/studio/backend/tests/test_diffusion_attention.py
@@ -1065,3 +1065,183 @@ def test_an_unanswerable_probe_is_not_memoised(monkeypatch):
     assert att.available_sdpa_kernels(_target()) == ("flash", "math")
     assert att.available_sdpa_kernels(_target()) == ("flash", "math")
     assert len(calls) == 2, "the answer must be memoised; the failure must not be"
+
+
+# ── Windows ROCm: fused SDPA backends that fail are turned off ───────────────────
+
+
+@pytest.fixture
+def _sdp_flags():
+    """The guard flips process-wide torch flags; put them back."""
+    torch = pytest.importorskip("torch")
+    before = (
+        torch.backends.cuda.flash_sdp_enabled(),
+        torch.backends.cuda.mem_efficient_sdp_enabled(),
+    )
+    att._ROCM_FUSED_SDPA_BROKEN.clear()
+    yield torch
+    torch.backends.cuda.enable_flash_sdp(before[0])
+    torch.backends.cuda.enable_mem_efficient_sdp(before[1])
+    att._ROCM_FUSED_SDPA_BROKEN.clear()
+
+
+def _windows_rocm(
+    monkeypatch,
+    verdict,
+    calls = None,
+    *,
+    platform = "win32",
+    rocm = True,
+):
+    monkeypatch.setattr(sys, "platform", platform)
+    monkeypatch.setattr(att, "_is_cuda_rocm", lambda target: rocm)
+    monkeypatch.delenv(att.ROCM_FUSED_SDPA_ALLOW_ENV, raising = False)
+
+    def _failing(device, dtype):
+        if calls is not None:
+            calls.append((device, dtype))
+        return verdict
+
+    monkeypatch.setattr(att, "_rocm_windows_failing_sdpa_backends", _failing)
+
+
+def test_failing_fused_backends_are_turned_off_and_stay_off_across_loads(monkeypatch, _sdp_flags):
+    # torch 2.11.0+rocm7.14.1 on Windows: every fused call fails with hipErrorInvalidValue at the next checked
+    # launch, so an image generation died on an unrelated op. The guard turns both off; math runs instead.
+    torch = _sdp_flags
+    calls: list = []
+    _windows_rocm(monkeypatch, (att.SDPA_FLASH, att.SDPA_MEM_EFFICIENT), calls)
+    target = types.SimpleNamespace(device = "cuda:0", dtype = torch.bfloat16)
+    assert att.guard_rocm_windows_fused_sdpa(target) == (att.SDPA_FLASH, att.SDPA_MEM_EFFICIENT)
+    assert not torch.backends.cuda.flash_sdp_enabled()
+    assert not torch.backends.cuda.mem_efficient_sdp_enabled()
+    # Something else turns them back on (another engine, a restore): the next load re-applies the cached verdict.
+    torch.backends.cuda.enable_flash_sdp(True)
+    torch.backends.cuda.enable_mem_efficient_sdp(True)
+    assert att.guard_rocm_windows_fused_sdpa(target) == (att.SDPA_FLASH, att.SDPA_MEM_EFFICIENT)
+    assert not torch.backends.cuda.flash_sdp_enabled()
+    assert calls == [("cuda:0", torch.bfloat16)]
+
+
+def test_only_the_failing_backend_is_turned_off(monkeypatch, _sdp_flags):
+    torch = _sdp_flags
+    torch.backends.cuda.enable_flash_sdp(True)
+    torch.backends.cuda.enable_mem_efficient_sdp(True)
+    _windows_rocm(monkeypatch, (att.SDPA_FLASH,))
+    att.guard_rocm_windows_fused_sdpa(types.SimpleNamespace(device = "cuda:0", dtype = torch.bfloat16))
+    assert not torch.backends.cuda.flash_sdp_enabled()
+    assert torch.backends.cuda.mem_efficient_sdp_enabled()
+
+
+def test_a_healthy_wheel_keeps_its_fused_kernels(monkeypatch, _sdp_flags):
+    torch = _sdp_flags
+    torch.backends.cuda.enable_flash_sdp(True)
+    torch.backends.cuda.enable_mem_efficient_sdp(True)
+    _windows_rocm(monkeypatch, ())
+    assert (
+        att.guard_rocm_windows_fused_sdpa(
+            types.SimpleNamespace(device = "cuda:0", dtype = torch.bfloat16)
+        )
+        == ()
+    )
+    assert (
+        torch.backends.cuda.flash_sdp_enabled() and torch.backends.cuda.mem_efficient_sdp_enabled()
+    )
+
+
+@pytest.mark.parametrize("platform, rocm", [("linux", True), ("win32", False)])
