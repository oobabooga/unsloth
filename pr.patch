+
+def test_a_probe_that_could_not_run_changes_nothing_and_is_retried(monkeypatch, _sdp_flags):
+    torch = _sdp_flags
+    torch.backends.cuda.enable_flash_sdp(True)
+    calls: list = []
+    _windows_rocm(monkeypatch, None, calls)
+    target = types.SimpleNamespace(device = "cuda:0", dtype = torch.float16)
+    assert att.guard_rocm_windows_fused_sdpa(target) == ()
+    assert att.guard_rocm_windows_fused_sdpa(target) == ()
+    assert torch.backends.cuda.flash_sdp_enabled()
