+void llama_model_dflash::graph_dspark::build_inkling2_block(ggml_tensor * tokens, ggml_tensor * hidden) {
+    GGML_ASSERT(ubatch.n_seqs_unq == 1 && n_tokens == hparams.dflash_block_size && n_outputs < n_tokens);
