+        if (vocab_mask) {
+            cur = ggml_add(ctx0, cur, vocab_mask);
+        }
+        cb(cur, "result_output", -1);
+        res->t_logits = cur;
+    }
+
+    ggml_build_forward_expand(gf, cur);
+}
