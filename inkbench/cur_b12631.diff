+    {%- elif e == 'low' -%}{%- set eff = 0.2 -%}
+    {%- elif e == 'medium' -%}{%- set eff = 0.7 -%}
+    {%- elif e == 'high' -%}{%- set eff = 0.9 -%}
+    {%- elif e == 'xhigh' -%}{%- set eff = 0.99 -%}
+    {%- elif e == 'max' -%}{%- set eff = 0.99 -%}
