+    if (!cparams.embeddings) {
+        cur = ggml_scale(ctx0, cur, hparams.f_logit_scale);
+        cur = build_lora_mm(
+            model.output, cur, nullptr,
+            model.output->type == GGML_TYPE_F32 ? GGML_PREC_F32_PEDANTIC : GGML_PREC_UNDEFINED);
