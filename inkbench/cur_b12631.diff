+        r.first  = r.first & ~(page_size - 1);
+        r.second = std::min((r.second + page_size - 1) & ~(page_size - 1), limit);
+    }
+    std::sort(rs.begin(), rs.end());
+
+    ranges res;
+    for (const auto & r : rs) {
+        if (r.first >= r.second) {
+            continue;
+        }
+        if (!res.empty() && r.first <= res.back().second) {
+            res.back().second = std::max(res.back().second, r.second);
+        } else {
+            res.push_back(r);
+        }
+    }
+
+    return res;
+}
