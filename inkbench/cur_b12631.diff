+    if (K->type == GGML_TYPE_F32 || V->type == GGML_TYPE_F32) {
+        return false;
+    }
+
+    if ((Q->ne[0] != 64 && Q->ne[0] != 128) || V->ne[0] != Q->ne[0]) {
+        return false;
+    }
+
+    return turing_mma_available(ggml_cuda_info().devices[device].cc);
+}
