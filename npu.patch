+class _NpuStreamRelay:
+    """Rewrites FastFlowLM's stream into what Unsloth promises a caller.
+
+    The reported model becomes the loaded ``lemonade:`` id (FastFlowLM names its own checkpoint,
+    ``qwen3:0.6b``), and ``stop`` is enforced here because FastFlowLM ignores it: content is held
+    back while it could still be the start of a stop sequence, and on a match the reply ends with
+    ``finish_reason: "stop"``. Returning then closes the upstream stream, which ends FastFlowLM's
+    generation. Also collects the reply, for a caller that asked for one JSON response."""
+
+    def __init__(self, public_model: str, stop: Optional[list[str]]) -> None:
+        self.public_model = public_model
+        self.stop = stop or []
+        self._pending = ""
+        self.stopped = False
+        self.content = ""
+        self.reasoning = ""
+        self.tool_calls: dict[int, dict] = {}
+        self.finish_reason: Optional[str] = None
+        self.usage: Optional[dict] = None
+        self.error: Optional[dict] = None
+        self.completion_id: Optional[str] = None
+        self.created: Optional[int] = None
