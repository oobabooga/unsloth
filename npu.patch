+def _apply_fastflowlm_reasoning_controls(
+    body: dict[str, Any], enable_thinking: Optional[bool], reasoning_effort: Optional[str]
+) -> None:
+    """FastFlowLM's own ``think`` switch; it reads neither enable_thinking nor chat_template_kwargs.
+
+    Without an explicit ``think`` a reasoning model decides for itself, and a reply cut off by the
+    token limit keeps the raw ``<think>`` block in ``content``. ``reasoning_effort`` passes only
+    as a level (gpt-oss reads it); ``none`` means thinking off."""
+    effort = (reasoning_effort or "").strip().lower()
+    if effort == "none":
+        body["think"] = False
+        return
+    if enable_thinking is not None:
+        body["think"] = bool(enable_thinking)
+    if effort in ("low", "medium", "high") and body.get("think", True):
+        body["reasoning_effort"] = effort
+
