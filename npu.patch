+# SPDX-License-Identifier: AGPL-3.0-only
+# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved. See /studio/LICENSE.AGPL-3.0
+
+"""The NPU backend against a real child process speaking lemond's API.
+
+``tests/fixtures/fake_lemond.py`` stands in for lemond, so these run the actual spawn, the
+key-authenticated readiness check, config seeding, enable, catalog, download, load, unload and
+the process-tree stop. The installer is stubbed to point at it; POSIX only because the stub
+"binary" is a shell script.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import sys
+import textwrap
+from pathlib import Path
+
+import pytest
+
+from core.inference import npu_backend as nb
+from core.inference.lemonade_server import LemonadeServer, LemonadeUnavailable
+
+pytestmark = pytest.mark.skipif(sys.platform == "win32", reason = "shell-script lemond stand-in")
+
+_FAKE = Path(__file__).parent / "fixtures" / "fake_lemond.py"
+
+
+def _binary(tmp_path: Path) -> Path:
+    binary = tmp_path / "bin" / "lemond"
+    binary.parent.mkdir(parents = True)
+    binary.write_text(
+        textwrap.dedent(
+            f"""\
+            #!/bin/sh
+            exec "{sys.executable}" "{_FAKE}" "$@"
+            """
+        ),
+        encoding = "utf-8",
+    )
+    binary.chmod(0o755)
+    return binary
+
+
+class _Installer:
+    def __init__(self, binary: Path) -> None:
+        self.binary = binary
+        self.installs = 0
+
+    def installed_lemond(self, root):
+        return self.binary
+
+    def install(self, root):
+        self.installs += 1
+        return self.binary
+
+
+@pytest.fixture
+def npu(tmp_path, monkeypatch):
+    installer = _Installer(_binary(tmp_path))
+    monkeypatch.setattr(nb, "_installer_module", lambda: installer)
+    monkeypatch.setattr(
+        nb,
+        "detect_amd_npu",
