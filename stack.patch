+    monkeypatch.setattr(q4nx, "require_converter_deps", lambda: None)
+    monkeypatch.setattr(q4nx, "_installer", lambda: pytest.fail("installer must not run"))
+    source = _gguf_with(tmp_path / "m.gguf", arch, layers, hidden, **extra)
