+        with pytest.raises(ff.FlmDownloadError, match = r"already downloading .*\(PID \d+\)") as busy:
+            list(ff.download_files(files.model(tmp_path)))
+        assert f"(PID {os.getpid()})" not in str(busy.value)
+        assert files.ranges == []
+    finally:
