From 9972db8059e2e4241b1efdcddf7a03417521d206 Mon Sep 17 00:00:00 2001
From: danielhanchen <danielhanchen@gmail.com>
Date: Wed, 21 Oct 2026 23:49:52 -0700
Subject: [PATCH 2/2] llama: allow pipeline parallelism with a CPU stage before
 RPC stages

Upstream enables scheduler pipeline parallelism only when every layer and
the output are on non-CPU devices. When all devices are RPC, the CPU stage
(first layers on this host) runs synchronously while the RPC backend queues
compute and copies without blocking, so the remote stages of ubatch i overlap
the CPU stage of ubatch i+1. LLAMA_RPC_PIPELINE_PARALLEL=0 restores the
upstream rule; nothing changes when no RPC device is used.
---
 src/llama-context.cpp | 21 ++++++++++++++++++---
 1 file changed, 18 insertions(+), 3 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 0a814e89f..bd5a3d36b 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -516,9 +516,24 @@ llama_context::llama_context(
 
         // TODO: move these checks to ggml_backend_sched
         // enabling pipeline parallelism in the scheduler increases memory usage, so it is only done when necessary
+        // RPC: a CPU stage (the first layers on this host) followed by RPC stages can pipeline too. The CPU split
+        // runs synchronously, while the RPC backend copies activations between stages without blocking this thread,
+        // so the remote stages of ubatch i overlap the CPU stage of ubatch i+1 and each other.
+        // LLAMA_RPC_PIPELINE_PARALLEL=0 restores the upstream rule (all layers and the output on non-CPU devices).
+        bool rpc_pipeline = false;
+        {
+            const char * env = getenv("LLAMA_RPC_PIPELINE_PARALLEL");
+            const bool all_rpc = model.n_devices() > 0 &&
+                std::all_of(model.devices.begin(), model.devices.end(), [](const auto & d) {
+                    return strcmp(ggml_backend_reg_name(ggml_backend_dev_backend_reg(d.dev)), "RPC") == 0;
+                });
+            const bool cpu_stage = model.n_gpu_layers() <= model.hparams.n_layer_all;
+            rpc_pipeline = (env == nullptr || atoi(env) != 0) && all_rpc && model.n_gpu_layers() > 0 &&
+                           model.n_devices() + (cpu_stage ? 1 : 0) > 1;
+        }
+
         bool pipeline_parallel =
-            model.n_devices() > 1 &&
-            model.n_gpu_layers() > model.hparams.n_layer_all &&
+            ((model.n_devices() > 1 && model.n_gpu_layers() > model.hparams.n_layer_all) || rpc_pipeline) &&
             model.split_mode() == LLAMA_SPLIT_MODE_LAYER &&
             cparams.offload_kqv &&
             !model.has_tensor_overrides() &&
@@ -547,7 +562,7 @@ llama_context::llama_context(
         cparams.pipeline_parallel = pipeline_parallel;
 
         if (cparams.pipeline_parallel) {
-            LLAMA_LOG_INFO("%s: pipeline parallelism enabled\n", __func__);
+            LLAMA_LOG_INFO("%s: pipeline parallelism enabled%s\n", __func__, rpc_pipeline ? " (RPC stages)" : "");
         }
 
         if (cparams.moe_cache_size > 0) {
-- 
