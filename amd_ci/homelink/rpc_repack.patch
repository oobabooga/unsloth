+    for (auto & v : repack_views) {
+        ggml_backend_buffer_free(v.second);
+    }
     for (auto buffer : buffers) {
         ggml_backend_buffer_free(buffer);
     }
diff --git a/tests/test-rpc-repack.cpp b/tests/test-rpc-repack.cpp
new file mode 100644
index 000000000..688904747
--- /dev/null
+++ b/tests/test-rpc-repack.cpp
@@ -0,0 +1,189 @@
+// Client-side checks for rpc-server --repack (GGML_RPC_REPACK=1).
+// usage: test-rpc-repack <host:port> <mode>
+//   main     : mixed get_rows + mul_mat weight (must stay plain) and matmul-only weights (repacked), results vs local CPU,
+//              then a full re-upload of a repacked weight followed by another matmul
+//   get      : GET_TENSOR of a repacked weight (server must refuse -> client aborts)
+//   getrows  : a later graph uses a repacked weight in get_rows (server must refuse -> client aborts)
+//   partial  : partial SET_TENSOR into a repacked weight (server must refuse -> client aborts)
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+#include "ggml-rpc.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+static std::vector<uint8_t> make_weight(ggml_type type, int64_t k, int64_t n, uint32_t seed) {
+    std::mt19937 rng(seed);
+    std::uniform_real_distribution<float> d(-1.0f, 1.0f);
+    std::vector<float> f(k*n);
+    for (auto & v : f) {
+        v = d(rng);
+    }
+    std::vector<uint8_t> q(ggml_row_size(type, k)*n);
+    ggml_quantize_chunk(type, f.data(), q.data(), 0, n, k, nullptr);
+    return q;
+}
+
+struct model {
+    ggml_context * ctx = nullptr;
+    ggml_backend_buffer_t buf = nullptr;
+    ggml_tensor * w4 = nullptr;   // q4_K, matmul only   -> CPU_REPACK
+    ggml_tensor * w6 = nullptr;   // q6_K, matmul only   -> AMX (if built), else plain on x86
+    ggml_tensor * wm = nullptr;   // q4_K, get_rows + matmul in one graph -> must stay plain
+    ggml_tensor * n  = nullptr;   // f32 norm-like weight, mul only
+};
+
+static const int64_t K = 512, N = 64, B = 16;
+
+static model make_model(ggml_backend_t be, const std::vector<uint8_t> & d4, const std::vector<uint8_t> & d6,
+                        const std::vector<uint8_t> & dm, const std::vector<float> & dn) {
+    model m;
+    ggml_init_params ip = { 16*ggml_tensor_overhead(), nullptr, true };
+    m.ctx = ggml_init(ip);
+    m.w4 = ggml_new_tensor_2d(m.ctx, GGML_TYPE_Q4_K, K, N); ggml_set_name(m.w4, "w4");
+    m.w6 = ggml_new_tensor_2d(m.ctx, GGML_TYPE_Q6_K, K, N); ggml_set_name(m.w6, "w6");
+    m.wm = ggml_new_tensor_2d(m.ctx, GGML_TYPE_Q4_K, K, N); ggml_set_name(m.wm, "wm");
+    m.n  = ggml_new_tensor_1d(m.ctx, GGML_TYPE_F32, N);     ggml_set_name(m.n, "norm");
+    m.buf = ggml_backend_alloc_ctx_tensors(m.ctx, be);
+    ggml_backend_buffer_set_usage(m.buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    ggml_backend_tensor_set(m.w4, d4.data(), 0, d4.size());
+    ggml_backend_tensor_set(m.w6, d6.data(), 0, d6.size());
+    ggml_backend_tensor_set(m.wm, dm.data(), 0, dm.size());
+    ggml_backend_tensor_set(m.n,  dn.data(), 0, dn.size()*sizeof(float));
+    return m;
+}
+
+enum gkind { G_MATMUL, G_MIXED, G_GETROWS_W4 };
+
+// returns concatenated outputs
+static std::vector<float> run(ggml_backend_t be, const model & m, gkind kind, const std::vector<float> & x) {
+    ggml_init_params ip = { 64*ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_tensor * xin = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, K, B); ggml_set_input(xin);
+    ggml_tensor * ids = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 4);    ggml_set_input(ids);
+    std::vector<ggml_tensor *> outs;
+    if (kind == G_MATMUL) {
+        outs.push_back(ggml_mul(ctx, ggml_mul_mat(ctx, m.w4, xin), m.n));
+        outs.push_back(ggml_mul_mat(ctx, m.w6, xin));
+    } else if (kind == G_MIXED) {
+        outs.push_back(ggml_mul_mat(ctx, m.wm, xin));
+        outs.push_back(ggml_get_rows(ctx, m.wm, ids));   // dequantizing get_rows on the same weight
+    } else {
+        outs.push_back(ggml_get_rows(ctx, m.w4, ids));
+    }
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    for (auto * o : outs) {
+        ggml_set_output(o);
+        ggml_build_forward_expand(gf, o);
+    }
+    ggml_backend_buffer_t cbuf = ggml_backend_alloc_ctx_tensors(ctx, be);
+    ggml_backend_tensor_set(xin, x.data(), 0, x.size()*sizeof(float));
+    int32_t idv[4] = { 0, 5, 17, 63 };
+    ggml_backend_tensor_set(ids, idv, 0, sizeof(idv));
+    GGML_ASSERT(ggml_backend_graph_compute(be, gf) == GGML_STATUS_SUCCESS);
+    std::vector<float> res;
+    for (auto * o : outs) {
+        std::vector<float> r(ggml_nelements(o));
+        ggml_backend_tensor_get(o, r.data(), 0, ggml_nbytes(o));
+        res.insert(res.end(), r.begin(), r.end());
+    }
+    ggml_backend_buffer_free(cbuf);
+    ggml_free(ctx);
+    return res;
+}
+
+static double nmse(const std::vector<float> & a, const std::vector<float> & b) {
+    double num = 0, den = 0;
+    for (size_t i = 0; i < a.size(); i++) {
+        num += (a[i] - b[i])*(a[i] - b[i]);
+        den += b[i]*b[i];
+    }
+    return num/(den + 1e-30);
+}
+
+static bool check(const char * what, const std::vector<float> & got, const std::vector<float> & ref, double tol) {
+    const double e = nmse(got, ref);
+    const bool exact = got.size() == ref.size() && memcmp(got.data(), ref.data(), got.size()*sizeof(float)) == 0;
+    const bool ok = got.size() == ref.size() && e < tol;
+    printf("%-34s nmse=%.3e bitwise=%s %s\n", what, e, exact ? "yes" : "no", ok ? "OK" : "FAIL");
+    return ok;
+}
+
+int main(int argc, char ** argv) {
+    if (argc < 3) {
+        fprintf(stderr, "usage: %s host:port main|get|getrows|partial\n", argv[0]);
+        return 2;
+    }
+    const std::string mode = argv[2];
+    ggml_backend_t rpc = ggml_backend_rpc_init(argv[1], 0);
+    ggml_backend_t cpu = ggml_backend_cpu_init();   // reference: default (plain) CPU buffers, no repack
+    GGML_ASSERT(rpc && cpu);
+
+    auto d4 = make_weight(GGML_TYPE_Q4_K, K, N, 1);
+    auto d6 = make_weight(GGML_TYPE_Q6_K, K, N, 2);
+    auto dm = make_weight(GGML_TYPE_Q4_K, K, N, 3);
+    std::vector<float> dn(N), x(K*B);
+    std::mt19937 rng(4);
+    std::uniform_real_distribution<float> d(-1.0f, 1.0f);
+    for (auto & v : dn) v = d(rng);
+    for (auto & v : x)  v = d(rng);
+
+    model mr = make_model(rpc, d4, d6, dm, dn);
+    model mc = make_model(cpu, d4, d6, dm, dn);
+    bool ok = true;
+    const double tol = 5e-4;
+
+    if (mode == "main") {
+        // mixed first: wm is used by get_rows and mul_mat in the same graph -> never repacked; get_rows must be exact
+        auto rm = run(rpc, mr, G_MIXED, x);
+        auto cm = run(cpu, mc, G_MIXED, x);
+        ok &= check("mixed (get_rows+mul_mat) wm", rm, cm, tol);
+        std::vector<float> rm_rows(rm.end() - K*4, rm.end()), cm_rows(cm.end() - K*4, cm.end());
+        ok &= check("mixed get_rows part (exact)", rm_rows, cm_rows, 1e-30);
+        // matmul-only weights -> repacked on the server
+        auto ra = run(rpc, mr, G_MATMUL, x);
+        auto ca = run(cpu, mc, G_MATMUL, x);
+        ok &= check("matmul w4*norm, w6 (1st)", ra, ca, tol);
+        auto ra2 = run(rpc, mr, G_MATMUL, x);
+        ok &= check("matmul (2nd, same as 1st)", ra2, ra, 1e-30);
+        // mixed again after repacking: wm still plain and correct
+        auto rm2 = run(rpc, mr, G_MIXED, x);
+        ok &= check("mixed again", rm2, cm, tol);
+        // full re-upload of a repacked weight with new data, then matmul again
+        auto d4b = make_weight(GGML_TYPE_Q4_K, K, N, 11);
+        ggml_backend_tensor_set(mr.w4, d4b.data(), 0, d4b.size());
+        ggml_backend_tensor_set(mc.w4, d4b.data(), 0, d4b.size());
+        auto rb = run(rpc, mr, G_MATMUL, x);
+        auto cb = run(cpu, mc, G_MATMUL, x);
+        ok &= check("matmul after full re-upload", rb, cb, tol);
+        printf("%s\n", ok ? "ALL OK" : "SOME FAILED");
+        return ok ? 0 : 1;
+    }
+    run(rpc, mr, G_MATMUL, x);   // repack w4 / w6
+    if (mode == "get") {
+        std::vector<uint8_t> tmp(ggml_nbytes(mr.w4));
+        ggml_backend_tensor_get(mr.w4, tmp.data(), 0, tmp.size());
+        printf("UNEXPECTED: get of repacked weight succeeded (equal to upload: %s)\n",
+               memcmp(tmp.data(), d4.data(), tmp.size()) == 0 ? "yes" : "no");
+        return 1;
+    }
+    if (mode == "getrows") {
+        run(rpc, mr, G_GETROWS_W4, x);
+        printf("UNEXPECTED: get_rows on repacked weight succeeded\n");
+        return 1;
+    }
+    if (mode == "partial") {
+        ggml_backend_tensor_set(mr.w4, d4.data(), 0, d4.size()/2);
+        std::vector<float> tmp(N);
+        ggml_backend_tensor_get(mr.n, tmp.data(), 0, N*sizeof(float));   // forces a round trip
+        printf("UNEXPECTED: partial write into repacked weight succeeded\n");
+        return 1;
+    }
+    return 2;
+}
