+bool rpc_server::repack_device_ok(uint32_t device) const {
+    if (!repack_enabled || device >= backends.size()) {
+        return false;
+    }
+    ggml_backend_dev_t dev = ggml_backend_get_device(backends[device]);
+    return dev != nullptr && ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU;
+}
+
+ggml_backend_buffer_t rpc_server::repack_get_view(ggml_backend_buffer_t orig, ggml_backend_buffer_type_t buft) {
+    auto key = std::make_pair(orig, buft);
+    auto it = repack_views.find(key);
+    if (it != repack_views.end()) {
+        return it->second;
+    }
+    auto itf = repack_ifaces.find(buft);
+    if (itf == repack_ifaces.end()) {
+        // the extra buft's init_tensor / set_tensor are internal to the CPU backend: borrow them from a probe buffer
+        ggml_backend_buffer_t probe = ggml_backend_buft_alloc_buffer(buft, 4096);
+        if (probe == nullptr) {
+            return nullptr;
+        }
+        itf = repack_ifaces.emplace(buft, probe->iface).first;
+        ggml_backend_buffer_free(probe);
+    }
+    if (itf->second.init_tensor == nullptr || itf->second.set_tensor == nullptr) {
+        return nullptr;
+    }
+    ggml_backend_buffer_i iface = {};
+    iface.free_buffer = rpc_repack_view_free;
+    iface.get_base    = rpc_repack_view_get_base;
+    iface.init_tensor = itf->second.init_tensor;
+    iface.set_tensor  = itf->second.set_tensor;
+    auto * vctx = new rpc_repack_view_ctx { ggml_backend_buffer_get_base(orig), orig };
+    ggml_backend_buffer_t view = ggml_backend_buffer_init(buft, iface, vctx, ggml_backend_buffer_get_size(orig));
+    repack_views[key] = view;
+    return view;
+}
+
+const rpc_server::repack_entry * rpc_server::repack_match(const ggml_tensor * t) const {
+    if (t == nullptr || t->op != GGML_OP_NONE || t->view_src != nullptr || t->data == nullptr) {
+        return nullptr;
+    }
+    auto it = repacked.find((uint64_t) t->data);
+    if (it == repacked.end()) {
+        return nullptr;
+    }
+    const repack_entry & e = it->second;
+    if (t->type != e.type || (t->buffer != e.orig && t->buffer != e.view)) {
+        return nullptr;
+    }
+    for (int i = 0; i < GGML_MAX_DIMS; i++) {
+        if (t->ne[i] != e.ne[i] || t->nb[i] != e.nb[i]) {
+            return nullptr;
+        }
+    }
+    return &e;
+}
+
+// a write overlapping a repacked tensor: a full overwrite drops the repack (data is plain again), a partial one is refused
+bool rpc_server::repack_check_write(uint64_t start, uint64_t size, const char * what) {
+    if (repacked.empty() || size == 0) {
+        return true;
+    }
+    const uint64_t end = start + size;
+    auto it = repacked.upper_bound(start);
+    if (it != repacked.begin() && std::prev(it)->second.end > start) {
+        it = std::prev(it);
+    }
+    bool changed = false;
+    while (it != repacked.end() && it->first < end) {
+        if (start <= it->first && end >= it->second.end) {
+            it = repacked.erase(it);
+            changed = true;
+            continue;
+        }
+        LOG_ERROR("[%s] partial write [0x%" PRIx64 ", 0x%" PRIx64 ") into a repacked weight [0x%" PRIx64 ", 0x%" PRIx64 "); "
+                  "restart rpc-server without GGML_RPC_REPACK\n", what, start, end, it->first, it->second.end);
+        return false;
+    }
+    if (changed) {
+        repack_gen++;
+    }
+    return true;
+}
+
+bool rpc_server::repack_check_read(uint64_t start, uint64_t size, const char * what) const {
+    if (repacked.empty() || size == 0) {
+        return true;
+    }
+    const uint64_t end = start + size;
+    auto it = repacked.upper_bound(start);
+    if (it != repacked.begin() && std::prev(it)->second.end > start) {
+        it = std::prev(it);
+    }
+    if (it != repacked.end() && it->first < end) {
+        LOG_ERROR("[%s] read [0x%" PRIx64 ", 0x%" PRIx64 ") of a repacked weight [0x%" PRIx64 ", 0x%" PRIx64 ") is not supported; "
+                  "restart rpc-server without GGML_RPC_REPACK\n", what, start, end, it->first, it->second.end);
+        return false;
+    }
+    return true;
+}
+
+void rpc_server::repack_drop_buffer(ggml_backend_buffer_t buffer) {
+    const uint64_t p0 = (uint64_t) ggml_backend_buffer_get_base(buffer);
+    const uint64_t p1 = p0 + ggml_backend_buffer_get_size(buffer);
+    for (auto it = repacked.begin(); it != repacked.end(); ) {
+        it = it->second.orig == buffer ? repacked.erase(it) : std::next(it);
+    }
+    for (auto it = repack_views.begin(); it != repack_views.end(); ) {
+        if (it->first.first == buffer) {
+            ggml_backend_buffer_free(it->second);
+            it = repack_views.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    for (auto it = repack_blacklist.begin(); it != repack_blacklist.end(); ) {
+        it = (*it >= p0 && *it < p1) ? repack_blacklist.erase(it) : std::next(it);
+    }
+    repack_gen++;
+}
+
+// Called with every freshly deserialized graph (allow_new) and with a cached graph when the repacked set changed.
+// Repacks new eligible weights, refuses graphs that would read repacked bytes through anything but a repack-aware
+// MUL_MAT / MUL_MAT_ID src0, and points every exact descriptor of a repacked weight at its view buffer + traits.
+bool rpc_server::repack_prepare_graph(uint32_t device, ggml_cgraph * graph, bool allow_new) {
+    ggml_backend_t backend = backends[device];
+    ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+    ggml_backend_buffer_type_t def_buft = ggml_backend_get_default_buffer_type(backend);
+
+    // every tensor reachable from the nodes; undo earlier redirections so the checks see the real buffer
+    std::vector<ggml_tensor *> all;
+    std::unordered_set<ggml_tensor *> seen;
+    std::vector<ggml_tensor *> stack;
+    for (int i = 0; i < graph->n_nodes; i++) {
+        stack.push_back(graph->nodes[i]);
+    }
+    while (!stack.empty()) {
+        ggml_tensor * t = stack.back();
+        stack.pop_back();
+        if (t == nullptr || !seen.insert(t).second) {
+            continue;
+        }
+        all.push_back(t);
+        if (rpc_repack_is_view(t->buffer)) {
+            t->buffer = ((rpc_repack_view_ctx *) t->buffer->context)->orig;
+            t->extra  = nullptr;
+        }
+        for (int j = 0; j < GGML_MAX_SRC; j++) {
+            stack.push_back(t->src[j]);
+        }
+        stack.push_back(t->view_src);
+    }
+
+    auto is_mm_src0 = [](const ggml_tensor * node, int j) {
+        return j == 0 && (node->op == GGML_OP_MUL_MAT || node->op == GGML_OP_MUL_MAT_ID);
+    };
+
+    if (allow_new) {
+        auto is_weight_leaf = [&](const ggml_tensor * t) {
+            return t->op == GGML_OP_NONE && t->view_src == nullptr && t->data != nullptr && t->buffer != nullptr &&
+                   (t->flags & (GGML_TENSOR_FLAG_INPUT | GGML_TENSOR_FLAG_OUTPUT | GGML_TENSOR_FLAG_PARAM | GGML_TENSOR_FLAG_LOSS)) == 0 &&
+                   t->buffer->buft == def_buft && buffers.count(t->buffer) && ggml_nbytes(t) > 0;
+        };
+        struct cand_info {
+            std::vector<ggml_tensor *> objs;       // descriptors at this address
+            std::vector<ggml_tensor *> consumers;  // MUL_MAT / MUL_MAT_ID nodes using it as src0
+        };
+        std::map<uint64_t, cand_info> cands;
+        // record every non-matmul use of a weight leaf (persistently, so later graphs cannot make it a candidate)
+        for (ggml_tensor * t : all) {
+            if (t->view_src && is_weight_leaf(t->view_src)) {
+                repack_blacklist.insert((uint64_t) t->view_src->data);
+            }
+            for (int j = 0; j < GGML_MAX_SRC; j++) {
+                ggml_tensor * s = t->src[j];
+                if (s == nullptr || !is_weight_leaf(s)) {
+                    continue;
+                }
+                if (!is_mm_src0(t, j)) {
+                    repack_blacklist.insert((uint64_t) s->data);
+                    continue;
+                }
+                cand_info & ci = cands[(uint64_t) s->data];
+                if (std::find(ci.objs.begin(), ci.objs.end(), s) == ci.objs.end()) {
+                    ci.objs.push_back(s);
+                }
+                ci.consumers.push_back(t);
+            }
+        }
+        int64_t n_new = 0;
+        size_t  b_new = 0;
+        bool synced = false;
+        const auto t0 = std::chrono::steady_clock::now();
+        ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+        auto get_extra_bufts = (ggml_backend_dev_get_extra_bufts_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_dev_get_extra_bufts");
+        ggml_backend_buffer_type_t * extra_bufts = get_extra_bufts ? get_extra_bufts(dev) : nullptr;
+        for (auto & kv : cands) {
+            cand_info & ci = kv.second;
+            if (extra_bufts == nullptr || repacked.count(kv.first) || repack_blacklist.count(kv.first)) {
+                continue;
+            }
+            ggml_tensor * w = ci.objs[0];
+            const uint64_t w0 = (uint64_t) w->data;
+            const uint64_t w1 = w0 + ggml_nbytes(w);
+            bool bad = !ggml_is_contiguous(w);
+            // all descriptors at this address must be identical leaves, and nothing else in the graph may alias it
+            for (ggml_tensor * o : ci.objs) {
+                bad = bad || o->type != w->type || o->buffer != w->buffer;
+                for (int i = 0; i < GGML_MAX_DIMS; i++) {
+                    bad = bad || o->ne[i] != w->ne[i] || o->nb[i] != w->nb[i];
+                }
+            }
+            for (ggml_tensor * t : all) {
+                if (bad) {
+                    break;
+                }
+                if (t->buffer != w->buffer || t->data == nullptr || std::find(ci.objs.begin(), ci.objs.end(), t) != ci.objs.end()) {
+                    continue;
+                }
+                const uint64_t a0 = (uint64_t) t->data;
+                const uint64_t a1 = a0 + ggml_nbytes(t);
+                bad = a0 < w1 && w0 < a1;
+            }
+            if (bad) {
+                repack_blacklist.insert(kv.first);
+                continue;
+            }
+            // first extra buft that keeps the size (in place) and whose supports_op accepts every consumer
+            ggml_backend_buffer_t view = nullptr;
+            for (ggml_backend_buffer_type_t * eb = extra_bufts; *eb != nullptr && view == nullptr; eb++) {
+                if (ggml_backend_buft_get_alloc_size(*eb, w) != ggml_nbytes(w)) {
+                    continue;
+                }
+                ggml_backend_buffer_t v = repack_get_view(w->buffer, *eb);
+                if (v == nullptr) {
+                    continue;
+                }
+                ggml_backend_buffer_t orig = w->buffer;
+                for (ggml_tensor * o : ci.objs) {
+                    o->buffer = v;
+                }
+                bool ok = true;
+                for (ggml_tensor * c : ci.consumers) {
+                    ok = ok && ggml_backend_dev_supports_op(dev, c);
+                }
+                for (ggml_tensor * o : ci.objs) {
+                    o->buffer = orig;
+                }
+                if (ok) {
+                    view = v;
+                }
+            }
+            if (view == nullptr) {
+                continue;
+            }
+            if (!synced) {
+                sync_all_backends();
+                synced = true;
+            }
+            ggml_backend_buffer_t orig = w->buffer;
+            w->buffer = view;
+            w->extra  = nullptr;
+            if (view->iface.init_tensor(view, w) != GGML_STATUS_SUCCESS || w->extra == nullptr) {
+                w->buffer = orig;
+                w->extra  = nullptr;
+                continue;
+            }
+            const size_t nbytes = ggml_nbytes(w);
+            repack_tmp.resize(nbytes);
+            memcpy(repack_tmp.data(), w->data, nbytes);
+            view->iface.set_tensor(view, w, repack_tmp.data(), 0, nbytes);
+            repack_entry e;
+            e.end   = w1;
+            e.orig  = orig;
+            e.view  = view;
+            e.extra = w->extra;
+            e.type  = w->type;
+            for (int i = 0; i < GGML_MAX_DIMS; i++) {
+                e.ne[i] = w->ne[i];
+                e.nb[i] = w->nb[i];
+            }
+            repacked.emplace(w0, e);
+            w->buffer = orig;
+            w->extra  = nullptr;
+            n_new++;
+            b_new += nbytes;
+        }
+        if (n_new > 0) {
+            repack_gen++;
+            repack_tmp.clear();
+            repack_tmp.shrink_to_fit();
+            const std::chrono::duration<double, std::milli> ms = std::chrono::steady_clock::now() - t0;
+            LOG_INFO("[%s] repacked %" PRId64 " weights (%.1f MiB) in %.1f ms, %zu repacked in total\n",
+                     __func__, n_new, b_new/1024.0/1024.0, ms.count(), repacked.size());
+        }
+    }
+
+    if (repacked.empty()) {
+        return true;
+    }
+    // any tensor overlapping a repacked range must be an exact descriptor of it, consumed only as matmul src0
+    for (ggml_tensor * t : all) {
+        if (t->buffer == nullptr || t->data == nullptr || ggml_nbytes(t) == 0) {
+            continue;
+        }
+        if (repack_match(t) == nullptr && !repack_check_read((uint64_t) t->data, ggml_nbytes(t), "graph_compute")) {
+            LOG_ERROR("[%s] tensor '%s' (op %s) aliases a repacked weight\n", __func__, t->name, ggml_op_name(t->op));
+            return false;
+        }
+        for (int j = 0; j < GGML_MAX_SRC; j++) {
+            if (t->src[j] && !is_mm_src0(t, j) && repack_match(t->src[j])) {
+                LOG_ERROR("[%s] repacked weight '%s' used by op %s (src %d); restart rpc-server without GGML_RPC_REPACK\n",
+                          __func__, t->src[j]->name, ggml_op_name(t->op), j);
+                return false;
+            }
+        }
+        if (t->view_src && repack_match(t->view_src)) {
+            LOG_ERROR("[%s] view '%s' of repacked weight '%s'\n", __func__, t->name, t->view_src->name);
+            return false;
+        }
+    }
+    for (ggml_tensor * t : all) {
+        const repack_entry * e = repack_match(t);
+        if (e != nullptr) {
+            t->buffer = e->view;
+            t->extra  = e->extra;
+        }
+    }
+    // the repack kernels must accept every consumer (e.g. src1 type), including ones first seen after the repack
+    for (ggml_tensor * t : all) {
+        if (is_mm_src0(t, 0) && t->src[0] && rpc_repack_is_view(t->src[0]->buffer) && !ggml_backend_dev_supports_op(dev, t)) {
+            LOG_ERROR("[%s] op %s '%s' on repacked weight '%s' is not supported by %s\n", __func__, ggml_op_name(t->op),
+                      t->name, t->src[0]->name, ggml_backend_buft_name(t->src[0]->buffer->buft));
+            return false;
+        }
+    }
+    return true;
+}
+
