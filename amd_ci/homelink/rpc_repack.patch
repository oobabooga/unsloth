From cdf9689ef016f9d1396925324f23608c47a9a265 Mon Sep 17 00:00:00 2001
From: Daniel Han <23090290+danielhanchen@users.noreply.github.com>
Date: Wed, 21 Oct 2026 13:08:58 -0700
Subject: [PATCH 2/2] rpc : out-of-place repack mode for size-changing extra
 bufts (AMX)

GGML_RPC_REPACK=2 / rpc-server --repack-copy: when the first extra buffer
type that supports every consumer changes the tensor size (AMX for q4_K,
q5_K, q8_0 ...), repack into an owned buffer of that type and point the
descriptors there. The plain copy stays reserved in the client buffer for
address identity; on Linux its whole pages are released with MADV_DONTNEED
(reads are refused and a full overwrite re-faults them), so resident memory
stays close to the in-place mode.
---
 ggml/src/ggml-rpc/ggml-rpc.cpp | 90 ++++++++++++++++++++++++++++------
 tools/rpc/rpc-server.cpp       | 12 +++--
 2 files changed, 84 insertions(+), 18 deletions(-)

diff --git a/ggml/src/ggml-rpc/ggml-rpc.cpp b/ggml/src/ggml-rpc/ggml-rpc.cpp
index a77f1d0dc..07e2962f0 100644
--- a/ggml/src/ggml-rpc/ggml-rpc.cpp
+++ b/ggml/src/ggml-rpc/ggml-rpc.cpp
@@ -21,6 +21,10 @@
 #include <unordered_map>
 #include <unordered_set>
 #include <map>
+#ifdef __linux__
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
 #include <cstring>
 #include <fstream>
 #include <filesystem>
@@ -1539,12 +1543,13 @@ void ggml_backend_rpc_get_device_memory(const char * endpoint, uint32_t device,
 
 // RPC server-side implementation
 
-// Server-side CPU weight repacking (GGML_RPC_REPACK=1 or rpc-server --repack).
+// Server-side CPU weight repacking (GGML_RPC_REPACK=1|2, rpc-server --repack / --repack-copy).
 // The client allocates plain CPU buffers, so the CPU extra buffer types (CPU_REPACK, AMX)
 // never see the weights. At GRAPH_COMPUTE, leaf tensors used only as src0 of MUL_MAT /
-// MUL_MAT_ID are repacked in place (only extra bufts whose alloc size equals ggml_nbytes,
-// i.e. CPU_REPACK, not AMX) and deserialized tensors at that address are pointed at a view
-// buffer of the extra buft with tensor->extra restored, so the CPU extra compute hook runs.
+// MUL_MAT_ID are repacked in place when the extra buft keeps ggml_nbytes (CPU_REPACK, AMX q6_K)
+// and deserialized tensors at that address are pointed at a view buffer of the extra buft with
+// tensor->extra restored, so the CPU extra compute hook runs. Mode 2 also repacks into a new
+// buffer when the size changes (AMX q4_K/q5_K/q8_0...) and releases the plain pages (Linux).
 struct rpc_repack_view_ctx {
     void *                base;
     ggml_backend_buffer_t orig;
@@ -1569,9 +1574,10 @@ public:
         stored_graphs.resize(backends.size());
         comm_states.resize(backends.size());
         const char * env = getenv("GGML_RPC_REPACK");
-        repack_enabled = env != nullptr && atoi(env) != 0;
+        repack_mode    = env != nullptr ? atoi(env) : 0;
+        repack_enabled = repack_mode > 0;
         if (repack_enabled) {
-            LOG_INFO("[%s] CPU weight repack enabled (GGML_RPC_REPACK)\n", __func__);
+            LOG_INFO("[%s] CPU weight repack enabled (GGML_RPC_REPACK=%d)\n", __func__, repack_mode);
         }
     }
     ~rpc_server();
@@ -1610,13 +1616,17 @@ private:
     struct repack_entry {
         uint64_t              end;
         ggml_backend_buffer_t orig;
-        ggml_backend_buffer_t view;
+        ggml_backend_buffer_t view;   // view of orig (in place) or an owned buffer of the extra buft (out of place)
+        void *                data;   // where the repacked data lives
         void *                extra;
         ggml_type             type;
         int64_t               ne[GGML_MAX_DIMS];
         size_t                nb[GGML_MAX_DIMS];
     };
     bool repack_enabled = false;
+    int  repack_mode    = 0;   // 1: in place only, 2: also out of place for size-changing extra bufts (AMX)
+    std::unordered_map<ggml_backend_buffer_t, ggml_backend_buffer_t> repack_owned;   // owned buffer -> client buffer
+    std::unordered_map<void *, void *> repack_orig_data;                                 // out-of-place data -> client address
     uint64_t repack_gen = 1;
     std::map<uint64_t, repack_entry> repacked;              // keyed by data start
     std::unordered_set<uint64_t> repack_blacklist;           // leaf data ptrs seen with a non-matmul use
@@ -2552,6 +2562,15 @@ void rpc_server::repack_drop_buffer(ggml_backend_buffer_t buffer) {
             ++it;
         }
     }
+    for (auto it = repack_owned.begin(); it != repack_owned.end(); ) {
+        if (it->second == buffer) {
+            repack_orig_data.erase(ggml_backend_buffer_get_base(it->first));
+            ggml_backend_buffer_free(it->first);
+            it = repack_owned.erase(it);
+        } else {
+            ++it;
+        }
+    }
     for (auto it = repack_blacklist.begin(); it != repack_blacklist.end(); ) {
         it = (*it >= p0 && *it < p1) ? repack_blacklist.erase(it) : std::next(it);
     }
@@ -2583,6 +2602,12 @@ bool rpc_server::repack_prepare_graph(uint32_t device, ggml_cgraph * graph, bool
         if (rpc_repack_is_view(t->buffer)) {
             t->buffer = ((rpc_repack_view_ctx *) t->buffer->context)->orig;
             t->extra  = nullptr;
+        } else if (t->buffer && repack_owned.count(t->buffer)) {
+            auto it = repack_orig_data.find(t->data);
+            GGML_ASSERT(it != repack_orig_data.end());
