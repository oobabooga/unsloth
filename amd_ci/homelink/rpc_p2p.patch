+static rpc_p2p_hub & rpc_p2p() {
+    static rpc_p2p_hub * hub = new rpc_p2p_hub; // never destroyed: detached receiver threads use it until exit
+    return *hub;
+}
+
+// PEER_CONNECT on the source server: reuse a healthy link to the same endpoint (several llama contexts
+// of one client share it), otherwise open a new one
+static bool rpc_p2p_connect(const rpc_msg_peer_connect_req & request, rpc_msg_peer_connect_rsp & response) {
+    response.ok = 0;
+    if (!rpc_p2p_server_enabled()) {
+        LOG_WARN("RPC P2P: PEER_CONNECT refused (GGML_RPC_P2P=0)\n");
+        return true;
+    }
+    const std::string endpoint(request.endpoint, strnlen(request.endpoint, sizeof(request.endpoint)));
+    std::string host;
+    int         port = 0;
+    std::string fingerprint;
+    if (!parse_endpoint(endpoint, host, port, &fingerprint)) {
+        LOG_ERROR("RPC P2P: cannot parse peer endpoint '%s'\n", endpoint.c_str());
+        return true;
+    }
+    const bool tls = is_tls_endpoint(endpoint);
+    if (!tls && (rpc_tls_server_enabled() || !rpc_host_is_loopback(host))) {
+        LOG_ERROR("RPC P2P: refusing a plaintext peer link to %s (plaintext is for 127.0.0.1 tests on plaintext servers only)\n",
+                  endpoint.c_str());
+        return true;
+    }
+    rpc_p2p_hub & hub = rpc_p2p();
+    {
+        // a link whose peer restarted has seen the FIN/RST even though this side never reads from it
+        auto link = hub.find_link(request.peer_id);
+        if (link && link->endpoint == endpoint && !link->is_failed() && !link->sock->remote_hung_up()) {
+            response.ok = 1;
+            return true;
+        }
+    }
+    socket_ptr sock = socket_t::connect(host.c_str(), port);
+    if (sock == nullptr) {
+        LOG_ERROR("RPC P2P: cannot connect to peer %s\n", endpoint.c_str());
+        return true;
+    }
+    if (tls && !sock->tls_connect_peer(fingerprint)) {
+        LOG_ERROR("RPC P2P: TLS with peer %s failed\n", endpoint.c_str());
+        return true;
+    }
+    rpc_msg_peer_hello_req hello = { RPC_PEER_MAGIC, request.self_id };
+    rpc_msg_peer_hello_rsp hello_rsp = {};
+    sock->set_recv_timeout(10);
+    if (!send_rpc_cmd(sock, RPC_CMD_PEER_HELLO, &hello, sizeof(hello), &hello_rsp, sizeof(hello_rsp)) || !hello_rsp.ok) {
+        LOG_ERROR("RPC P2P: peer %s refused the link\n", endpoint.c_str());
+        return true;
+    }
+    sock->set_recv_timeout(0);
+    auto link      = std::make_shared<rpc_peer_link>();
+    link->endpoint = endpoint;
+    link->sock     = sock;
+    link->thread   = std::thread([l = link.get()] { l->run(); });
+    std::shared_ptr<rpc_peer_link> old;
+    {
+        std::lock_guard<std::mutex> lock(hub.links_mutex);
+        old = hub.links[request.peer_id];
+        hub.links[request.peer_id] = link;
+    }
+    old.reset(); // stops and joins the old sender
+    LOG_INFO("RPC P2P: link to peer %s (%s) open\n", endpoint.c_str(), sock->transport_name());
+    response.ok = 1;
+    return true;
+}
+
+// a connection whose first command was PEER_HELLO: file every PEER_DATA until it closes
+static void rpc_p2p_serve_peer(socket_ptr sock) {
+    rpc_msg_peer_hello_req hello = {};
+    if (!recv_msg(sock, &hello, sizeof(hello))) {
+        return;
+    }
+    rpc_msg_peer_hello_rsp rsp = {};
+    if (hello.magic != RPC_PEER_MAGIC || !rpc_p2p_server_enabled()) {
+        LOG_WARN("RPC P2P: refused a peer (%s)\n", rpc_p2p_server_enabled() ? "bad hello" : "GGML_RPC_P2P=0");
+        send_msg(sock, &rsp, sizeof(rsp));
+        return;
+    }
+    rpc_p2p_hub & hub = rpc_p2p();
+    const uint64_t src = hello.self_id;
+    hub.peer_up(src);
+    rsp.ok = 1;
+    if (!send_msg(sock, &rsp, sizeof(rsp))) {
+        hub.peer_down(src);
+        return;
+    }
+    sock->set_recv_timeout(0);
+    LOG_INFO("RPC P2P: peer %016" PRIx64 " connected (%s)\n", src, sock->transport_name());
+    while (true) {
+        uint8_t  cmd  = 0;
+        uint64_t size = 0;
+        uint64_t tag  = 0;
+        if (!sock->recv_data(&cmd, 1)) {
+            break;
+        }
+        const int64_t t0 = ggml_trace_flag ? ggml_trace_time_us() : 0;
+        if (cmd != RPC_CMD_PEER_DATA) {
+            LOG_ERROR("RPC P2P: unexpected command %d on a peer connection\n", cmd);
+            break;
+        }
+        if (!sock->recv_data(&size, sizeof(size)) || size < sizeof(tag) || size - sizeof(tag) > RPC_P2P_MAX_MSG ||
+            !sock->recv_data(&tag, sizeof(tag))) {
+            break;
+        }
+        const size_t n = size - sizeof(tag);
+        std::vector<uint8_t> data;
+        try {
+            data.resize(RPC_P2P_SET_HEADER + n);
+        } catch (const std::bad_alloc &) {
+            LOG_ERROR("RPC P2P: cannot allocate %zu bytes\n", n);
+            break;
+        }
+        if (!sock->recv_data(data.data() + RPC_P2P_SET_HEADER, n)) {
+            break;
+        }
+        if (ggml_trace_flag) {
+            ggml_trace_eventf("rpc.peer", "PEER_RECV", t0, ggml_trace_time_us(),
+                              "\"src\":\"%016" PRIx64 "\",\"tag\":%llu,\"bytes\":%zu", src,
+                              (unsigned long long) tag, (size_t) (size + RPC_CMD_HEADER_BYTES));
+        }
+        if (!hub.deposit(src, tag, std::move(data))) {
+            break;
+        }
+    }
+    LOG_INFO("RPC P2P: peer %016" PRIx64 " disconnected\n", src);
+    hub.peer_down(src);
+}
