+// Direct server-to-server copy of a split input (ggml_backend_sched): instead of a GET from server A to
+// this process and a SET from here to server B, queue PEER_PUSH on A's FIFO (after the graph that
+// produces src) and PEER_AWAIT on B's FIFO (before the graph that consumes dst). A sends the bytes to
+// B over a persistent peer connection; B's command loop blocks on the tag until they arrive. Both
+// commands are queued under one lock, so every server sees transfers in the same order and a PUSH
+// is never queued behind an AWAIT that depends on a later transfer. GGML_RPC_P2P=0 disables it.
+static bool rpc_p2p_client_enabled() {
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_RPC_P2P");
+        return !(e && atoi(e) == 0);
+    }();
+    return enabled;
+}
+
+struct rpc_p2p_client_state {
+    std::mutex                                          pairs_mutex;
+    std::map<std::pair<uint64_t, uint64_t>, bool>       pairs;        // (src serial, dst serial) -> link ok
+    std::mutex                                          order_mutex;  // makes a PUSH/AWAIT pair atomic
+    uint64_t                                            next_tag = 0;
+};
+
+static rpc_p2p_client_state & rpc_p2p_client() {
+    static rpc_p2p_client_state * st = [] {
+        auto * s = new rpc_p2p_client_state;
+        s->next_tag = (uint64_t) std::chrono::steady_clock::now().time_since_epoch().count() << 8;
+        return s;
+    }();
+    return *st;
+}
+
+// ask src to open its link to dst once per dispatcher pair; any failure keeps the pair on the relay path
+static bool rpc_p2p_ready(rpc_dispatcher * src, rpc_dispatcher * dst) {
+    rpc_p2p_client_state & st = rpc_p2p_client();
+    std::lock_guard<std::mutex> lock(st.pairs_mutex);
+    const auto key = std::make_pair(src->serial, dst->serial);
+    auto it = st.pairs.find(key);
+    if (it != st.pairs.end()) {
+        return it->second;
+    }
+    bool ok = false;
+    if (!(src->server_features & RPC_FEATURE_P2P) || !(dst->server_features & RPC_FEATURE_P2P)) {
+        LOG_INFO("RPC P2P: %s -> %s: a server has no P2P support, copies relay through this process\n",
+                 src->endpoint.c_str(), dst->endpoint.c_str());
+    } else if (dst->endpoint.size() >= RPC_PEER_ENDPOINT_MAX) {
+        LOG_WARN("RPC P2P: endpoint %s is too long, copies relay through this process\n", dst->endpoint.c_str());
+    } else {
+        auto request = std::make_shared<rpc_msg_peer_connect_req>();
+        memset(request.get(), 0, sizeof(*request));
+        request->self_id = src->peer_id;
+        request->peer_id = dst->peer_id;
+        snprintf(request->endpoint, sizeof(request->endpoint), "%s", dst->endpoint.c_str());
+        rpc_msg_peer_connect_rsp response = {};
+        src->send(RPC_CMD_PEER_CONNECT, request, sizeof(*request), &response, sizeof(response));
+        ok = response.ok != 0;
+        if (ok) {
+            LOG_INFO("RPC P2P: %s -> %s: direct transfers\n", src->endpoint.c_str(), dst->endpoint.c_str());
+        } else {
+            LOG_WARN("RPC P2P: %s could not open a peer link to %s (see its log), copies relay through this process\n",
+                     src->endpoint.c_str(), dst->endpoint.c_str());
+        }
+    }
+    st.pairs[key] = ok;
+    return ok;
+}
+
+static bool ggml_backend_rpc_cpy_tensor_async(ggml_backend_t backend_src, ggml_backend_t backend_dst, const ggml_tensor * src, ggml_tensor * dst) {
+    if (!rpc_p2p_client_enabled() || !ggml_backend_is_rpc(backend_src) || !ggml_backend_is_rpc(backend_dst)) {
+        return false;
+    }
+    if (!src->buffer || !dst->buffer || !ggml_backend_buffer_is_rpc(src->buffer) || !ggml_backend_buffer_is_rpc(dst->buffer)) {
+        return false;
+    }
+    ggml_backend_rpc_context * sctx = (ggml_backend_rpc_context *) backend_src->context;
+    ggml_backend_rpc_context * dctx = (ggml_backend_rpc_context *) backend_dst->context;
+    const auto * sbuf = (const ggml_backend_rpc_buffer_context *) src->buffer->context;
+    const auto * dbuf = (const ggml_backend_rpc_buffer_context *) dst->buffer->context;
+    if (sbuf->dispatcher != sctx->dispatcher || dbuf->dispatcher != dctx->dispatcher || sctx->dispatcher == dctx->dispatcher) {
+        return false;
+    }
+    const size_t size = ggml_nbytes(src);
+    if (size == 0 || !ggml_is_contiguous(src) || !ggml_is_contiguous(dst) || ggml_nbytes(dst) != size) {
+        return false;
+    }
+    rpc_dispatcher * a = sctx->dispatcher.get();
+    rpc_dispatcher * b = dctx->dispatcher.get();
+    if (!rpc_p2p_ready(a, b)) {
+        return false;
+    }
+
+    auto push  = std::make_shared<rpc_msg_peer_xfer_req>();
+    auto await = std::make_shared<rpc_msg_peer_xfer_req>();
+    push->peer_id  = b->peer_id;
+    push->tensor   = serialize_tensor(src);
+    push->offset   = 0;
+    push->size     = size;
+    await->peer_id = a->peer_id;
+    await->tensor  = serialize_tensor(dst);
+    await->offset  = 0;
+    await->size    = size;
+    LOG_DBG2("[%s] %s (%s) -> %s (%s), %zu bytes\n", __func__, src->name, a->endpoint.c_str(), dst->name, b->endpoint.c_str(), size);
+
+    rpc_p2p_client_state & st = rpc_p2p_client();
+    std::lock_guard<std::mutex> lock(st.order_mutex);
+    const uint64_t tag = ++st.next_tag;
+    push->tag  = tag;
+    await->tag = tag;
+    if (ggml_trace_flag) { ggml_trace_set_subject(src->name, tag); }
+    sctx->last = a->send_async(RPC_CMD_PEER_PUSH, push, sizeof(*push));
+    if (ggml_trace_flag) { ggml_trace_set_subject(dst->name, tag); }
+    dctx->last = b->send_async(RPC_CMD_PEER_AWAIT, await, sizeof(*await));
+    return true;
+}
