+
+bool socket_t::remote_is_loopback() const {
+    struct sockaddr_storage addr;
+    socklen_t len = sizeof(addr);
+    if (getpeername(pimpl->fd, (struct sockaddr *) &addr, &len) != 0) {
+        return false;
+    }
+    if (addr.ss_family == AF_INET) {
+        const uint32_t a = ntohl(((struct sockaddr_in *) &addr)->sin_addr.s_addr);
+        return (a >> 24) == 127;
+    }
+    return false;
+}
+
+bool socket_t::remote_hung_up() const {
+#ifdef _WIN32
+    return false;
+#else
+    struct pollfd p = {};
+    p.fd = pimpl->fd;
+#  ifdef POLLRDHUP
+    p.events = POLLRDHUP;
+    const short hup = POLLRDHUP | POLLHUP | POLLERR;
+#  else
+    p.events = 0;
+    const short hup = POLLHUP | POLLERR;
+#  endif
+    if (poll(&p, 1, 0) <= 0) {
+        return false;
+    }
+    return (p.revents & hup) != 0;
+#endif
+}
