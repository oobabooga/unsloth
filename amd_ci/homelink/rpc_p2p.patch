+// Absolute deadlines for reads on accepted connections. SO_RCVTIMEO bounds each recv() call only, so a
+// sender trickling one byte at a time could hold a handshake or a half-sent PEER_DATA (and its memory)
+// open indefinitely; this thread shuts down a socket whose deadline passes, failing the blocked read.
+struct rpc_deadline_watchdog {
+    using clock = std::chrono::steady_clock;
+
+    std::mutex                                                     mutex;
+    std::condition_variable                                        cvar;
+    std::map<uint64_t, std::pair<clock::time_point, socket_ptr>>  armed;
+    uint64_t                                                       next_id = 1;
+    bool                                                           started = false;
+
+    // 0: could not arm (no watchdog thread), the caller must not proceed
+    uint64_t arm(const socket_ptr & sock, int seconds) {
+        std::lock_guard<std::mutex> lock(mutex);
+        if (!started) {
+            try {
+                std::thread([this] { run(); }).detach();
+            } catch (const std::system_error & e) {
+                LOG_ERROR("RPC: cannot start the deadline thread: %s\n", e.what());
+                return 0;
+            }
+            started = true;
+        }
+        const uint64_t id = next_id++;
+        armed.emplace(id, std::make_pair(clock::now() + std::chrono::seconds(seconds), sock));
+        cvar.notify_all();
+        return id;
+    }
+
+    // false: the deadline already fired (the socket is shut down)
+    bool disarm(uint64_t id) {
+        socket_ptr sock;
+        std::lock_guard<std::mutex> lock(mutex);
+        auto it = armed.find(id);
+        if (it == armed.end()) {
+            return false;
+        }
+        sock = std::move(it->second.second); // released after the lock (declared first)
+        armed.erase(it);
+        return true;
+    }
+
+    void run() {
+        std::unique_lock<std::mutex> lock(mutex);
+        while (true) {
+            const auto now  = clock::now();
+            auto       next = clock::time_point::max();
+            std::vector<socket_ptr> expired;
+            for (auto it = armed.begin(); it != armed.end();) {
+                if (it->second.first <= now) {
+                    it->second.second->shutdown_rw();
+                    expired.push_back(std::move(it->second.second));
+                    it = armed.erase(it);
+                } else {
+                    next = std::min(next, it->second.first);
