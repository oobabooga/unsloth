+static void set_recv_timeout_fd(sockfd_t fd, int seconds) {
+#ifdef _WIN32
+    DWORD ms = (DWORD) seconds * 1000;
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, (const char *) &ms, sizeof(ms));
+#else
+    struct timeval tv;
