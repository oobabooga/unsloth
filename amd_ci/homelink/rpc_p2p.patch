+// Server side of the direct server-to-server (P2P) tensor transfer.
+//
+// Outbound (this server is the source A): PEER_CONNECT opens a persistent link to B, authenticated
+// like a client connection (mutual TLS with this server's certificate, B's fingerprint pinned; on
+// plaintext servers only to 127.0.0.0/8). PEER_PUSH reads the tensor in command order and hands the
+// bytes to the link's sender thread, so A computes the next graph while they go out.
+// Inbound (this server is the destination B): the accept loop routes a connection whose first
+// command is PEER_HELLO to its own receiver thread, which files each PEER_DATA under (source, tag).
+// PEER_AWAIT, in command order, waits for that entry and writes it like SET_TENSOR. It fails (and
+// the client connection is dropped, so the client sees an error) when the source's link closes,
+// the client hangs up, or after GGML_RPC_P2P_TIMEOUT seconds (default 120).
+static bool rpc_p2p_server_enabled() {
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_RPC_P2P");
+        return !(e && atoi(e) == 0);
+    }();
+    return enabled;
+}
+
+static int rpc_p2p_timeout_s() {
+    static const int t = [] {
+        const char * e = getenv("GGML_RPC_P2P_TIMEOUT");
+        const int v = e ? atoi(e) : 0;
+        return v > 0 ? v : 120;
+    }();
+    return t;
+}
+
+static constexpr size_t   RPC_P2P_MAX_MSG      = 4ull << 30;   // one transfer
+static constexpr size_t   RPC_P2P_MAX_INBOX    = 4ull << 30;   // received, not yet awaited
+static constexpr size_t   RPC_P2P_MAX_BACKLOG  = 512ull << 20; // pushed, not yet sent, per link
+static constexpr int64_t  RPC_P2P_STALE_US     = 600ll * 1000 * 1000;
+// PEER_DATA is filed with room for the SET_TENSOR header in front: | rpc_tensor | cache_flag | offset |
+static constexpr size_t   RPC_P2P_SET_HEADER   = sizeof(rpc_tensor) + 1 + sizeof(uint64_t);
+
+static bool rpc_host_is_loopback(const std::string & host) {
+    return host == "localhost" || host.rfind("127.", 0) == 0;
+}
+
+struct rpc_peer_link {
+    struct item {
+        uint64_t             tag;
+        std::vector<uint8_t> data;
+    };
+
+    std::string             endpoint;
+    socket_ptr              sock;
+    std::thread             thread;
+    std::mutex              mutex;
+    std::condition_variable cvar;
+    std::deque<item>        queue;
+    size_t                  backlog = 0;
+    bool                    failed  = false;
+    bool                    stop    = false;
+
+    bool is_failed() {
+        std::lock_guard<std::mutex> lock(mutex);
+        return failed;
+    }
+
+    bool enqueue(uint64_t tag, std::vector<uint8_t> && data) {
+        std::unique_lock<std::mutex> lock(mutex);
+        const size_t n = data.size();
+        cvar.wait(lock, [&] { return failed || backlog == 0 || backlog + n <= RPC_P2P_MAX_BACKLOG; });
+        if (failed) {
+            return false;
+        }
+        backlog += n;
+        queue.push_back({tag, std::move(data)});
+        cvar.notify_all();
+        return true;
+    }
+
+    void run() {
+        while (true) {
+            item it;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                cvar.wait(lock, [&] { return stop || !queue.empty(); });
+                if (stop) {
+                    return;
+                }
+                it = std::move(queue.front());
+                queue.pop_front();
+            }
+            const int64_t t0   = ggml_trace_flag ? ggml_trace_time_us() : 0;
+            const uint8_t cmd  = RPC_CMD_PEER_DATA;
+            const uint64_t size = sizeof(it.tag) + it.data.size();
+            const bool ok = sock->send_data(&cmd, sizeof(cmd)) && sock->send_data(&size, sizeof(size)) &&
+                            sock->send_data(&it.tag, sizeof(it.tag)) && sock->send_data(it.data.data(), it.data.size()) &&
+                            sock->flush();
+            if (ggml_trace_flag) {
+                ggml_trace_eventf("rpc.peer", "PEER_SEND", t0, ggml_trace_time_us(),
+                                  "\"peer\":\"%s\",\"tag\":%llu,\"bytes\":%zu,\"ok\":%d", endpoint.c_str(),
+                                  (unsigned long long) it.tag, (size_t) (size + RPC_CMD_HEADER_BYTES), ok ? 1 : 0);
+            }
+            std::lock_guard<std::mutex> lock(mutex);
+            backlog -= it.data.size();
+            if (!ok) {
+                LOG_ERROR("RPC P2P: sending to peer %s failed, dropping the link\n", endpoint.c_str());
+                failed = true;
+                queue.clear();
+                backlog = 0;
+                cvar.notify_all();
+                return;
+            }
+            cvar.notify_all();
+        }
+    }
+
+    ~rpc_peer_link() {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            stop = true;
+            cvar.notify_all();
+        }
+        if (sock) {
+            sock->shutdown_rw(); // a send blocked on a stalled peer must not hold up the join
+        }
+        if (thread.joinable()) {
+            thread.join();
+        }
+    }
+};
+
+struct rpc_p2p_hub {
+    struct entry {
+        std::vector<uint8_t> data;   // RPC_P2P_SET_HEADER bytes of room, then the payload
+        int64_t              t_us;
+    };
+
+    std::mutex                                     mutex;
+    std::condition_variable                        cvar;
+    std::map<std::pair<uint64_t, uint64_t>, entry> inbox;   // (source id, tag)
+    size_t                                         inbox_bytes = 0;
+    std::unordered_map<uint64_t, int>              live;    // source id -> open peer connections
+    std::unordered_set<uint64_t>                   seen;    // source ids that ever connected
+
+    std::mutex                                                   links_mutex;
+    std::unordered_map<uint64_t, std::shared_ptr<rpc_peer_link>> links;  // destination id -> link
+
+    void peer_up(uint64_t src) {
+        std::lock_guard<std::mutex> lock(mutex);
+        live[src]++;
+        seen.insert(src);
+    }
+
+    void peer_down(uint64_t src) {
+        std::lock_guard<std::mutex> lock(mutex);
+        live[src]--;
+        cvar.notify_all();
+    }
+
+    bool deposit(uint64_t src, uint64_t tag, std::vector<uint8_t> && data) {
+        std::lock_guard<std::mutex> lock(mutex);
+        const int64_t now = ggml_time_us();
+        for (auto it = inbox.begin(); it != inbox.end();) {
+            if (now - it->second.t_us > RPC_P2P_STALE_US) {
+                inbox_bytes -= it->second.data.size();
+                it = inbox.erase(it);
+            } else {
+                ++it;
+            }
+        }
+        const auto key = std::make_pair(src, tag);
+        if (inbox.count(key) != 0) {
+            LOG_ERROR("RPC P2P: duplicate transfer tag %" PRIu64 " from peer %016" PRIx64 "\n", tag, src);
+            return false;
+        }
+        if (inbox_bytes + data.size() > RPC_P2P_MAX_INBOX) {
+            LOG_ERROR("RPC P2P: %zu bytes received and not awaited, refusing more\n", inbox_bytes);
+            return false;
+        }
+        inbox_bytes += data.size();
+        inbox[key] = entry{std::move(data), now};
+        cvar.notify_all();
+        return true;
+    }
+
+    bool take(uint64_t src, uint64_t tag, std::vector<uint8_t> & out, const socket_ptr & client) {
+        std::unique_lock<std::mutex> lock(mutex);
+        const auto key      = std::make_pair(src, tag);
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(rpc_p2p_timeout_s());
+        while (true) {
+            auto it = inbox.find(key);
+            if (it != inbox.end()) {
+                out = std::move(it->second.data);
+                inbox_bytes -= out.size();
+                inbox.erase(it);
+                return true;
+            }
+            if (seen.count(src) != 0 && live[src] <= 0) {
+                LOG_ERROR("RPC P2P: peer %016" PRIx64 " disconnected before transfer %" PRIu64 " arrived\n", src, tag);
+                return false;
+            }
+            if (client && client->remote_hung_up()) {
+                LOG_ERROR("RPC P2P: client hung up while waiting for transfer %" PRIu64 "\n", tag);
+                return false;
+            }
+            if (std::chrono::steady_clock::now() >= deadline) {
+                LOG_ERROR("RPC P2P: transfer %" PRIu64 " from peer %016" PRIx64 " did not arrive within %d s\n",
+                          tag, src, rpc_p2p_timeout_s());
+                return false;
+            }
+            cvar.wait_for(lock, std::chrono::milliseconds(100));
+        }
+    }
+
+    void clear_inbox() {
+        std::lock_guard<std::mutex> lock(mutex);
+        inbox.clear();
+        inbox_bytes = 0;
+    }
+
+    // links belong to the client session that opened them: closing them when it ends tells every
+    // destination that this source is gone, so an AWAIT there fails now instead of at the timeout
+    // (a failure anywhere in the pipeline reaches the client through whichever server it waits on)
+    void close_links() {
+        std::unordered_map<uint64_t, std::shared_ptr<rpc_peer_link>> old;
+        {
+            std::lock_guard<std::mutex> lock(links_mutex);
+            old.swap(links);
+        }
+        old.clear();
+    }
+
+    std::shared_ptr<rpc_peer_link> find_link(uint64_t dst) {
+        std::lock_guard<std::mutex> lock(links_mutex);
+        auto it = links.find(dst);
+        return it == links.end() ? nullptr : it->second;
+    }
+};
