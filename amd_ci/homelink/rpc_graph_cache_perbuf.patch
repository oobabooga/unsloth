From d9f81250538b43151d64db252a55fc36ad71a0a2 Mon Sep 17 00:00:00 2001
From: danielhanchen <danielhanchen@gmail.com>
Date: Thu, 22 Oct 2026 03:14:07 -0700
Subject: [PATCH 2/2] rpc: record graph buffers in both cache modes and clear
 the cache when the mode changes

A graph cached while the connection was in clear-all mode had an empty buffer list, so after a switch to
per-buffer mode FREE_BUFFER never matched it and a later GRAPH_RECOMPUTE read the freed buffer.
---
 ggml/src/ggml-rpc/ggml-rpc.cpp | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-rpc/ggml-rpc.cpp b/ggml/src/ggml-rpc/ggml-rpc.cpp
index 609330dd4..81aa2059c 100644
--- a/ggml/src/ggml-rpc/ggml-rpc.cpp
+++ b/ggml/src/ggml-rpc/ggml-rpc.cpp
@@ -2485,7 +2485,9 @@ bool rpc_server::graph_compute(const std::vector<uint8_t> & input) {
     stored_graph sg_tmp;
     stored_graph & sg = uid != 0 ? stored_graphs[device][uid] : sg_tmp;
     sg.bufs.clear();
-    if (uid != 0 && graph_cache_perbuf) {
+    if (uid != 0) {
+        // recorded in both modes: a client may switch to per-buffer mode after graphs were cached, and FREE_BUFFER
+        // must still find every graph that names the freed buffer
         sg.bufs = rpc_graph_buffers(tensors, n_tensors);
     }
 
@@ -2946,7 +2948,14 @@ bool rpc_server::repack_prepare_graph(uint32_t device, ggml_cgraph * graph, bool
 }
 
 uint8_t rpc_server::graph_cache_mode(uint8_t requested) {
-    graph_cache_perbuf = requested == RPC_GRAPH_CACHE_PER_BUFFER && rpc_graph_cache_perbuf_enabled();
+    const bool perbuf = requested == RPC_GRAPH_CACHE_PER_BUFFER && rpc_graph_cache_perbuf_enabled();
+    if (perbuf != graph_cache_perbuf) {
+        // the client resets its uids with the mode; start both sides from an empty cache
+        for (auto & sgs : stored_graphs) {
+            sgs.clear();
+        }
+    }
+    graph_cache_perbuf = perbuf;
     LOG_DBG("[%s] graph cache: %s\n", __func__, graph_cache_perbuf ? "per-buffer" : "clear-all");
     return graph_cache_perbuf ? RPC_GRAPH_CACHE_PER_BUFFER : RPC_GRAPH_CACHE_CLEAR_ALL;
 }
