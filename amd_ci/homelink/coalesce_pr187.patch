+bool socket_t::impl::tcp_flush() {
+    if (pending.empty()) {
+        return true;
+    }
+    bool ok = tcp_send(pending.data(), pending.size());
+    pending.clear();
+    return ok;
+}
+
+bool socket_t::impl::send_data(const void * data, size_t size) {
+#ifdef GGML_RPC_RDMA_APPLE
+    if (use_rdma) {
