From 76b337bed60889477a45333f4cf426e5b83f8f3d Mon Sep 17 00:00:00 2001
From: danielhanchen <danielhanchen@gmail.com>
Date: Wed, 21 Oct 2026 19:26:39 -0700
Subject: [PATCH 1/2] llama: read backend sampling logits/probs/candidates rows
 lazily

With backend sampling every decode copied the logits, probs and candidates
rows of every output back to the host, even when the token was already
sampled on the backend and nobody reads them. On an RPC device each row is
a GET_TENSOR round trip on the endpoint's FIFO.

Keep the sampled token ids eager, remember the tensor of the other rows and
read a row on the first llama_get_sampled_{logits,probs,candidates}_ith
access. Pending rows are read before the compute buffer is reused (next
ubatch, graph reserve) and dropped when the next decode starts.
llama_sampler_sample checks the backend sampled token before touching the
rows. LLAMA_BACKEND_SAMPLING_LAZY_READBACK=0 restores the eager copies.
---
 src/llama-context.cpp | 124 ++++++++++++++++++++++++++++++++++++++----
 src/llama-context.h   |  25 +++++++++
 src/llama-sampler.cpp |  10 ++--
 3 files changed, 145 insertions(+), 14 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 0a814e89f..dbe76c47c 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -375,6 +375,11 @@ llama_context::llama_context(
         }
     }
 
+    {
+        const char * LLAMA_BACKEND_SAMPLING_LAZY_READBACK = getenv("LLAMA_BACKEND_SAMPLING_LAZY_READBACK");
+        sampling.lazy_readback = LLAMA_BACKEND_SAMPLING_LAZY_READBACK ? (atoi(LLAMA_BACKEND_SAMPLING_LAZY_READBACK) != 0) : true;
+    }
+
     // ref: https://github.com/ggml-org/llama.cpp/pull/17046#discussion_r2503085732
     cparams.n_ctx = GGML_PAD(cparams.n_ctx, 256);
 
@@ -1170,6 +1175,58 @@ float * llama_context::get_embeddings_layer_inp(uint32_t lid) {
     return embd_layer_inp[lid].data;
 }
 
+void llama_context::sampling_lazy_read(std::vector<sampling_info::lazy_row> & lazy, int64_t row, void * dst) {
+    if (sampling.n_lazy_pending == 0 || row < 0 || (size_t) row >= lazy.size()) {
+        return;
+    }
+
+    auto & entry = lazy[row];
+    if (entry.tensor == nullptr) {
+        return;
+    }
+
+    // the public getters synchronize first, so the compute that produced the row has finished
+    ggml_backend_tensor_get(entry.tensor, dst, 0, entry.nbytes);
+
+    entry = {};
+    GGML_ASSERT(sampling.n_lazy_pending > 0);
+    --sampling.n_lazy_pending;
+}
+
+void llama_context::sampling_lazy_flush() {
+    if (sampling.n_lazy_pending == 0) {
+        return;
+    }
+
+    // the async copies and the compute must be done before the rows are read
+    ggml_backend_sched_synchronize(sched.get());
+
+    const size_t stride = model.vocab.n_tokens();
+
+    for (size_t row = 0; row < sampling.logits_lazy.size(); ++row) {
+        sampling_lazy_read(sampling.logits_lazy,     row, sampling.logits.data     + row*stride);
+        sampling_lazy_read(sampling.probs_lazy,      row, sampling.probs.data      + row*stride);
+        sampling_lazy_read(sampling.candidates_lazy, row, sampling.candidates.data + row*stride);
+    }
+
+    GGML_ASSERT(sampling.n_lazy_pending == 0);
+}
+
+void llama_context::sampling_lazy_drop() {
+    if (sampling.n_lazy_pending == 0) {
+        return;
+    }
+
+    // a row that was never read reports no data rather than stale host memory
+    for (size_t row = 0; row < sampling.logits_lazy.size(); ++row) {
+        if (sampling.logits_lazy[row].tensor)     { sampling.logits_count[row]     = 0; sampling.logits_lazy[row]     = {}; }
+        if (sampling.probs_lazy[row].tensor)      { sampling.probs_count[row]      = 0; sampling.probs_lazy[row]      = {}; }
+        if (sampling.candidates_lazy[row].tensor) { sampling.candidates_count[row] = 0; sampling.candidates_lazy[row] = {}; }
+    }
+
+    sampling.n_lazy_pending = 0;
+}
+
 llama_token llama_context::get_sampled_token_ith(int32_t idx) {
     output_reorder();
 
@@ -1199,7 +1256,9 @@ float * llama_context::get_sampled_probs_ith(int32_t idx) {
         if ((size_t) row >= sampling.probs_count.size() || sampling.probs_count[row] == 0) {
