From ad0f5ea1fab94bfe5c349cae0cf3dfbfdafe3060 Mon Sep 17 00:00:00 2001
From: Daniel Han <danielhanchen@gmail.com>
Date: Thu, 22 Oct 2026 16:36:33 -0700
Subject: [PATCH 1/2] server: n_probs reads the raw logits for a row that was
 not sampled on the backend

With --backend-sampling, a request with n_probs (and no post_sampling_probs)
is sampled on the CPU, so its sequence has no backend sampler. When it shares
a batch with sequences that do have one, the context allocates the backend
sampling buffers, and llama_get_sampled_logits_count_ith() returns 0 for the
CPU sampled row because no sampled logits were copied for it.
get_token_probabilities() used that count for the raw logits it reads with
llama_get_logits_ith(), so it returned an empty list: every token of the
request got prob 1.0 (logprob 0) and no top probabilities. Alone (or with
only other n_probs requests) the buffers are not allocated, the count falls
back to n_vocab and the probabilities are correct.

Use the backend sampled logits, candidates and count only when the row has
backend sampled logits, as common_sampler's set_logits() does, and the raw
logits over the full vocab otherwise.
---
 tools/server/server-common.cpp | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/tools/server/server-common.cpp b/tools/server/server-common.cpp
index 98c72dec1..fb65961c7 100644
--- a/tools/server/server-common.cpp
+++ b/tools/server/server-common.cpp
@@ -1586,10 +1586,20 @@ json format_response_rerank(
 std::vector<llama_token_data> get_token_probabilities(llama_context * ctx, int idx, size_t n_top) {
     std::vector<llama_token_data> cur;
 
-    const auto * logits = llama_get_logits_ith(ctx, idx);
-    const llama_token * sampled_ids = llama_get_sampled_candidates_ith(ctx, idx);
-
-    const int n_logits = llama_get_sampled_logits_count_ith(ctx, idx);
+    // a row sampled on the backend carries its own (possibly filtered) logits and candidate ids;
+    // any other row uses the raw logits over the full vocab, even when other sequences of the
+    // same batch are sampled on the backend (their sampled logits count is 0 for this row)
+    const float * logits = llama_get_sampled_logits_ith(ctx, idx);
+    const llama_token * sampled_ids = nullptr;
+
+    int n_logits = 0;
+    if (logits) {
+        sampled_ids = llama_get_sampled_candidates_ith(ctx, idx);
+        n_logits    = llama_get_sampled_logits_count_ith(ctx, idx);
+    } else {
+        logits   = llama_get_logits_ith(ctx, idx);
+        n_logits = logits ? llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(ctx))) : 0;
+    }
 
     cur.resize(n_logits);
     if (sampled_ids) {
-- 
