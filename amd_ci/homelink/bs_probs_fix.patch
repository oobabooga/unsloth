From 851ea5052806006f4618d6cdd8788e17d0ba8e8d Mon Sep 17 00:00:00 2001
From: Daniel Han <danielhanchen@gmail.com>
Date: Thu, 22 Oct 2026 16:43:38 -0700
Subject: [PATCH 2/2] llama: keep backend sampling chain tensors and partial
 gathers as outputs when the sampled ids are gathered

The sampled token gather (LLAMA_BS_BATCH_READBACK) appends GGML_OP_CONCAT
nodes whose inputs depend on which output rows of the ubatch are active.
ggml-alloc reuses the previous allocation plan for any graph with the same
node and leaf count, so a plan made for one set of active rows was applied
to another. A tensor that was free at the end of the first graph (the
probs/logits/candidates of a chain without an output row, a partial
gather) could be live in the second and get overwritten by a gather: with
concurrent post_sampling_probs requests next to plain ones, about 1 in 100
probs rows held the request's own sampled token id read as a float
(prob 1.5e-40 instead of 1.0). With the gather off, or with a fresh
allocation plan for every graph, the rows were correct.

With the gather on, also mark the tensors of the inactive chains and the
partial gathers as outputs, so the allocation of every graph with the same
sampler set no longer depends on the active rows. LLAMA_BS_BATCH_READBACK=0
is unchanged.
---
 src/llama-graph.cpp | 22 ++++++++++++++++++++++
 src/llama-graph.h   |  4 ++++
 2 files changed, 26 insertions(+)

diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index c2d41f363..5df0b7c84 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1392,6 +1392,7 @@ void llm_graph_result::reset() {
     t_sampled_logits.clear();
     t_candidates.clear();
     t_sampled_runs.clear();
+    t_sampled_keep.clear();
 
     params = {};
 
@@ -1448,6 +1449,9 @@ void llm_graph_result::set_outputs(const llm_graph_params & params) {
     for (const auto & run : t_sampled_runs) {
         ggml_set_output(run.tensor);
     }
+    for (auto * tensor : t_sampled_keep) {
+        ggml_set_output(tensor);
+    }
     for (auto * tensor : t_sampled_probs) {
         if (tensor != nullptr) {
             ggml_set_output(tensor);
@@ -4106,6 +4110,13 @@ void llm_graph_context::build_sampling() const {
 
     static const std::vector<uint32_t> no_rows;
 
+    // the gather below makes the end of the graph depend on which rows are active, while ggml-alloc reuses the
+    // previous allocation plan for any graph with the same node count. a tensor freed in one graph (a chain
+    // without an output row, a partial gather) and live in the next can then be overwritten by a gather (seen:
+    // a dist probs row holding sampled token ids). keeping every chain's tensors and every partial gather as
+    // outputs makes the allocation independent of the active rows
+    const bool keep_inactive = cparams.sampling_batch_readback;
+
     // every sampler builds n_outputs_max_per_seq chains, like the reserve, so the graph keeps its topology
     // whatever rows the ubatch outputs: a chain without a row works on the first row and is not selected
     for (const auto & [seq_id, sampler] : samplers) {
@@ -4133,6 +4144,8 @@ void llm_graph_context::build_sampling() const {
             if (data.sampled != nullptr) {
                 if (active) {
                     res->t_sampled[row] = data.sampled;
+                } else if (keep_inactive) {
+                    res->t_sampled_keep.push_back(data.sampled);
                 }
                 outs[1] = data.sampled;
                 ggml_build_forward_select(gf, outs.data(), outs.size(), i_out);
@@ -4141,6 +4154,8 @@ void llm_graph_context::build_sampling() const {
             if (data.probs != nullptr) {
                 if (active) {
                     res->t_sampled_probs[row] = data.probs;
+                } else if (keep_inactive) {
+                    res->t_sampled_keep.push_back(data.probs);
                 }
                 outs[1] = data.probs;
                 ggml_build_forward_select(gf, outs.data(), outs.size(), i_out);
@@ -4149,6 +4164,8 @@ void llm_graph_context::build_sampling() const {
             if (data.logits != nullptr) {
                 if (active) {
                     res->t_sampled_logits[row] = data.logits;
+                } else if (keep_inactive) {
+                    res->t_sampled_keep.push_back(data.logits);
                 }
                 outs[1] = data.logits;
                 ggml_build_forward_select(gf, outs.data(), outs.size(), i_out);
@@ -4157,6 +4174,8 @@ void llm_graph_context::build_sampling() const {
             if (data.candidates != nullptr) {
                 if (active) {
                     res->t_candidates[row] = data.candidates;
+                } else if (keep_inactive) {
+                    res->t_sampled_keep.push_back(data.candidates);
                 }
                 outs[1] = data.candidates;
                 ggml_build_forward_select(gf, outs.data(), outs.size(), i_out);
@@ -4186,6 +4205,9 @@ void llm_graph_context::build_sampling() const {
             if (end - row > 1) {
                 ggml_tensor * cur = ggml_reshape_1d(ctx0, res->t_sampled[row], 1);
                 for (uint32_t r = row + 1; r < end; ++r) {
+                    if (r > row + 1) {
+                        res->t_sampled_keep.push_back(cur);
+                    }
                     cur = ggml_concat(ctx0, cur, ggml_reshape_1d(ctx0, res->t_sampled[r], 1), 0);
                 }
                 ggml_format_name(cur, "sampled_tokens_%u_%u", row, end - row);
diff --git a/src/llama-graph.h b/src/llama-graph.h
index 99fef8260..51bce5f61 100644
--- a/src/llama-graph.h
+++ b/src/llama-graph.h
@@ -978,6 +978,10 @@ public:
     };
     std::vector<sampled_run> t_sampled_runs;
 
+    // with the gather above: the tensors of the chains without an output row and the partial gathers, kept
+    // as outputs so the allocation does not depend on the active rows, see llm_graph_context::build_sampling
+    std::vector<ggml_tensor *> t_sampled_keep;
+
     std::vector<llm_graph_input_ptr> inputs;
     std::vector<llm_graph_fused_node> fused_nodes;
 
-- 
2.43.0

