+// Split input uploads to an RPC backend (ggml_backend_sched): set_tensor_async copies the data when it is called
+// and the endpoint runs its commands in order, so the scheduler needs no synchronize before each upload (it asks
+// for that through the "ggml_backend_set_tensor_async_copies" proc address). The uploads and PEER_AWAITs of a
+// split are held back and queued in one push with its graph, so another context's command (a PEER_AWAIT that
+// blocks the server's command loop) cannot land between this split's data and its graph. A direct transfer's
+// PEER_PUSH is queued at the same moment, so PUSHes and AWAITs keep one order across endpoints.
+// GGML_RPC_ASYNC_INPUTS=0 or LLAMA_RPC_ASYNC_INPUTS=0 restores blocking, unbatched uploads.
+static bool rpc_async_inputs_enabled() {
+    static const bool enabled = [] {
+        for (const char * name : { "GGML_RPC_ASYNC_INPUTS", "LLAMA_RPC_ASYNC_INPUTS" }) {
+            const char * e = getenv(name);
+            if (e && atoi(e) == 0) {
+                return false;
+            }
+        }
+        return true;
+    }();
+    return enabled;
+}
+
+struct rpc_pending_cmds {
+    std::vector<rpc_dispatcher::rpc_msg_ptr> msgs;  // this backend's held-back commands, in order
+    // direct transfers into this backend: the PEER_AWAIT is in msgs; the PEER_PUSH (on the source endpoint) is
+    // tagged and queued under the p2p order lock right before msgs, so both endpoints see the pair in one order
+    struct xfer {
+        ggml_backend_rpc_context *              src;
+        std::shared_ptr<rpc_msg_peer_xfer_req>  push;
+        std::shared_ptr<rpc_msg_peer_xfer_req>  await;
+        rpc_dispatcher::rpc_msg_ptr             push_msg;
+        rpc_dispatcher::rpc_msg_ptr             await_msg;
+    };
+    std::vector<xfer> xfers;
+};
+
+// tags and queues the PEER_PUSHes of pending->xfers; the caller holds the p2p order lock
+static void rpc_push_xfers(rpc_pending_cmds * pending);
+static std::mutex & rpc_p2p_order_mutex();
+
 static void rpc_dispatcher_trampoline(rpc_dispatcher * dispatcher)
 {
     dispatcher->work();
@@ -754,6 +814,17 @@ std::shared_future<void> rpc_dispatcher::send_async(enum rpc_cmd cmd, std::share
     return done;
 }
 
+std::shared_future<void> rpc_dispatcher::push_batch(std::vector<rpc_msg_ptr> & msgs) {
+    GGML_ASSERT(!msgs.empty());
+    for (size_t i = 0; i < msgs.size(); i++) {
+        msgs[i]->batch = (int) i + 1;
+    }
+    std::shared_future<void> done = msgs.back()->completion.get_future().share();
+    GGML_ASSERT(queue.push_all(msgs));
+    msgs.clear();
+    return done;
+}
