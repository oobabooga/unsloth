@@ -1550,6 +1645,45 @@ static rpc_p2p_client_state & rpc_p2p_client() {
     return *st;
 }
 
+static std::mutex & rpc_p2p_order_mutex() {
+    return rpc_p2p_client().order_mutex;
+}
+
+static rpc_pending_cmds * rpc_pending(ggml_backend_rpc_context * ctx) {
+    if (!ctx->pending) {
+        ctx->pending = std::make_shared<rpc_pending_cmds>();
+    }
+    return ctx->pending.get();
+}
+
+static void rpc_push_xfers(rpc_pending_cmds * pending) {
+    rpc_p2p_client_state & st = rpc_p2p_client();
+    for (auto & x : pending->xfers) {
+        const uint64_t tag = ++st.next_tag;
+        x.push->tag       = tag;
+        x.await->tag      = tag;
+        x.push_msg->uid   = tag;
+        x.await_msg->uid  = tag;
+        std::vector<rpc_dispatcher::rpc_msg_ptr> push = { x.push_msg };
+        x.src->last = x.src->dispatcher->push_batch(push);
+    }
+    pending->xfers.clear();
+}
+
+// queues what this backend held back, ahead of a command that is not its graph (sync, read, event, ...)
+static void rpc_flush_pending(ggml_backend_rpc_context * ctx) {
+    rpc_pending_cmds * pending = ctx->pending.get();
+    if (pending == nullptr || pending->msgs.empty()) {
+        return;
+    }
+    std::unique_lock<std::mutex> order;
+    if (!pending->xfers.empty()) {
+        order = std::unique_lock<std::mutex>(rpc_p2p_order_mutex());
+        rpc_push_xfers(pending);
+    }
+    ctx->last = ctx->dispatcher->push_batch(pending->msgs);
+}
+
