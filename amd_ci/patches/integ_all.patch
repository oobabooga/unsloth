+    "name": "Qwen3-0.6B-NPU2",
+    "url": "https://huggingface.co/FastFlowLM/Qwen3-0.6B-NPU2",
+    "file_url": "https://huggingface.co/api/models/FastFlowLM/Qwen3-0.6B-NPU2/tree/main",
