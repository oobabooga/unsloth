+
+from __future__ import annotations
+
+import types
+
+import pytest
+
+from core.inference import diffusion_qwenimage21_gate_up as g
+
+torch = pytest.importorskip("torch")
+qmod = pytest.importorskip("diffusers.models.transformers.transformer_qwenimage21")
+nn = torch.nn
+
+
+@pytest.fixture(autouse = True)
+def _clean(monkeypatch):
+    monkeypatch.delenv(g.GATE_UP_ENV, raising = False)
+    g.uninstall()
+    yield
+    g.uninstall()
+
+
+def _ff(dtype = torch.float64, hidden = 32, mlp = 96, seed = 0):
+    torch.manual_seed(seed)
+    return qmod.QwenImage21SwiGLUFeedForward(hidden, mlp).to(dtype)
+
+
+def _root(*ffs):
+    root = nn.Module()
+    root.blocks = nn.ModuleList(ffs)
+    return root
+
+
+@pytest.fixture
+def rocm_host(monkeypatch):
+    """CPU tensors posing as resident weights on a measured ROCm card."""
+    monkeypatch.setattr(g, "_resident_device", lambda root: torch.device("cpu"))
+    monkeypatch.setattr(g, "arch_ok", lambda device: True)
+    # the real check also wants a cuda bf16 / fp16 weight; everything else it checks is kept
+    monkeypatch.setattr(
+        g,
+        "_plain_linear",
+        lambda lin: type(lin) is nn.Linear
+        and lin.bias is None
+        and not lin._forward_hooks
+        and not lin._forward_pre_hooks
+        and "forward" not in lin.__dict__,
+    )
+
+
+def test_installed_diffusers_matches_the_fingerprint():
+    assert g._stock_digest(qmod.QwenImage21SwiGLUFeedForward) in g._FINGERPRINTS
+
+
+def test_fused_forward_matches_stock_and_shares_storage(rocm_host):
+    ff = _ff()
+    x = torch.randn(2, 7, 32, dtype = torch.float64)
+    ref = ff(x)
+    gate_before = ff.gate_layer.weight.detach().clone()
+    proj_before = ff.proj.weight.detach().clone()
+    assert g.install_modules(_root(ff)) == 1
+    fused = ff.__dict__[g._ATTR][0]
+    # the parts are views of the fused weight: same values, no second copy
+    whole = fused.weight
+    assert ff.gate_layer.weight.data_ptr() == whole.data_ptr()
+    assert ff.proj.weight.data_ptr() == whole.data_ptr() + 96 * 32 * whole.element_size()
+    assert torch.equal(ff.gate_layer.weight, gate_before) and torch.equal(ff.proj.weight, proj_before)
+    got = ff(x)
+    torch.testing.assert_close(got, ref, rtol = 0, atol = 1e-12)
+    assert type(ff).forward.__unsloth_q21_gate_up__
+
+
+def test_a_replaced_part_falls_back_to_the_stock_pair(rocm_host):
+    ff = _ff()
+    x = torch.randn(1, 5, 32, dtype = torch.float64)
+    assert g.install_modules(_root(ff)) == 1
+
+    class Wrapped(nn.Module):  # stands in for a LoRA wrapper
+        def __init__(self, base):
+            super().__init__()
+            self.base = base
+
+        def forward(self, h):
+            return self.base(h) * 2
+
+    ff.gate_layer = Wrapped(ff.gate_layer)
+    assert g._fused_record(ff) is None
+    want = ff.out(ff.activation_fn(ff.gate_layer(x)) * ff.proj(x))
+    torch.testing.assert_close(ff(x), want, rtol = 0, atol = 0)
+
+
+def test_a_reassigned_weight_falls_back(rocm_host):
+    ff = _ff()
+    assert g.install_modules(_root(ff)) == 1
+    ff.proj.weight = nn.Parameter(ff.proj.weight.detach().clone() + 1)
+    assert g._fused_record(ff) is None
+
+
+def test_ineligible_parts_stay_stock(rocm_host):
+    ff = _ff()
+    ff.gate_layer.register_forward_hook(lambda *a: None)
+    assert g.install_modules(_root(ff)) == 0
+    assert g._ATTR not in ff.__dict__
+
+
+def test_nvidia_and_cpu_hosts_never_install(monkeypatch):
+    ff = _ff()
+    monkeypatch.setattr(g, "is_rocm_torch", lambda _torch: False)
+    monkeypatch.setattr(torch.cuda, "is_available", lambda: True)
+    stock = qmod.QwenImage21SwiGLUFeedForward.__dict__["forward"]
+    # not even the class is patched on NVIDIA
+    fake = type("QwenImage21Transformer2DModel", (nn.Module,), {})()
+    fake.ff = ff
+    assert not g.install(fake)
+    assert qmod.QwenImage21SwiGLUFeedForward.__dict__["forward"] is stock
+    assert g._ATTR not in ff.__dict__
+    assert not g.arch_ok(torch.device("cuda", 0))
+
+
+def test_offloaded_or_other_models_never_install(monkeypatch):
+    monkeypatch.setattr(g, "is_rocm_torch", lambda _torch: True)
+    monkeypatch.setattr(torch.cuda, "is_available", lambda: True)
+    fake = type("QwenImage21Transformer2DModel", (nn.Module,), {})()
+    fake.ff = _ff()
+    assert not g.install(fake, offload_active = True)
+    other = type("FluxTransformer2DModel", (nn.Module,), {})()
+    other.ff = _ff()
+    assert not g.install(other)
+
+
+@pytest.mark.parametrize("value, arch, want", [
+    (None, "gfx1151", True),
+    (None, "gfx942", False),
+    ("1", "gfx942", True),
+    ("0", "gfx1151", False),
+])
+def test_arch_gate(monkeypatch, value, arch, want):
+    if value is None:
+        monkeypatch.delenv(g.GATE_UP_ENV, raising = False)
+    else:
+        monkeypatch.setenv(g.GATE_UP_ENV, value)
+    monkeypatch.setattr(g, "is_rocm_torch", lambda _torch: True)
+    monkeypatch.setattr(torch.cuda, "is_available", lambda: True)
+    monkeypatch.setattr(torch.cuda, "get_device_properties", lambda index: types.SimpleNamespace(gcnArchName = arch))
+    assert g.arch_ok(torch.device("cuda", 0)) is want
+
+
+def test_kill_switch_uninstalls(monkeypatch, rocm_host):
+    ff = _ff()
+    assert g.install_modules(_root(ff)) == 1
+    monkeypatch.setenv(g.GATE_UP_ENV, "0")
+    fake = type("QwenImage21Transformer2DModel", (nn.Module,), {})()
+    fake.ff = ff
+    assert not g.install(fake)
+    assert g._ATTR not in ff.__dict__
+    assert not getattr(qmod.QwenImage21SwiGLUFeedForward.__dict__["forward"], "__unsloth_q21_gate_up__", False)
+
+
+def test_install_is_idempotent(rocm_host):
+    ff = _ff()
+    root = _root(ff)
+    assert g.install_modules(root) == 1
+    rec = ff.__dict__[g._ATTR]
+    assert g.install_modules(root) == 1
+    assert ff.__dict__[g._ATTR] is rec
