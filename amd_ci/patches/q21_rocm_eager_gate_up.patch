new file mode 100644
index 0000000000..f3b4bccf7b
--- /dev/null
+++ b/studio/backend/core/inference/diffusion_qwenimage21_gate_up.py
@@ -0,0 +1,212 @@
+# SPDX-License-Identifier: AGPL-3.0-only
+# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved. See /studio/LICENSE.AGPL-3.0
+
+"""Qwen-Image-2.1 SwiGLU gate and value projections as one GEMM on ROCm (gfx1151: one N=24576 GEMM beats two
+N=12288 ones by ~7%). The two Linears become views of the fused weight (no extra memory); resident bf16 / fp16
+nn.Linear only, so LoRA wrappers, quantized weights and offloaded loads keep the stock pair.
+UNSLOTH_DIFFUSION_Q21_GATE_UP: auto (measured arches) | 1 (any ROCm card) | 0 (off)"""
+
+from __future__ import annotations
+
+import os
+import threading
+from typing import Any, Optional
+
+from .diffusion_autoopt.patches import source_digest
+from .rocm_bf16 import is_rocm_torch
+
+GATE_UP_ENV = "UNSLOTH_DIFFUSION_Q21_GATE_UP"
+# gfx1151 measured (Strix Halo, torch 2.11 + ROCm 7.13 hipBLASLt); other ROCm cards need UNSLOTH_DIFFUSION_Q21_GATE_UP=1.
+GATE_UP_ARCHES = frozenset({"gfx1151"})
+
+_MODULE = "diffusers.models.transformers.transformer_qwenimage21"
+_CLASS = "QwenImage21SwiGLUFeedForward"
+# diffusers 0.41.0 / 0.42.1
+_FINGERPRINTS = frozenset({"5658f3c8fa668c6d"})
+_ATTR = "_unsloth_q21_gate_up"
+
+_LOCK = threading.Lock()
+_STATE: dict = {}
+
+
+def _setting() -> str:
+    raw = (os.environ.get(GATE_UP_ENV) or "auto").strip().lower()
+    if raw in ("0", "off", "false", "no"):
+        return "0"
+    if raw in ("1", "on", "true", "yes"):
+        return "1"
+    return "auto"
+
+
+def disabled() -> bool:
+    return _setting() == "0"
+
+
+def arch_ok(device: Any) -> bool:
+    """ROCm only; ``auto`` keeps it to the measured arches."""
+    try:
+        import torch
+
+        setting = _setting()
+        if setting == "0" or not torch.cuda.is_available() or not is_rocm_torch(torch):
+            return False
+        if setting == "1":
+            return True
+        from utils.hardware.hardware import _props_gfx_arch
+
+        index = device.index if device.index is not None else torch.cuda.current_device()
+        return _props_gfx_arch(torch.cuda.get_device_properties(index)) in GATE_UP_ARCHES
+    except Exception:  # noqa: BLE001
+        return False
+
+
+def _stock_digest(cls: Any) -> Optional[str]:
+    return source_digest(cls.__dict__.get("forward"))
+
+
+def _plain_linear(lin: Any) -> bool:
+    import torch
+    from torch import nn
+
+    if type(lin) is not nn.Linear or lin.bias is not None:
+        return False
+    if "forward" in lin.__dict__ or lin._forward_hooks or lin._forward_pre_hooks:
+        return False
+    w = lin.weight
+    return (
+        type(w) is nn.Parameter
+        and w.dtype in (torch.bfloat16, torch.float16)
+        and w.device.type == "cuda"
+        and w.dim() == 2
+    )
+
+
+def _fused_record(module: Any) -> Any:
+    """The fused Linear when its parts are still the ones it was built from, on its device; else None."""
+    rec = module.__dict__.get(_ATTR)
+    if rec is None:
+        return None
+    fused, gate, proj, gate_w, proj_w = rec
+    if module.gate_layer is not gate or module.proj is not proj:
+        return None  # a LoRA wrapper or a swapped Linear: the stock pair honours it
+    if gate.weight is not gate_w or proj.weight is not proj_w:
+        return None
+    if gate_w.device != fused.weight.device:
+        return None
+    return fused
+
+
+def _make_forward(stock: Any) -> Any:
+    def forward(self, hidden_states):
+        fused = _fused_record(self)
+        if fused is None:
+            return stock(self, hidden_states)
+        gate, value = fused(hidden_states).split(
+            (self.gate_layer.out_features, self.proj.out_features), dim = -1
+        )
+        return self.out(self.activation_fn(gate) * value)
+
+    forward.__unsloth_q21_gate_up__ = True
+    forward.__wrapped_stock__ = stock
+    return forward
+
+
+def _patch_class(logger: Any = None) -> bool:
+    try:
+        import importlib
+
+        cls = getattr(importlib.import_module(_MODULE), _CLASS)
+    except Exception:  # noqa: BLE001 - diffusers without Qwen-Image 2.1
+        return False
+    with _LOCK:
+        current = cls.__dict__.get("forward")
+        if getattr(current, "__unsloth_q21_gate_up__", False):
+            return True
+        digest = _stock_digest(cls)
+        if digest not in _FINGERPRINTS:
+            if logger is not None:
+                logger.info("diffusion.q21_gate_up: stock SwiGLU kept: forward differs (%s)", digest)
+            return False
+        _STATE["stock"] = (cls, current)
+        cls.forward = _make_forward(current)
+    return True
+
+
+def _resident_device(root: Any) -> Any:
+    devices = {p.device for p in root.parameters()}
+    if len(devices) != 1:
+        return None
+    dev = next(iter(devices))
+    return dev if dev.type == "cuda" else None
+
+
+def install_modules(root: Any, logger: Any = None) -> int:
+    """Fuse every eligible SwiGLU of ``root`` (weights resident on one ROCm card); returns the fused count."""
+    if disabled():
+        return 0
+    dev = _resident_device(root)
+    if dev is None or not arch_ok(dev) or not _patch_class(logger):
+        return 0
+    from .diffusion_zimage_fused import _fuse_linears, _share_storage
+
+    count = 0
+    with _LOCK:
+        for module in root.modules():
+            if type(module).__name__ != _CLASS:
+                continue
+            if _fused_record(module) is not None:
+                count += 1
+                continue
+            parts = [module.gate_layer, module.proj]
+            if not all(_plain_linear(p) for p in parts):
+                continue
+            if len({(p.weight.dtype, p.weight.device, p.in_features) for p in parts}) != 1:
+                continue
+            fused = _fuse_linears(parts)
+            if fused is None or not _share_storage(fused, parts):
+                continue
+            module.__dict__[_ATTR] = (fused, parts[0], parts[1], parts[0].weight, parts[1].weight)
+            count += 1
+    if logger is not None and count:
+        logger.info(
+            "diffusion.q21_gate_up: SwiGLU gate + value projections run as one GEMM on %d block(s)", count
+        )
+    return count
+
+
+def install(transformer: Any, logger: Any = None, offload_active: bool = False) -> Any:
+    """Before the first compile; deferred to the first forward when the weights are not on the GPU yet."""
+    if disabled():
+        uninstall(transformer)
+        return 0
+    if type(transformer).__name__ != "QwenImage21Transformer2DModel" or offload_active:
+        return 0
+    try:
+        import torch
+
+        if not torch.cuda.is_available() or not is_rocm_torch(torch):
+            return 0
+    except Exception:  # noqa: BLE001
+        return 0
+    if _resident_device(transformer) is not None:
+        return install_modules(transformer, logger)
+    from .diffusion_int8_fused import run_on_first_call
+
+    run_on_first_call(transformer, "q21_gate_up", lambda t: install_modules(t, logger))
+    return None
+
+
+def uninstall(transformer: Any = None) -> None:
+    """Restore the stock SwiGLU forward and drop the fused records (the parts keep their weight views)."""
+    if transformer is not None:
+        from .diffusion_int8_fused import cancel_first_call
+
+        cancel_first_call(transformer, "q21_gate_up")
+        for module in transformer.modules():
+            module.__dict__.pop(_ATTR, None)
+    with _LOCK:
+        stock = _STATE.pop("stock", None)
+        if stock is not None:
+            cls, fn = stock
+            if getattr(cls.__dict__.get("forward"), "__unsloth_q21_gate_up__", False):
+                cls.forward = fn
