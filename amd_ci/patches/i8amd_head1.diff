@@ -329,6 +329,69 @@ def test_fused_launches_match_one_launch_per_quantiser_interpreted():
     assert len(res) == 6 and all(all(v) for v in res.values()), res
 
 
+_TAIL_FIRST = textwrap.dedent(
+    """
+    import json, torch, torch.nn.functional as F
+    from core.inference import diffusion_int8_attention as I
+    from core.inference import diffusion_int8_attention_triton as T
+    out = {}
+    for tokens, D in ((131, 64), (200, 128), (192, 128)):
+        q, k, v = I.probe_inputs("cpu", torch.float16, tokens, 2, D, seed = tokens)
+        ref = F.scaled_dot_product_attention(*(t.double().permute(0, 2, 1, 3) for t in (q, k, v))).permute(0, 2, 1, 3)
+        for pv in ("f16_t", "int8"):
+            got = {}
+            for first in (False, True):
+                cfg = {"bm": 64, "bn": 32, "warps": 4, "stages": 1, "kscale": "tile", "tail_first": first}
+                got[first] = T.int8_attention(q, k, v, cfg, pv = pv)
+            out[f"{tokens}/{D}/{pv}"] = {
+                "ragged": tokens % 32 != 0,
+                "same": torch.equal(got[False], got[True]),
+                "cos": [float(F.cosine_similarity(g.double().flatten(), ref.flatten(), 0)) for g in got.values()],
+                "rel_l1": [float((g.double() - ref).abs().mean() / ref.abs().mean()) for g in got.values()],
+            }
+    print("RESULT " + json.dumps(out))
+    """
+)
+
+
+@pytest.mark.skipif(not _interpreter_ok(), reason = "needs the Triton >= 3.7 interpreter")
+def test_partial_key_tile_first_keeps_the_numerics_interpreted():
+    """``tail_first`` (the ROCm tables) runs the masked partial key tile before the full ones: same accuracy vs fp64,
+    and with no partial tile (keys a multiple of bn) the same bits (Triton interpreter, CPU)."""
+    env = dict(os.environ, TRITON_INTERPRET = "1")
+    r = subprocess.run(
+        [sys.executable, "-c", _TAIL_FIRST],
+        cwd = BACKEND_DIR,
+        env = env,
+        capture_output = True,
+        text = True,
+        timeout = 900,
+    )
+    line = [x for x in r.stdout.splitlines() if x.startswith("RESULT ")]
+    assert line, (r.stdout[-2000:], r.stderr[-3000:])
+    res = json.loads(line[0][7:])
+    assert len(res) == 6
+    for key, m in res.items():
+        if not m["ragged"]:
+            assert m["same"], key
+        assert min(m["cos"]) >= I.MIN_COSINE and max(m["rel_l1"]) <= I.MAX_REL_L1 / 2, (key, m)
+        assert abs(m["rel_l1"][0] - m["rel_l1"][1]) <= 0.002, (key, m)
+
+
+def test_rocm_tables_take_the_partial_key_tile_first():
+    from core.inference import diffusion_int8_attention_triton as T
+    for table in I.ROCM_KERNEL_CONFIGS.values():
+        for cfg in table.values():
+            assert cfg.get("tail_first") is True
+            plan = T._make_plan(
+                *(torch.empty(1, 77, 2, 64, dtype = torch.bfloat16),) * 3, cfg, None, None
+            )
+            assert plan["attn_meta"]["TAIL_FIRST"] is True and plan["attn_meta"]["EVEN_K"] is False
+    for table in I.TRITON_KERNEL_CONFIGS.values():
+        for cfg in table.values():
+            assert not cfg.get("tail_first")
+
+
