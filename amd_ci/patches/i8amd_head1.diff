+@pytest.mark.parametrize("tokens", [1039, 1056, 9000])
+def test_partial_key_tile_first_on_the_card(tokens):
+    """The table's tail_first against the kernel without it: both meet the fp64 gate; with no partial key tile
+    (1056 = 33 x 32 keys) the same bits."""
+    from core.inference import diffusion_int8_attention_triton as T
+
+    cfg = _rocm_config(128)
+    q, k, v = I.probe_inputs("cuda", torch.bfloat16, tokens, 3, 128, seed = tokens)
+    ref = _fp64(q, k, v)
+    first = T.int8_attention(q, k, v, dict(cfg, tail_first = True))
+    last = T.int8_attention(q, k, v, dict(cfg, tail_first = False))
+    for got in (first, last):
+        assert _cos(got, ref) >= I.MIN_COSINE
+        assert float((got.double() - ref).abs().mean() / ref.abs().mean()) <= I.MAX_REL_L1
+    if tokens % int(T.select_config(cfg, tokens)["bn"]) == 0:
+        assert torch.equal(first, last)
+
