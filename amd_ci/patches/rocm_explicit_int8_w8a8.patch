diff --git a/studio/backend/core/inference/diffusion_transformer_quant.py b/studio/backend/core/inference/diffusion_transformer_quant.py
index 5156afa46..83be6fffe 100644
--- a/studio/backend/core/inference/diffusion_transformer_quant.py
+++ b/studio/backend/core/inference/diffusion_transformer_quant.py
@@ -1337,6 +1337,21 @@ def rdna_auto_w8a8_reason(target: Any, family: Optional[str]) -> Optional[str]:
     return reason
 
 
+def rdna_explicit_w8a8_reason(target: Any, family: Optional[str]) -> Optional[str]:
+    """Why an explicit int8 request on this ROCm RDNA card runs the compiled W8A8 linear inside a compiled denoiser,
+    else None (weight-only int8). Same gates as the AUTO pick minus its family table: the user asked for int8, and
+    weight-only int8 on RDNA dequantises every weight per GEMM, slower than bf16. Kill switch UNSLOTH_NATIVE_INT8_ACT=0."""
+    if not _rocm_cuda(target) or not native_quant_host(target):
+        return None
+    if not _sys.platform.startswith("linux"):
+        return None
+    if int8_act_disabled() or not rocm_rdna_w8a8_ready(getattr(target, "ordinal", None)):
+        return None
+    if native_quant_scheme(target, TQ_INT8, family = family) != TQ_INT8:
+        return None
+    return "an explicit int8 request on RDNA runs the compiled W8A8 linear"
+
+
