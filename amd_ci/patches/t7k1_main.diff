+# SPDX-License-Identifier: AGPL-3.0-only
+# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved.
+
+"""Full finetuning (every base weight trainable, no LoRA) under tensor parallel on a gloo CPU world vs one
+process: the direct API (apply_tensor_parallel + a custom loop) and UNSLOTH_TP_SIZE=2 with the HF Trainer
+(loader flag full_finetuning = True, tensor parallel applied at Trainer init, Trainer.save_model)."""
+
+import multiprocessing
+import os
+
+if multiprocessing.parent_process() is not None or getattr(
+    multiprocessing.current_process(), "_inheriting", False
+):
+    os.environ["CUDA_VISIBLE_DEVICES"] = ""  # spawned gloo ranks: CPU only, also on GPU hosts
+
+import sys  # noqa: E402
+import tempfile  # noqa: E402
+
+import pytest  # noqa: E402
+import torch  # noqa: E402
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from test_tp_native_gloo import (  # noqa: E402
+    _Rows,
+    _clip_fp64,
+    _free_port,
+    _grads,
+    _import_checkout_unsloth,
+    _save_checkpoint,
+    _trainer_args,
+)
+from test_tp_native_oracle import ARCHS, _batch, build  # noqa: E402
+
+_ENV_KEYS = ("UNSLOTH_TP_SIZE", "UNSLOTH_PP_SIZE", "UNSLOTH_FSDP2", "UNSLOTH_FSDP2_BACKEND")
+# Adam's m / (sqrt(v) + eps) turns fp32 reduction-order noise on near-zero gradients into visible weight
+# drift at eps 1e-8; at 1e-4 a real tp error (a missing all-reduce) still moves the weights far more.
+_ADAM_EPS = 1e-4
+
+
+def _full_ft_train(model, ids, steps, clip):
+    params = [p for p in model.parameters() if p.requires_grad]
+    opt = torch.optim.AdamW(params, lr = 1e-3, eps = _ADAM_EPS, foreach = False)
+    losses, norms, grads = [], [], None
+    for step in range(steps):
+        out = model(input_ids = ids, labels = ids, use_cache = False)
+        out.loss.backward()
+        if step == 0:
+            grads = _grads(model)
+        norms.append(float(clip(params, 1.0)))
+        opt.step()
+        opt.zero_grad(set_to_none = True)
+        losses.append(float(out.loss))
+    return grads, losses, norms
+
+
+def _case_api(rank, world, tmp, arch):
+    from safetensors.torch import load_file
+    from torch.distributed.device_mesh import init_device_mesh
+
+    from unsloth.models import tp_native as tpn
+
+    repo, overrides = ARCHS[arch]
+    ref = build(repo, overrides, lora = False)
+    model = build(repo, overrides, lora = False)
+    for m in (ref, model):
+        m.requires_grad_(True)
+        m.generation_config.pad_token_id = None  # tiny repos ship -1, which save_pretrained rejects
+    mesh = init_device_mesh("cpu", (world,), mesh_dim_names = ("tp",))
+    tpn.apply_tensor_parallel(model, mesh["tp"])
+    trainable_shards = sum(
+        tpn._is_dtensor(p) and p.requires_grad and p.placements[0].is_shard()
+        for p in model.parameters()
+    )
+    ids = _batch(ref)
+    ref_out = _full_ft_train(ref, ids, 3, _clip_fp64)
+    tp_out = _full_ft_train(model, ids, 3, tpn.tp_clip_grad_norm_)
+    final = tpn.tp_full_state_dict(model)
+    ref_dir, tp_dir = os.path.join(tmp, "ref"), os.path.join(tmp, "tp")
+    if rank == 0:
+        ref.save_pretrained(ref_dir)
+    from unsloth.models.tp_replica import tp_collective
+
+    tp_collective(model, "save_pretrained", lambda: model.save_pretrained(tp_dir), "all")
+    return {
+        "ref": ref_out,
+        "tp": tp_out,
+        "ref_final": {k: v.detach().clone() for k, v in ref.state_dict().items()},
+        "tp_final": final,
+        "trainable_shards": trainable_shards,
+        "saved_ref": load_file(os.path.join(ref_dir, "model.safetensors")) if rank == 0 else None,
+        "saved_tp": load_file(os.path.join(tp_dir, "model.safetensors")) if rank == 0 else None,
+        "is_tp_after_save": tpn.is_tensor_parallel(model)
+        and any(tpn._is_dtensor(p) for p in model.parameters()),
+    }
+
+
+def _case_env(rank, world, tmp, ckpt):
+    error = _import_checkout_unsloth()
+    if error is not None:
+        return {"skip": error}
+    import transformers
+    from safetensors.torch import load_file
+    from transformers import AutoModelForCausalLM
+
+    from unsloth.models import tp_env, tp_native
+    from unsloth.models._utils import patch_gradient_accumulation_fix
+
+    patch_gradient_accumulation_fix(transformers.Trainer)
+
+    class SequentialTrainer(transformers.Trainer):
+        def _get_train_sampler(self, *args, **kwargs):
+            return torch.utils.data.SequentialSampler(self.train_dataset)
+
+    def load(
+        model_name,
+        load_in_4bit = True,
+        full_finetuning = False,
+        **kwargs,
+    ):
+        model = AutoModelForCausalLM.from_pretrained(
+            model_name, torch_dtype = torch.float32, attn_implementation = "eager"
+        )
+        model.requires_grad_(full_finetuning)
+        return model
+
+    load = tp_env.tensor_parallel_env_load(load)
+    refused = None
+    try:
+        model = load(ckpt, load_in_4bit = False, full_finetuning = True)
+    except Exception as e:
+        refused = f"{type(e).__name__}: {e}"
+        return {"refused": refused}
+    g = torch.Generator().manual_seed(1)
+    data = _Rows(list(torch.randint(0, 1000, (3 * 4, 9), generator = g)))
+    out_dir = os.path.join(tmp, f"out{world}")
+    args = _trainer_args(
+        out_dir,
+        2,
+        max_steps = 3,
+        adam_epsilon = _ADAM_EPS,
+        learning_rate = 1e-3,
+        save_strategy = "steps",
+        save_steps = 2,
+    )
+    try:
+        trainer = SequentialTrainer(model = model, args = args, train_dataset = data)
+    except RuntimeError as e:
+        if "full finetuning on a tensor parallel x native FSDP2" not in str(e):
+            raise
+        return {"refused": None, "trainer_refused": str(e)}
+    trainer.train()
+    is_tp = tp_native.is_tensor_parallel(trainer.model)
+    state = (
+        tp_native.tp_full_state_dict(trainer.model)
+        if is_tp
+        else {k: v.detach().clone() for k, v in trainer.model.state_dict().items()}
+    )
+    save_dir = os.path.join(tmp, f"saved{world}")
+    trainer.save_model(save_dir)
+    import torch.distributed as dist
+
+    if dist.is_initialized():
+        dist.barrier()
+    logs = [h for h in trainer.state.log_history if "loss" in h]
+    return {
+        "refused": refused,
+        "is_tp": is_tp,
+        "losses": [h["loss"] for h in logs],
+        "grad_norms": [h.get("grad_norm") for h in logs],
+        "state": state,
+        "saved": load_file(os.path.join(save_dir, "model.safetensors")) if rank == 0 else None,
+        "ckpt_files": sorted(os.listdir(os.path.join(out_dir, "checkpoint-2"))),
+    }
+
+
+def _qat_config(kind):
+    import torch as _t
+    from torchao.quantization import (
+        Int4WeightOnlyConfig,
+        Int8DynamicActivationIntxWeightConfig,
+        IntxWeightOnlyConfig,
+    )
+    from torchao.quantization.granularity import PerAxis, PerGroup
+
+    return {
+        "int4": lambda: Int4WeightOnlyConfig(group_size = 16),
+        "int8_group": lambda: IntxWeightOnlyConfig(weight_dtype = _t.int8, granularity = PerGroup(16)),
+        "int8_axis": lambda: IntxWeightOnlyConfig(weight_dtype = _t.int8, granularity = PerAxis(0)),
+        "int8_int4": lambda: Int8DynamicActivationIntxWeightConfig(
+            weight_dtype = _t.int4, weight_granularity = PerGroup(16)
+        ),
+    }[kind]()
+
+
+def _case_qat(
+    rank,
+    world,
+    tmp,
+    kind,
+    lora,
+    kv_heads = 2,
+):
+    """QAT (torchao QATConfig prepare, as Unsloth's qat_scheme) on full finetuning or under LoRA."""
+    from peft import LoraConfig, get_peft_model
+    from torch.distributed.device_mesh import init_device_mesh
+    from torchao.quantization import quantize_
+    from torchao.quantization.qat import QATConfig
+
+    from unsloth.models import tp_native as tpn
+
+    repo, overrides = ARCHS["llama"]
+    overrides = {
+        **overrides,
+        "hidden_size": 32,
+        "intermediate_size": 64,
+        "num_attention_heads": 4,
+        "num_key_value_heads": kv_heads,
+        "head_dim": 8,
+    }
+
+    def make():
+        model = build(repo, overrides, lora = False)
+        decoder = model.model.layers
+        quantize_(decoder, QATConfig(_qat_config(kind), step = "prepare"))
+        if lora:
+            torch.manual_seed(1)
+            config = LoraConfig(
+                r = 4, lora_alpha = 8, target_modules = "all-linear", init_lora_weights = False
+            )
+            model = get_peft_model(model, config)
+        else:
+            model.requires_grad_(True)
+        return model
+
+    ref, model = make(), make()
+    mesh = init_device_mesh("cpu", (world,), mesh_dim_names = ("tp",))
+    try:
+        tpn.apply_tensor_parallel(model, mesh["tp"])
+    except ValueError as e:
+        return {"refused": str(e)}
+    fq = sum(type(m).__name__ == "FakeQuantizedLinear" for m in model.modules())
+    ids = _batch(ref)
+    return {
+        "refused": None,
+        "fake_quantized": fq,
+        "ref": _full_ft_train(ref, ids, 3, _clip_fp64),
+        "tp": _full_ft_train(model, ids, 3, tpn.tp_clip_grad_norm_),
+    }
+
+
+CASES = {"api": _case_api, "env": _case_env, "qat": _case_qat}
+
+
+def _worker(rank, world, port, case, tmp, env, kwargs):
+    os.environ.update(
+        MASTER_ADDR = "127.0.0.1",
+        MASTER_PORT = str(port),
+        RANK = str(rank),
+        WORLD_SIZE = str(world),
+        LOCAL_RANK = str(rank),
+        LOCAL_WORLD_SIZE = str(world),
+    )
+    for key in _ENV_KEYS:
+        os.environ.pop(key, None)
+    os.environ.update(env)
+    torch.set_num_threads(2)
+    import datetime
+
+    import torch.distributed as dist
+
+    if case in ("api", "qat"):
+        error = _import_checkout_unsloth()
+        if error is not None:
+            torch.save({"skip": error}, os.path.join(tmp, f"result_{rank}.pt"))
+            return
+        dist.init_process_group(
+            "gloo", rank = rank, world_size = world, timeout = datetime.timedelta(seconds = 300)
+        )
+    try:
+        res = CASES[case](rank, world, tmp, **kwargs)
+        torch.save(res, os.path.join(tmp, f"result_{rank}.pt"))
+    finally:
+        if dist.is_initialized():
+            dist.destroy_process_group()
+
+
+def _spawn(
+    case,
+    world,
+    env = None,
+    tmp = None,
+    **kwargs,
+):
+    ctx = multiprocessing.get_context("spawn")
+    port = _free_port()
+    procs = [
+        ctx.Process(target = _worker, args = (r, world, port, case, tmp, env or {}, kwargs))
+        for r in range(world)
+    ]
+    for p in procs:
+        p.start()
+    for p in procs:
+        p.join(900)
+    codes = [p.exitcode for p in procs]
+    for p in procs:
+        if p.is_alive():
+            p.kill()
+    assert codes == [0] * world, f"rank exit codes {codes}"
+    results = [
+        torch.load(os.path.join(tmp, f"result_{r}.pt"), weights_only = False) for r in range(world)
+    ]
+    for r in range(world):
+        os.remove(os.path.join(tmp, f"result_{r}.pt"))
+    if "skip" in results[0]:
+        pytest.skip(f"import unsloth failed on this host: {results[0]['skip']}")
+    return results
+
+
+def _assert_state(got, want, what):
+    assert set(got) == set(want), sorted(set(got) ^ set(want))[:6]
+    for key, value in want.items():
+        torch.testing.assert_close(got[key], value, rtol = 1e-4, atol = 2e-6, msg = f"{what} {key}")
+
+
+@pytest.mark.parametrize("arch", ["llama", "llama_bias", "qwen3", "gemma2"])
+def test_tp2_full_finetuning_matches_one_process(arch):
+    with tempfile.TemporaryDirectory() as tmp:
+        results = _spawn("api", 2, tmp = tmp, arch = arch)
+    for rank, res in enumerate(results):
+        ref_grads, ref_losses, ref_norms = res["ref"]
+        grads, losses, norms = res["tp"]
+        assert res["trainable_shards"] > 0  # the sharded base weights themselves train
+        assert set(grads) == set(ref_grads) and len(ref_grads) > 0
+        for name in ref_grads:
+            torch.testing.assert_close(grads[name], ref_grads[name], rtol = 1e-4, atol = 1e-6, msg = name)
+        assert losses == pytest.approx(ref_losses, rel = 1e-5, abs = 1e-6), (rank, losses, ref_losses)
+        assert norms == pytest.approx(ref_norms, rel = 1e-5), (rank, norms, ref_norms)
+        _assert_state(res["tp_final"], res["ref_final"], f"rank {rank}")
+        assert res["is_tp_after_save"]
+    saved_tp, saved_ref = results[0]["saved_tp"], results[0]["saved_ref"]
+    assert set(saved_tp) == set(saved_ref)
+    for key in saved_ref:
+        assert saved_tp[key].shape == saved_ref[key].shape, key
+        torch.testing.assert_close(saved_tp[key], saved_ref[key], rtol = 1e-4, atol = 2e-6, msg = key)
+
+
+def test_env_tp2_full_finetuning_trainer_matches_one_process():
+    with tempfile.TemporaryDirectory() as tmp:
+        ckpt = _save_checkpoint("llama", os.path.join(tmp, "ckpt"))
+        (ref,) = _spawn("env", 1, tmp = tmp, ckpt = ckpt)
+        results = _spawn("env", 2, {"UNSLOTH_TP_SIZE": "2"}, tmp = tmp, ckpt = ckpt)
+    assert ref["refused"] is None and not ref["is_tp"]
+    for rank, res in enumerate(results):
+        assert res["refused"] is None, res["refused"]  # main: "does not support full finetuning"
+        assert res["is_tp"]
+        assert res["losses"] == pytest.approx(ref["losses"], rel = 1e-5), (
+            res["losses"],
+            ref["losses"],
+        )
+        assert res["grad_norms"] == pytest.approx(ref["grad_norms"], rel = 1e-4)
+        _assert_state(res["state"], ref["state"], f"rank {rank}")
+        assert "unsloth_tp" in res["ckpt_files"] and "model.safetensors" in res["ckpt_files"]
+    saved = results[0]["saved"]
+    assert set(saved) == set(ref["saved"])
+    for key, value in ref["saved"].items():
+        torch.testing.assert_close(saved[key], value, rtol = 1e-4, atol = 2e-6, msg = key)
+
+
+def test_env_tp2_x_fsdp2_full_finetuning_is_refused_before_training():
+    # tp x native FSDP2 cannot gather the whole model for save_model / Trainer checkpoints: before the fix the
+    # run trained and then died at its first checkpoint (save_model refused, pointing at a missing adapter).
+    if _torch_below_2_7():
+        pytest.skip("torch < 2.7: tensor parallel x FSDP2 is refused at load")
+    with tempfile.TemporaryDirectory() as tmp:
+        ckpt = _save_checkpoint("llama", os.path.join(tmp, "ckpt"))
+        results = _spawn(
+            "env", 4, {"UNSLOTH_TP_SIZE": "2", "UNSLOTH_FSDP2": "1"}, tmp = tmp, ckpt = ckpt
+        )
+    for res in results:
+        assert res["refused"] is None, res["refused"]  # the load itself is fine
+        assert "UNSLOTH_TP_SIZE without UNSLOTH_FSDP2" in res.get("trainer_refused", ""), res
+
+
+def _torch_below_2_7():
+    from packaging.version import Version
+    return Version(torch.__version__.split("+")[0]) < Version("2.7")
+
+
+def _torchao():
+    try:
+        from torchao.quantization.qat import QATConfig  # noqa: F401
+    except Exception:
+        return False
+    return True
+
+
+def _skip_unsupported_qat(kind):
+    """Older torchao (0.13) cannot QATConfig-prepare every scheme (IntxWeightOnlyConfig, ...): skip there."""
+    from torchao.quantization import quantize_
+    from torchao.quantization.qat import QATConfig
+
+    try:
+        quantize_(
+            torch.nn.Sequential(torch.nn.Linear(32, 32)),
+            QATConfig(_qat_config(kind), step = "prepare"),
+        )
+    except Exception as e:
+        pytest.skip(f"this torchao cannot QAT-prepare {kind}: {type(e).__name__}: {e}")
+
+
+@pytest.mark.skipif(not _torchao(), reason = "torchao QAT not installed")
+@pytest.mark.parametrize(
+    "kind,lora,kv_heads",
+    [
+        ("int4", False, 2),
+        ("int8_group", False, 2),
+        ("int4", True, 2),
+        ("int8_group", True, 2),
+        # num_key_value_heads < tp: the replicated key / value projections fake quantize whole rows.
+        ("int4", True, 1),
+        ("int4", False, 1),
+    ],
+)
+def test_tp2_qat_weight_only_matches_one_process(kind, lora, kv_heads):
+    _skip_unsupported_qat(kind)
+    with tempfile.TemporaryDirectory() as tmp:
+        results = _spawn("qat", 2, tmp = tmp, kind = kind, lora = lora, kv_heads = kv_heads)
+    for rank, res in enumerate(results):
+        assert res["refused"] is None, res[
+            "refused"
+        ]  # main: "does not support QAT fake quantization"
+        assert res["fake_quantized"] > 0
+        ref_grads, ref_losses, ref_norms = res["ref"]
+        grads, losses, norms = res["tp"]
+        assert set(grads) == set(ref_grads) and ref_grads
+        for name in ref_grads:
+            torch.testing.assert_close(grads[name], ref_grads[name], rtol = 1e-4, atol = 1e-6, msg = name)
+        # Step 1 is exact; afterwards a weight that differs by fp32 reduction-order noise can round to the
+        # neighbouring quantization level (a step function), which shows up as ~1e-4 in the later losses.
+        assert losses[0] == pytest.approx(ref_losses[0], rel = 1e-6), (rank, losses, ref_losses)
+        assert norms[0] == pytest.approx(ref_norms[0], rel = 1e-5), (rank, norms, ref_norms)
+        assert losses == pytest.approx(ref_losses, rel = 5e-4), (rank, losses, ref_losses)
+        assert norms == pytest.approx(ref_norms, rel = 5e-3), (rank, norms, ref_norms)
+
+
+@pytest.mark.skipif(not _torchao(), reason = "torchao QAT not installed")
+@pytest.mark.parametrize(
+    "kind,needle",
+    [
+        ("int8_axis", "per-row (PerAxis) scale spans the in_features"),
+        ("int8_int4", "QAT fake quantization of activations"),
+    ],
+)
+def test_tp2_qat_inexact_schemes_are_refused(kind, needle):
+    _skip_unsupported_qat(kind)
+    with tempfile.TemporaryDirectory() as tmp:
+        results = _spawn("qat", 2, tmp = tmp, kind = kind, lora = False)
+    for res in results:
+        assert needle in (res["refused"] or ""), res["refused"]
diff --git a/tests/test_tp_kv_replicated_gloo.py b/tests/test_tp_kv_replicated_gloo.py
new file mode 100644
index 0000000000..bcf6aa6113
--- /dev/null
+++ b/tests/test_tp_kv_replicated_gloo.py
@@ -0,0 +1,265 @@
+# SPDX-License-Identifier: AGPL-3.0-only
+# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved.
+
+"""Tensor parallelism with num_key_value_heads < tp (Gemma3 270M / 1B: one KV head) on a gloo CPU world vs one
+process: the key / value projections are replicated, each rank computes the head its query heads read."""
+
+import multiprocessing
+import os
+
+if multiprocessing.parent_process() is not None or getattr(
+    multiprocessing.current_process(), "_inheriting", False
+):
+    os.environ["CUDA_VISIBLE_DEVICES"] = ""  # spawned gloo ranks: CPU only, also on GPU hosts
+
+import sys  # noqa: E402
+import tempfile  # noqa: E402
+
+import pytest  # noqa: E402
+import torch  # noqa: E402
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from test_tp_env_gloo import _ENV_KEYS, _case_env, _close  # noqa: E402
+from test_tp_native_gloo import (  # noqa: E402
+    _batch,
+    _case_parity,
+    _case_sharded_load,
+    _check_parity,
+    _free_port,
+    _quantize_layers,
+    _save_checkpoint,
+    _train,
+    build,
+    tpn,
+)
+from test_tp_native_oracle import LLAMA  # noqa: E402
+
+KV1 = {"num_attention_heads": 4, "num_key_value_heads": 1}
+
+
+def _case_layout(rank, world, tmp, arch, overrides):
+    """The derived plan and the per-rank attention attributes (local heads, GQA groups, the KV head)."""
+    from test_tp_native_oracle import ARCHS
+    from torch.distributed.device_mesh import init_device_mesh
+
+    repo, base = ARCHS[arch]
+    model = build(repo, {**base, **overrides})
+    mesh = init_device_mesh("cpu", (world,), mesh_dim_names = ("tp",))
+    tpn.apply_tensor_parallel(model, mesh["tp"])
+    region = model._unsloth_tp_plan.regions[0]
+    attn = region.module
+    styles = {p.name: p.style for p in region.projs}
+    k = next(p.module for p in region.projs if p.name == "k_proj")
+    return {
+        "styles": styles,
+        "kv_replicated": region.kv_replicated,
+        "heads": (attn.num_heads, attn.num_key_value_heads, attn.num_key_value_groups),
+        "rows": k.__dict__.get("_unsloth_tp_kv_rows"),
+        "k_placements": [p.is_replicate() for p in tpn._weight(k)[0].placements],
+        "saved_groups": attn.__dict__["_unsloth_tp_saved_attrs"].get("num_key_value_groups"),
+    }
+
+
+def _qlora(seed = 0):
+    from peft import LoraConfig, get_peft_model
+
+    sizes = {
+        "hidden_size": 128,
+        "intermediate_size": 256,
+        "num_attention_heads": 4,
+        "num_key_value_heads": 1,
+        "head_dim": 32,
+    }
+    model = _quantize_layers(build(LLAMA, sizes, lora = False, seed = seed), False)
+    torch.manual_seed(seed + 1)
+    config = LoraConfig(r = 4, lora_alpha = 8, target_modules = "all-linear", init_lora_weights = False)
+    return get_peft_model(model, config).train()
+
+
+def _case_qlora(rank, world, tmp):
+    import bitsandbytes as bnb
+    from torch.distributed.device_mesh import init_device_mesh
+
+    ref, model = _qlora(), _qlora()
+    k_full = model.base_model.model.model.layers[0].self_attn.k_proj.base_layer
+    k_full = bnb.functional.dequantize_4bit(k_full.weight.data, k_full.weight.quant_state)
+    mesh = init_device_mesh("cpu", (world,), mesh_dim_names = ("tp",))
+    tpn.apply_tensor_parallel(model, mesh["tp"])
+    k = model.base_model.model.model.layers[0].self_attn.k_proj
+    k_local = bnb.functional.dequantize_4bit(
+        k.base_layer.weight.data, k.base_layer.weight.quant_state
+    )
+    generated = model.generate(
+        input_ids = torch.zeros(1, 2, dtype = torch.long), max_new_tokens = 2, pad_token_id = 0
+    )
+    ids = _batch(ref)
+    return {
+        "k_local_equal": torch.equal(k_local, k_full),  # one KV head: every rank holds all rows
+        "generated": tuple(generated.shape),
+        "ref": _train(ref, ids, 3, torch.nn.utils.clip_grad_norm_),
+        "tp": _train(model, ids, 3, tpn.tp_clip_grad_norm_),
+    }
+
+
+CASES = {
+    "parity": _case_parity,
+    "layout": _case_layout,
+    "qlora": _case_qlora,
+    "sharded_load": _case_sharded_load,
+    "env": _case_env,
+}
+
+
+def _worker(rank, world, port, case, tmp, env, kwargs):
+    os.environ.update(
+        MASTER_ADDR = "127.0.0.1",
+        MASTER_PORT = str(port),
+        RANK = str(rank),
+        WORLD_SIZE = str(world),
+        LOCAL_RANK = str(rank),
+        LOCAL_WORLD_SIZE = str(world),
+    )
+    for key in _ENV_KEYS:
+        os.environ.pop(key, None)
+    os.environ.update(env)
+    import datetime
+
+    import torch.distributed as dist
+
+    torch.set_num_threads(2)
+    if case != "env":  # tp_env creates the process group from the environment
+        dist.init_process_group(
+            "gloo", rank = rank, world_size = world, timeout = datetime.timedelta(seconds = 120)
+        )
+    try:
+        res = CASES[case](rank, world, tmp, **kwargs)
+        torch.save(res, os.path.join(tmp, f"result_{rank}.pt"))
+    finally:
+        if dist.is_initialized():
+            dist.destroy_process_group()
+
+
+def _spawn(
+    case,
+    world = 2,
+    env = None,
+    ckpt_overrides = None,
+    **kwargs,
+):
+    ctx = multiprocessing.get_context("spawn")
+    port = _free_port()
+    with tempfile.TemporaryDirectory() as tmp:
+        if ckpt_overrides is not None:
+            kwargs["ckpt"] = _save_checkpoint("llama", os.path.join(tmp, "ckpt"), ckpt_overrides)
+        procs = [
+            ctx.Process(target = _worker, args = (r, world, port, case, tmp, env or {}, kwargs))
+            for r in range(world)
+        ]
+        for p in procs:
+            p.start()
+        for p in procs:
+            p.join(600)
+        codes = [p.exitcode for p in procs]
+        for p in procs:
+            if p.is_alive():
+                p.kill()
+        assert codes == [0] * world, f"rank exit codes {codes}"
+        results = [
+            torch.load(os.path.join(tmp, f"result_{r}.pt"), weights_only = False)
+            for r in range(world)
+        ]
+    if "skip" in results[0]:
+        pytest.skip(f"import unsloth failed on this host: {results[0]['skip']}")
+    return results
+
+
+def test_kv_heads_below_tp_are_replicated_per_rank():
+    # tp 4 over 2 KV heads: ranks 0, 1 compute head 0 and ranks 2, 3 head 1.
+    overrides = {"num_attention_heads": 8, "num_key_value_heads": 2, "intermediate_size": 64}
+    results = _spawn("layout", 4, arch = "qwen3", overrides = overrides)
+    for rank, res in enumerate(results):
+        assert res["kv_replicated"]
+        assert res["styles"]["k_proj"] == res["styles"]["v_proj"] == tpn.KV_REPLICATED
+        assert res["styles"]["q_proj"] == tpn.COLWISE and res["styles"]["o_proj"] == tpn.ROWWISE
+        assert res["heads"] == (2, 1, 2), res["heads"]  # 8 / 4 query heads over 1 local KV head
+        head_dim = 128
+        assert res["rows"] == ((rank // 2) * head_dim, head_dim), res["rows"]
+        assert res["k_placements"] == [True]
+        assert res["saved_groups"] == 4  # tp_replica restores the 1-GPU grouping
+
+
+@pytest.mark.parametrize(
+    "arch,world,overrides",
+    [
+        (
+            "gemma3",
+            2,
+            KV1,
+        ),  # one KV head, trainable q_norm / k_norm (k_norm on the replicated head)
+        ("llama", 2, KV1),
+        ("llama_bias", 2, KV1),  # k / v biases narrowed to the head
+        ("llama", 4, KV1),  # 4 ranks reading one KV head
+        ("qwen3", 4, {"num_attention_heads": 8, "num_key_value_heads": 2, "intermediate_size": 64}),
+    ],
+)
+def test_kv_heads_below_tp_match_one_process(arch, world, overrides):
+    _check_parity(_spawn("parity", world, arch = arch, overrides = overrides), world)
+
+
+def test_kv_heads_below_tp_with_trainable_biases():
+    results = _spawn("parity", 2, arch = "llama_bias", overrides = KV1, lora_kwargs = {"bias": "all"})
+    _check_parity(results, 2)
+    assert any("k_proj.base_layer.bias" in key for key in results[0]["saved_tp"])
+
+
+def test_kv_heads_below_tp_sharded_loading_reads_kv_whole():
+    with tempfile.TemporaryDirectory() as ckpt:
+        _save_checkpoint("llama", ckpt, KV1)
+        results = _spawn("sharded_load", 2, arch = "llama", ckpt = ckpt)
+    _check_parity(results, 2)
+    for res in results:
+        assert res["diffs"] == [], res["diffs"][:6]
+        assert res["tp"][2] == res["v1"][2] and res["tp"][3] == res["v1"][3]
+        stats = res["stats"]
+        assert stats["read_bytes_sliced"] * 2 == stats["sharded_numel"] * 4, stats
+        assert stats["read_bytes_full"] == stats["replicated_numel"] * 4, stats
+
+
+def _bnb_cpu():
+    try:
+        import bitsandbytes  # noqa: F401
+    except Exception:
+        return False
+    return True
+
+
+@pytest.mark.skipif(not _bnb_cpu(), reason = "bitsandbytes not installed")
+def test_kv_heads_below_tp_qlora_matches_one_process():
+    for res in _spawn("qlora", 2):
+        assert res["k_local_equal"] and res["generated"] == (1, 4)
+        ref_logits, ref_grads, ref_losses, ref_norms = res["ref"]
+        logits, grads, losses, norms = res["tp"]
+        torch.testing.assert_close(logits, ref_logits, rtol = 1e-5, atol = 1e-5)
+        assert set(grads) == set(ref_grads) and grads
+        for name in ref_grads:
+            torch.testing.assert_close(grads[name], ref_grads[name], rtol = 1e-4, atol = 1e-6, msg = name)
+        assert losses == pytest.approx(ref_losses, rel = 1e-5, abs = 1e-6)
+        assert norms == pytest.approx(ref_norms, rel = 1e-5)
+
+
+def test_kv_heads_below_tp_env_trainer_matches_one_process():
+    ref = _spawn("env", 1, ckpt_overrides = KV1, bs = 2)[0]
+    assert ref["layout"] is None and not ref["is_tp"]
+    results = _spawn("env", 2, {"UNSLOTH_TP_SIZE": "2"}, ckpt_overrides = KV1, bs = 2)
+    for rank, res in enumerate(results):
+        assert res["layout"] == "tp 2" and res["is_tp"] and res["sharded_load"], res
+        _close(res["a"], ref["a"], what = rank)
+
+
+def test_kv_heads_not_dividing_tp_are_refused():
+    from test_tp_native_oracle import ARCHS
+
+    repo, base = ARCHS["qwen3"]
+    model = build(repo, {**base, "num_attention_heads": 12, "num_key_value_heads": 3})
+    with pytest.raises(ValueError, match = "not a multiple of it"):
+        tpn.derive_tp_plan(model, 4)
diff --git a/tests/test_tp_moe_dropout_gloo.py b/tests/test_tp_moe_dropout_gloo.py
new file mode 100644
index 0000000000..8cf12aa70f
--- /dev/null
+++ b/tests/test_tp_moe_dropout_gloo.py
@@ -0,0 +1,274 @@
+# SPDX-License-Identifier: AGPL-3.0-only
+# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved.
+
+"""Tensor parallel on a gloo CPU world vs one process: mixture-of-experts blocks run replicated (attention and
+dense MLPs still sharded), and dropout draws the masks one process would draw."""
+
+import multiprocessing
+import os
+
+if multiprocessing.parent_process() is not None or getattr(
+    multiprocessing.current_process(), "_inheriting", False
+):
+    os.environ["CUDA_VISIBLE_DEVICES"] = ""  # spawned gloo ranks: CPU only, also on GPU hosts
+
+import sys  # noqa: E402
+import tempfile  # noqa: E402
+
+import pytest  # noqa: E402
+import torch  # noqa: E402
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from test_tp_native_gloo import _free_port, _train  # noqa: E402
+from test_tp_native_oracle import LLAMA, QWEN3_MOE, _batch, build, tpn  # noqa: E402
+
+MOE_OVERRIDES = {"mlp_only_layers": [1]}
+MOE_LORA = dict(target_parameters = ["mlp.experts.gate_up_proj", "mlp.experts.down_proj"])
+
+
+def _seeded_train(model, ids, steps, clip, seed):
+    torch.manual_seed(seed)  # the same RNG state on every rank and in the one-process reference
+    model.train()
+    return _train(model, ids, steps, clip)
+
+
+class _FusedO:
+    """o_proj through Unsloth's fused LoRA_W (apply_lora_o, as llama.py's attention forward calls it): its
+    lora_dropout runs inside the fused Function, on this rank's row shard of the input."""
+
+    def __init__(self, attn):
+        self.attn, self.inner = attn, attn.o_proj.forward
+        self.busy = False
+        attn.o_proj.forward = self
+
+    def __call__(self, X, *args, **kwargs):
+        if self.busy:  # apply_lora_o's own fallback: the projection's forward
+            return self.inner(X, *args, **kwargs)
+        from unsloth.kernels.fast_lora import apply_lora_o
+
+        self.busy = True
+        try:
+            return apply_lora_o(self.attn, X)
+        finally:
+            self.busy = False
+
+
+def _case_parity(
+    rank,
+    world,
+    tmp,
+    repo,
+    overrides,
+    lora_kwargs,
+    dropout_seed = None,
+    reentrant_checkpointing = False,
+    fused_lora_o = False,
+):
+    from safetensors.torch import load_file
+    from torch.distributed.device_mesh import init_device_mesh
+
+    if fused_lora_o:
+        from test_tp_native_gloo import _import_checkout_unsloth
+
+        error = _import_checkout_unsloth()
+        assert error is None, error
+        from unsloth.models import (
+            tp_native as T,
+        )  # one tp_native for the fused kernels and tp_replica
+    else:
+        T = tpn
+    ref = build(repo, overrides, **lora_kwargs)
+    model = build(repo, overrides, **lora_kwargs)
+    for m in (ref, model):
+        if reentrant_checkpointing:
+            # The first forward of a reentrant checkpoint runs under no_grad, the recompute with grad.
+            m.gradient_checkpointing_enable(gradient_checkpointing_kwargs = {"use_reentrant": True})
+            m.enable_input_require_grads()
+    mesh = init_device_mesh("cpu", (world,), mesh_dim_names = ("tp",))
+    T.apply_tensor_parallel(model, mesh["tp"])
+    if fused_lora_o:
+        for m in (ref, model):
+            for layer in T._unwrap(m).model.layers:
+                _FusedO(layer.self_attn)
+    plan = model._unsloth_tp_plan
+    generated = model.generate(
+        input_ids = torch.zeros(1, 2, dtype = torch.long), max_new_tokens = 2, pad_token_id = 0
+    )
+    ids = _batch(ref)
+    if dropout_seed is None:
+        ref_out = _train(ref, ids, 3, torch.nn.utils.clip_grad_norm_)
+        tp_out = _train(model, ids, 3, T.tp_clip_grad_norm_)
+    else:
+        ref_out = _seeded_train(ref, ids, 3, torch.nn.utils.clip_grad_norm_, dropout_seed)
+        tp_out = _seeded_train(model, ids, 3, T.tp_clip_grad_norm_, dropout_seed)
+        other = build(repo, overrides, **lora_kwargs)
+        other_out = _seeded_train(other, ids, 1, torch.nn.utils.clip_grad_norm_, dropout_seed + 1)
+    ref_dir, tp_dir = os.path.join(tmp, f"ref{rank}"), os.path.join(tmp, "tp")
+    ref.save_pretrained(ref_dir)
+    T.save_tp_adapter(model, tp_dir)
+    return {
+        "ref": ref_out,
+        "tp": tp_out,
+        "other_loss": None if dropout_seed is None else other_out[2][0],
+        "regions": [(r.path, r.kind) for r in plan.regions],
+        "replicated_moe": plan.replicated_moe,
+        "moe_synced": all(b.__dict__.get("_unsloth_tp_size") == world for b in plan.moe_blocks),
+        "generated": tuple(generated.shape),
+        "saved_ref": load_file(os.path.join(ref_dir, "adapter_model.safetensors")),
+        "saved_tp": load_file(os.path.join(tp_dir, "adapter_model.safetensors"))
+        if rank == 0
+        else None,
+    }
+
+
+def _case_mean_half(rank, world, tmp, dtype):
+    import torch.distributed as dist
+
+    out = {}
+    for value in (40000.0, 3.0):
+        x = torch.full((4,), value, dtype = getattr(torch, dtype))
+        out[value] = tpn._MeanFromTP.apply(x, dist.group.WORLD, world)
+    return out
+
+
+CASES = {"parity": _case_parity, "mean_half": _case_mean_half}
+
+
+def _worker(rank, world, port, case, tmp, kwargs):
+    os.environ.update(
+        MASTER_ADDR = "127.0.0.1",
+        MASTER_PORT = str(port),
+        RANK = str(rank),
+        WORLD_SIZE = str(world),
+        LOCAL_RANK = str(rank),
+        LOCAL_WORLD_SIZE = str(world),
+    )
+    import datetime
+
+    import torch.distributed as dist
+
+    torch.set_num_threads(2)
+    dist.init_process_group(
+        "gloo", rank = rank, world_size = world, timeout = datetime.timedelta(seconds = 120)
+    )
+    try:
+        res = CASES[case](rank, world, tmp, **kwargs)
+        torch.save(res, os.path.join(tmp, f"result_{rank}.pt"))
+    finally:
+        dist.destroy_process_group()
+
+
+def _spawn(
+    case,
+    world = 2,
+    **kwargs,
+):
+    ctx = multiprocessing.get_context("spawn")
+    port = _free_port()
+    with tempfile.TemporaryDirectory() as tmp:
+        procs = [
+            ctx.Process(target = _worker, args = (r, world, port, case, tmp, kwargs))
+            for r in range(world)
+        ]
+        for p in procs:
+            p.start()
+        for p in procs:
+            p.join(600)
+        codes = [p.exitcode for p in procs]
+        assert codes == [0] * world, f"rank exit codes {codes}"
+        return [
+            torch.load(os.path.join(tmp, f"result_{r}.pt"), weights_only = False)
+            for r in range(world)
+        ]
+
+
+def _check(results):
+    for rank, res in enumerate(results):
+        ref_logits, ref_grads, ref_losses, ref_norms = res["ref"]
+        logits, grads, losses, norms = res["tp"]
+        torch.testing.assert_close(logits, ref_logits, rtol = 1e-5, atol = 1e-5)
+        assert set(grads) == set(ref_grads), sorted(set(grads) ^ set(ref_grads))[:6]
+        for name in ref_grads:
+            torch.testing.assert_close(grads[name], ref_grads[name], rtol = 1e-4, atol = 1e-6, msg = name)
+        assert losses == pytest.approx(ref_losses, rel = 1e-5, abs = 1e-6), (rank, losses, ref_losses)
+        assert norms == pytest.approx(ref_norms, rel = 1e-5), (rank, norms, ref_norms)
+        assert res["generated"] == (1, 4)
+    saved_tp, saved_ref = results[0]["saved_tp"], results[0]["saved_ref"]
+    assert set(saved_tp) == set(saved_ref)
+    for key in saved_ref:
+        # 3 AdamW steps (eps 1e-8) turn fp32 reduction-order noise on tiny expert grads into ~5e-5 here; a
+        # missed or doubled reduction moves weights by ~lr = 1e-2.
+        torch.testing.assert_close(saved_tp[key], saved_ref[key], rtol = 1e-3, atol = 2e-4, msg = key)
+    return results[0]
+
+
+@pytest.mark.parametrize("dtype", ["float16", "bfloat16"])
+def test_tp2_replicated_mean_does_not_overflow_half(dtype):
+    # 40000 is finite in fp16 but two replicas summed in fp16 are inf: the mean must not overflow.
+    for res in _spawn("mean_half", 2, dtype = dtype):
+        for value, y in res.items():
+            assert y.dtype == getattr(torch, dtype)
+            assert torch.equal(y, torch.full_like(y, value)), (value, y)
+
+
+def test_tp2_moe_runs_replicated_and_matches_one_process():
+    res = _check(_spawn("parity", 2, repo = QWEN3_MOE, overrides = MOE_OVERRIDES, lora_kwargs = MOE_LORA))
+    assert res["replicated_moe"] == 1 and res["moe_synced"]
+    assert sorted(k for _, k in res["regions"]) == ["attention", "attention", "mlp"], res["regions"]
+    assert any("experts" in k for k in res["saved_tp"]), sorted(res["saved_tp"])[:8]
+
+
+@pytest.mark.parametrize(
+    "overrides,lora_kwargs",
+    [
+        ({}, {"lora_dropout": 0.25}),  # lora_dropout: column input replicated, row input sharded
+        (
+            {"attention_dropout": 0.25},
+            {"lora_dropout": 0.25},
+        ),  # + eager attention probabilities, per head
+    ],
+    ids = ["lora_dropout", "attention_and_lora_dropout"],
+)
+def test_tp2_dropout_draws_one_process_masks(overrides, lora_kwargs):
+    results = _spawn(
+        "parity", 2, repo = LLAMA, overrides = overrides, lora_kwargs = lora_kwargs, dropout_seed = 1234
+    )
+    res = _check(results)
+    assert res["other_loss"] != pytest.approx(res["ref"][2][0], rel = 1e-6), (
+        res["other_loss"],
+        res["ref"][2],
+    )
+
+
+def test_tp2_attention_dropout_in_a_fused_kernel_is_refused():
+    model = build(LLAMA, {"attention_dropout": 0.25})
+    tpn._text_config(model)._attn_implementation = "sdpa"
+    with pytest.raises(ValueError, match = "eager attention only"):
+        tpn.derive_tp_plan(model, 2)
+
