+    monkeypatch.setattr(cb, "_card_name", lambda latent: "Tesla T4")
+    monkeypatch.setenv(cb.CFG_BATCH_ENV, "force")
+    forced = _offloaded(Krea2Transformer2DModel())
+    fpipe = _Pipe(forced)
