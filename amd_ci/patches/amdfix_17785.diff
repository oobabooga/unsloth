+# RssAnon and the fd table are read from /proc: Linux only. Elsewhere they are None and their checks are skipped.
+_PROC = os.path.isfile("/proc/self/status")
+
+
+def torch_linear_attention(setter = setattr):
+    """Keep the CPU ranks on transformers' torch Gated DeltaNet: it picks FLA / causal-conv1d by import, not by
+    device, and their Triton kernels reject CPU tensors on GPU hosts."""
+    try:
+        import transformers.models.qwen4_exp.modeling_qwen4_exp as module
+    except ImportError:
+        return
+    for fn in (
+        "torch_chunk_gated_delta_rule",
+        "torch_recurrent_gated_delta_rule",
+        "causal_conv1d_fn",
+        "causal_conv1d_update",
+    ):
+        if callable(getattr(module, fn, None)):
+            setter(module, fn, inspect.unwrap(getattr(module, fn)))
+
+
 def _rss_anon_kb():
+    if not _PROC:
+        return None
     with open("/proc/self/status") as f:
         for line in f:
             if line.startswith("RssAnon:"):
