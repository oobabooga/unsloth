+def _routes(calls):
+    return [R.route_for(x, w, (1, 1), (w[2] // 2,) * 2, (1, 1), "bfloat16") for x, w, _b in calls]
+
+
+def test_klein_1024_decode_routes_every_measured_winner_and_keeps_the_two_losers_on_miopen():
+    calls = _klein_calls()
+    routes = _routes(calls)
+    assert len(calls) == 36 and sum(r is not None for r in routes) == 34
+    stays = {(x, w) for (x, w, _b), r in zip(calls, routes) if r is None}
+    assert stays == {
+        ((1, 32, 128, 128), (32, 32, 1, 1)),  # post_quant_conv: 0.81x
+        ((1, 32, 128, 128), (512, 32, 3, 3)),  # conv_in: 0.71x
+    }
+    variants = {
+        R.variant_key(r, x, w, "bfloat16", b, True) for (x, w, b), r in zip(calls, routes) if r
+    }
+    assert len(variants) == 11
