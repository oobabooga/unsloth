+class AutoencoderKLFlux2(torch.nn.Module):
+    """Same class name as the FLUX.2 VAE: one routable 3x3, one routable 1x1, and the two losing klein shapes."""
+
+    def __init__(self, dtype = torch.bfloat16):
+        super().__init__()
