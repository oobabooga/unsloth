+def test_route_table_rejects_unmeasured_calls():
+    ok = ((1, 128, 1024, 1024), (128, 128, 3, 3))
+    assert R.route_for(*ok, (1, 1), (1, 1), (1, 1), "bfloat16") == "3x3"
+    assert (
+        R.route_for((1, 256, 1024, 1024), (128, 256, 1, 1), (1, 1), (0, 0), (1, 1), "bfloat16")
+        == "1x1"
+    )
+    assert R.route_for(*ok, (1, 1), (1, 1), (1, 1), "float16") is None  # fp16 unmeasured
+    assert (
+        R.route_for((2, 128, 1024, 1024), ok[1], (1, 1), (1, 1), (1, 1), "bfloat16") is None
+    )  # batch 2
+    assert R.route_for(*ok, (2, 2), (1, 1), (1, 1), "bfloat16") is None
+    assert R.route_for(*ok, (1, 1), (0, 0), (1, 1), "bfloat16") is None
+    assert R.route_for(*ok, (1, 1), (1, 1), (2, 2), "bfloat16") is None
+    assert (
+        R.route_for((1, 128, 64, 64), ok[1], (1, 1), (1, 1), (1, 1), "bfloat16") is None
+    )  # plane below bucket
+    assert (
+        R.route_for((1, 128, 2048, 2048), ok[1], (1, 1), (1, 1), (1, 1), "bfloat16") is None
+    )  # above
+    assert (
+        R.route_for((1, 144, 1024, 1024), (4, 144, 3, 3), (1, 1), (1, 1), (1, 1), "bfloat16")
+        is None
+    )
