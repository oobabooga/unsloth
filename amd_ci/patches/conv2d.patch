+
+        def conv(cin, cout, k):
+            m = torch.nn.Conv2d(cin, cout, k, padding = k // 2).to(dtype)
+            with torch.no_grad():
+                m.weight.copy_(torch.randn(m.weight.shape, generator = g) * 0.05)
+            return m
+
+        self.conv3 = conv(128, 128, 3)
+        self.conv1 = conv(256, 128, 1)
+        self.conv_in = conv(32, 512, 3)
+        self.post_quant_conv = conv(32, 32, 1)
