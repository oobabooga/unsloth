+for route, N, c, H, W, K, bias in [
+    ("1x1", 1, 64, 6, 7, 48, True),
+    ("1x1", 1, 96, 5, 5, 40, False),
+    ("3x3", 1, 64, 6, 6, 64, True),
+    ("3x3", 1, 80, 5, 9, 24, True),
+    ("3x3", 1, 128, 7, 4, 3, False),
+]:
+    x = torch.randn(N, c, H, W, dtype = torch.float16)
+    w = (torch.randn(K, c, 3 if route == "3x3" else 1, 3 if route == "3x3" else 1) * 0.05).half()
+    b = torch.randn(K).half() if bias else None
+    if route == "1x1":
+        y = C.conv2d_1x1(x, w, b)
+        ref = F.conv2d(x.float(), w.float(), b.float() if bias else None)
