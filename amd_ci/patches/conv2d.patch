+"""Entry points ``conv2d_1x1`` and ``conv2d_3x3_cblocked``: forward-only drop-ins for ``F.conv2d`` on contiguous NCHW
+fp16 / bf16 operands (groups 1, zeros padding). The 3x3 route packs the input to NCHWc (64-channel blocks) and the
+weight to ``[K_out, 9, C_pad]`` (cached per weight) before the direct kernel."""
+
+import weakref
+from collections import OrderedDict
+
+import torch
+import triton
+
+from .conv_1x1 import _conv2d_1x1_kernel
+from .conv_1x1 import _get_config as _get_config_1x1
+from .conv_3x3_cblocked import _conv2d_3x3_cblocked_kernel, _get_config_cblocked
+from .ncx_to_cblocked import _get_config as _get_config_prepack
+from .ncx_to_cblocked import _ncx_to_cblocked_kernel
+from ._config import format_prepack_shape_key, format_shape_key
+
+# Channel-block and padding granularity for prepacked inputs and weights (the tables were tuned with it).
+BLOCK_K = 64
+
+
+def out_hw(H, W, R, S, stride, padding, dilation):
+    sh, sw = stride
+    ph, pw = padding
+    dh, dw = dilation
+    P = (H + 2 * ph - dh * (R - 1) - 1) // sh + 1
+    Q = (W + 2 * pw - dw * (S - 1) - 1) // sw + 1
+    return P, Q
+
+
+def _round_up_to_block(size: int, block: int) -> int:
+    return ((size + block - 1) // block) * block
+
+
+def _make_mn_grid(M_total, K_out):
+    def grid(meta):
+        return (triton.cdiv(M_total, meta["BLOCK_M"]) * triton.cdiv(K_out, meta["BLOCK_N"]),)
+
+    return grid
+
+
+def _prep_bias(bias):
+    """Unit-stride bias; the epilogues promote fp16 / bf16 bias to fp32 while loading."""
+    if bias is None:
+        return None
+    return bias if bias.stride(0) == 1 else bias.contiguous()
+
+
+def config_1x1(N, C, H, W, K_out, stride, padding):
+    P, Q = out_hw(H, W, 1, 1, stride, padding, (1, 1))
+    shape_key = format_shape_key(
+        N = N, C = C, H = H, W = W, K = K_out, R = 1, S = 1,
+        sh = stride[0], sw = stride[1], ph = padding[0], pw = padding[1], dh = 1, dw = 1,
+    )  # fmt: skip
+    return _get_config_1x1(shape_key = shape_key, M = N * P * Q, variants = ("nchw",))
+
+
+def config_3x3(N, C, H, W, K_out, stride, padding, dilation):
+    P, Q = out_hw(H, W, 3, 3, stride, padding, dilation)
+    shape_key = format_shape_key(
+        N = N, C = C, H = H, W = W, K = K_out, R = 3, S = 3,
+        sh = stride[0], sw = stride[1], ph = padding[0], pw = padding[1], dh = dilation[0], dw = dilation[1],
+    )  # fmt: skip
+    return _get_config_cblocked(shape_key = shape_key, M = N * P * Q)
+
+
+def config_prepack(
+    N,
+    C,
+    H,
+    W,
+    block_c = BLOCK_K,
+):
+    return _get_config_prepack(shape_key = format_prepack_shape_key(N, C, H, W, block_c), M = H * W)
+
+
+# Weight packs: a bounded LRU holding only a weak reference to the source weight, so a pack goes with its module.
+_PACK_CACHE_MAXSIZE = 256
+
+
+class _LRUPackCache:
+    def __init__(self, maxsize: int = _PACK_CACHE_MAXSIZE):
+        self._d: OrderedDict = OrderedDict()
+        self._by_src: dict = {}
+        self._max = max(1, maxsize)
+
+    def get(self, key):
+        entry = self._d.get(key)
+        if entry is None:
+            return None
+        if entry[0]() is None:
+            self._d.pop(key, None)
+            return None
+        self._d.move_to_end(key)
+        return entry
+
+    def put(self, key, src, item):
+        # One live pack per source tensor: a weight moved (offload) or edited in place replaces its old pack.
+        old = self._by_src.get(id(src))
+        if old is not None and old != key:
+            self._d.pop(old, None)
+        self._by_src[id(src)] = key
+        self._d[key] = (weakref.ref(src), item)
+        self._d.move_to_end(key)
+        weakref.finalize(src, self._drop, id(src), key)
+        while len(self._d) > self._max:
+            self._d.popitem(last = False)
+
+    def _drop(self, src_id, key):
+        self._d.pop(key, None)
+        if self._by_src.get(src_id) == key:
+            self._by_src.pop(src_id, None)
+
+    def clear(self):
+        self._d.clear()
+        self._by_src.clear()
+
+    def __len__(self):
+        return len(self._d)
+
+    def nbytes(self) -> int:
+        return sum(item[0].numel() * item[0].element_size() for _ref, item in self._d.values())
+
+
+_PACK_CACHE_3x3 = _LRUPackCache()
+
+
+def clear_conv2d_weight_pack_caches() -> None:
+    _PACK_CACHE_3x3.clear()
+
+
+def conv2d_weight_pack_cache_bytes() -> int:
+    return _PACK_CACHE_3x3.nbytes()
+
+
+def _pack_cache_key(w: torch.Tensor, block: int) -> tuple:
+    """Identity for a packed weight, including aliases and in-place updates."""
+    return (
+        w.data_ptr(),
+        w.device.type,
+        w.device.index,
+        tuple(w.shape),
+        tuple(w.stride()),
+        w.dtype,
+        w._version,
+        block,
+    )
+
+
+def prepack_oihw_to_3x3(w_oihw: torch.Tensor, block_c: int = BLOCK_K):
+    """Pack weights as [K_out, 9, C_pad] for the 3x3 kernel."""
+    K_out, C, R, S = w_oihw.shape
+    assert R == 3 and S == 3
+    C_pad = _round_up_to_block(C, block_c)
+    packed = w_oihw.reshape(K_out, C, 9).permute(0, 2, 1).contiguous()
+    if C_pad != C:
+        packed = torch.cat((packed, packed.new_zeros((K_out, 9, C_pad - C))), dim = -1).contiguous()
+    return packed, C_pad
+
+
+def get_or_make_weight_pack_3x3(w_oihw: torch.Tensor, block_c: int = BLOCK_K):
+    if w_oihw.is_inference():
+        return prepack_oihw_to_3x3(w_oihw, block_c)
+    key = _pack_cache_key(w_oihw, block_c)
+    cached = _PACK_CACHE_3x3.get(key)
+    if cached is not None:
+        return cached[1]
+    packed = prepack_oihw_to_3x3(w_oihw, block_c)
+    _PACK_CACHE_3x3.put(key, w_oihw, packed)
+    return packed
+
+
+def prepack_nchw_to_cblocked(x: torch.Tensor, block_c: int = BLOCK_K):
+    """Materialize contiguous NCHW as [N, C_blocks, H, W, Cb] in one Triton pass."""
+    N, C, H, W = x.shape
+    C_blocks = (C + block_c - 1) // block_c
+    C_pad = _round_up_to_block(C, block_c)
+    x_blocked = torch.empty((N, C_blocks, H, W, block_c), device = x.device, dtype = x.dtype)
+    HW = H * W
+    config = config_prepack(N, C, H, W, block_c)
+
+    def grid(meta):
+        return (triton.cdiv(HW, meta["BLOCK_M"]), triton.cdiv(C_pad, meta["BLOCK_C"]), N)
+
+    _ncx_to_cblocked_kernel[grid](x, x_blocked, C, HW, C_PAD = C_pad, CB = block_c, **config)
+    return x_blocked, C_pad
+
+
+def _check(x, w, bias, R):
+    if x.dtype not in (torch.float16, torch.bfloat16) or w.dtype != x.dtype:
+        raise ValueError(
+            f"conv2d needs fp16 / bf16 operands of one dtype, got {x.dtype} / {w.dtype}"
+        )
+    if not x.is_cuda or w.device != x.device or (bias is not None and bias.device != x.device):
+        raise ValueError("conv2d input, weight and bias must be on one CUDA / ROCm device")
+    if x.dim() != 4 or w.dim() != 4 or w.shape[1] != x.shape[1] or tuple(w.shape[2:]) != (R, R):
+        raise ValueError(f"conv2d shape mismatch: x={tuple(x.shape)} w={tuple(w.shape)}")
+
+
+def conv2d_1x1(
+    x,
+    w_oihw,
+    bias = None,
+    stride = (1, 1),
+    padding = (0, 0),
+):
+    """NCHW 1x1 conv2d (dilation is irrelevant for a 1x1 kernel)."""
+    _check(x, w_oihw, bias, 1)
+    x = x.contiguous()
+    N, C, H, W_in = x.shape
+    K_out = w_oihw.shape[0]
+    sh, sw = stride
+    ph, pw = padding
+    P, Q = out_hw(H, W_in, 1, 1, stride, padding, (1, 1))
+    M_total = N * P * Q
+    with torch.cuda.device(x.device):
+        y = torch.empty((N, K_out, P, Q), device = x.device, dtype = x.dtype)
+        bias = _prep_bias(bias)
+        w = w_oihw.reshape(K_out, C).contiguous()
+        config = config_1x1(N, C, H, W_in, K_out, stride, padding)
+        _conv2d_1x1_kernel[_make_mn_grid(M_total, K_out)](
+            x, w, bias, y, N, C, H, W_in, K_out, P, Q, sh, sw, ph, pw, M_total,
+            HAS_BIAS = bias is not None, ACTIVATION = "none", LAYOUT = "nchw", **config,
+        )  # fmt: skip
+    return y
+
+
+def conv2d_3x3_cblocked(
+    x,
+    w_oihw,
+    bias = None,
+    stride = (1, 1),
+    padding = (1, 1),
+    dilation = (1, 1),
+):
+    """NCHW 3x3 conv2d through the NCHWc input pack and the channel-blocked direct kernel."""
+    _check(x, w_oihw, bias, 3)
+    x = x.contiguous()
+    N, C, H, W_in = x.shape
+    K_out = w_oihw.shape[0]
+    sh, sw = stride
+    ph, pw = padding
+    dh, dw = dilation
+    P, Q = out_hw(H, W_in, 3, 3, stride, padding, dilation)
+    M_total = N * P * Q
+    with torch.cuda.device(x.device):
+        y = torch.empty((N, K_out, P, Q), device = x.device, dtype = x.dtype)
+        bias = _prep_bias(bias)
+        w_3x3, C_pad = get_or_make_weight_pack_3x3(w_oihw, BLOCK_K)
+        x_blocked, _ = prepack_nchw_to_cblocked(x, BLOCK_K)
+        config = config_3x3(N, C, H, W_in, K_out, stride, padding, dilation)
+        _conv2d_3x3_cblocked_kernel[_make_mn_grid(M_total, K_out)](
+            x_blocked, w_3x3, bias, y, N, C, H, W_in, K_out, P, Q, C_pad, BLOCK_K,
+            sh, sw, ph, pw, dh, dw, M_total,
+            HAS_BIAS = bias is not None, ACTIVATION = "none", **config,
+        )  # fmt: skip
+    return y
