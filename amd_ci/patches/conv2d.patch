diff --git a/studio/backend/core/inference/diffusion_rocm_triton_conv2d.py b/studio/backend/core/inference/diffusion_rocm_triton_conv2d.py
new file mode 100644
index 0000000000..3625c86197
--- /dev/null
+++ b/studio/backend/core/inference/diffusion_rocm_triton_conv2d.py
@@ -0,0 +1,809 @@
+# SPDX-License-Identifier: AGPL-3.0-only
+# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved. See /studio/LICENSE.AGPL-3.0
+
+"""ROCm gfx1151: route the FLUX.2 / FLUX.3 VAE decoder's measured-winning ``nn.Conv2d`` shapes through the Triton
+conv2d vendored from ROCm/aiter (``rocm_triton_conv2d``) instead of MIOpen.
+
+gfx1151 Linux, klein VAE decode at 1024^2 (bf16, real weights): 1.025 -> 0.608 s, 60.0 dB vs MIOpen; per-conv error vs
+fp32 is 0.66-0.71x MIOpen's. The win is per shape: 3x3 convs with >= 128 input channels on planes of 128^2 and up win
+(1.23-1.89x), as do the two large-plane 1x1 shortcuts (1.18x / 1.19x); the 32-channel ``conv_in`` (0.71x) and
+``post_quant_conv`` (0.81x) lose, so only ``SHAPE_TABLE`` entries route and every other call stays on MIOpen.
+``Conv2d._conv_forward`` is wrapped per instance; OOM / torch._dynamo errors are re-raised, a shape that failed once
+is not retried.
+
+``UNSLOTH_DIFFUSION_ROCM_TRITON_CONV2D``: ``0`` off (MIOpen, byte-identical), ``1`` on for any gfx11 arch, OS and 2D
+VAE class (still only table shapes), unset = ``DEFAULT_ON_ARCHES`` x ``DEFAULT_ON_VAES`` x ``DEFAULT_ON_PLATFORMS``
+(Windows is off until measured there). Image loads with an explicit speed mode ``off`` never install it.
+
+The kernels take H / W / channels as ``tl.constexpr`` (upstream design), so every (layer, plane) is its own compiled
+variant (about 0.6 s each). No decode compiles inline: a call whose variant is not listed in the manifest beside the
+Triton cache stays on MIOpen (``fallback_cold``). ``prebuild`` (from the image load) traces the decoder on the meta
+device at the default 1024^2 latent and compiles those variants in a child process on zeros; a variant first seen
+during a decode (another resolution) is built by a child after the decode goes quiet.
+``UNSLOTH_DIFFUSION_ROCM_TRITON_CONV2D_PREBUILD=0`` (or ``UNSLOTH_DIFFUSION_VAE_PREBUILD=0``) compiles inline instead.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import threading
+import time
+from typing import Any, Optional
+
+from . import diffusion_rocm_triton_conv3d as _c3
+
+ENABLE_ENV = "UNSLOTH_DIFFUSION_ROCM_TRITON_CONV2D"
+SELFCHECK_ENV = "UNSLOTH_DIFFUSION_ROCM_TRITON_CONV2D_SELFCHECK"
+PREBUILD_ENV = "UNSLOTH_DIFFUSION_ROCM_TRITON_CONV2D_PREBUILD"
+# Same bound as the conv3d router: bf16 output rounding alone is ~1e-3 rel L2; a broken tile or mask is O(1).
+SELFCHECK_REL_L2 = 1e-2
+DEFAULT_ON_ARCHES: tuple = ("gfx1151",)
+DEFAULT_ON_VAES: tuple = ("AutoencoderKLFlux2",)
+# Windows (triton-windows) is unmeasured: off unless the env forces it on.
+DEFAULT_ON_PLATFORMS: tuple = ("linux",)
+# Measured routes (gfx1151, bf16, N = 1, stride 1, padding k // 2, dilation 1, contiguous NCHW):
+# (C_in, C_out, kernel) -> (min, max) output plane pixels. max = the largest plane measured for that layer, min = a
+# quarter of the smallest (floored at 128^2, below which 3x3 / 1x1 wins were not shown).
+SHAPE_TABLE: dict = {
+    (512, 512, 3): (16384, 262144),  # 1.38x at 128^2, 1.39x at 256^2, 1.30x at 512^2
+    (512, 256, 3): (65536, 262144),  # 1.48x at 512^2
+    (256, 256, 3): (65536, 1048576),  # 1.51x at 512^2, 1.44x at 1024^2
+    (256, 128, 3): (262144, 1048576),  # 1.44x at 1024^2
+    (128, 128, 3): (262144, 1048576),  # 1.89x at 1024^2
+    (128, 3, 3): (262144, 1048576),  # 1.23x at 1024^2
+    (512, 256, 1): (65536, 262144),  # 1.19x at 512^2
+    (256, 128, 1): (262144, 1048576),  # 1.18x at 1024^2
+}
+ROUTE_DTYPES: tuple = ("bfloat16",)
+# Decoder latent side the load prebuilds for: Studio's default 1024^2 output.
+PREBUILD_OUTPUT_SIDE = 1024
+MEM_MARGIN_BYTES = 512 << 20
+MEM_MARGIN_FRACTION = 0.03
+MEM_CHECK_MIN_BYTES = 64 << 20
+_INT32_MAX = 2**31 - 1
+_BLOCK = 64
+
+COUNTS = {
+    "routed": 0,
+    "skipped_table": 0,
+    "fallback_layout": 0,
+    "fallback_memory": 0,
+    "fallback_cold": 0,
+    "fallback_error": 0,
+}
+_TRUE = ("1", "true", "yes", "on")
+_FALSE = ("0", "false", "no", "off")
+_LOCK = threading.Lock()
+_STATE: dict = {}
+_FAILED: set = set()
+_DEVICE_OK: dict = {}
+_READY: set = set()
+_PENDING: dict = {}
+_ATTEMPTS: dict = {}
+_PB: dict = {}
+_PB_LOCK = threading.RLock()
+KICK_DEBOUNCE_S = 3.0
+MANIFEST_POLL_S = 1.0
+MAX_ATTEMPTS = 2
+# The child's HIP context plus the largest 1024^2 operand set (a 256-channel 1024^2 input, its NCHWc pack, output).
+PREBUILD_MIN_FREE = 3 << 30
+PREBUILD_TIMEOUT_S = 900.0
+
+
+def reset_counts() -> None:
+    for k in COUNTS:
+        COUNTS[k] = 0
+
+
+def counts() -> dict:
+    return dict(COUNTS)
+
+
+def _env_mode() -> Optional[bool]:
+    raw = (os.environ.get(ENABLE_ENV) or "").strip().lower()
+    if raw in _TRUE:
+        return True
+    if raw in _FALSE:
+        return False
+    return None
+
+
+def arch_enabled(arch: str) -> bool:
+    arch = (arch or "").split(":")[0].strip().lower()
+    if not arch.startswith("gfx11"):
+        return False
+    mode = _env_mode()
+    if mode is None:
+        return arch in DEFAULT_ON_ARCHES and sys.platform in DEFAULT_ON_PLATFORMS
+    return mode
+
+
+def requested() -> bool:
+    mode = _env_mode()
+    if mode is None:
+        return bool(DEFAULT_ON_ARCHES) and sys.platform in DEFAULT_ON_PLATFORMS
+    return mode
+
+
+def route_for(x_shape, w_shape, stride, padding, dilation, dtype_name: str) -> Optional[str]:
+    """``"1x1"`` / ``"3x3"`` when the call is a measured-winning shape, else None (MIOpen)."""
+    if dtype_name not in ROUTE_DTYPES or len(x_shape) != 4 or len(w_shape) != 4:
+        return None
+    N, C, H, W = (int(v) for v in x_shape)
+    K, Cw, R, S = (int(v) for v in w_shape)
+    if N != 1 or Cw != C or R != S or R not in (1, 3):
+        return None
+    if tuple(stride) != (1, 1) or tuple(dilation) != (1, 1) or tuple(padding) != (R // 2, R // 2):
+        return None
+    bucket = SHAPE_TABLE.get((C, K, R))
+    if bucket is None or not (bucket[0] <= H * W <= bucket[1]):
+        return None
+    return "1x1" if R == 1 else "3x3"
+
+
+def plan_bytes(route: str, x_shape, w_shape, elt: int) -> tuple:
+    """(extra bytes beyond MIOpen's output, largest element count a kernel indexes)."""
+    N, C, H, W = x_shape
+    K = w_shape[0]
+    y = N * K * H * W
+    x = N * C * H * W
+    extra = y * elt
+    biggest = max(x, y)
+    if route == "3x3":
+        c_pad = -(-C // _BLOCK) * _BLOCK
+        blocked = N * c_pad * H * W
+        extra += blocked * elt + K * 9 * c_pad * elt
+        biggest = max(biggest, blocked)
+    return extra, biggest
+
+
+def _on_gpu(t: Any) -> bool:
+    return bool(t.is_cuda)
+
+
+def _device_ok(torch: Any, index: Optional[int]) -> bool:
+    key = index if index is not None else -1
+    ok = _DEVICE_OK.get(key)
+    if ok is None:
+        from .rocm_bf16 import is_rocm_torch
+        ok = bool(is_rocm_torch(torch)) and arch_enabled(_c3._device_arch(torch, index))
+        _DEVICE_OK[key] = ok
+    return ok
+
+
+def _kernels() -> Optional[Any]:
+    with _LOCK:
+        if "mod" in _STATE:
+            return _STATE["mod"]
+        mod = None
+        if not _c3._triton_ok():
+            _STATE["import_error"] = f"Triton older than {_c3.MIN_TRITON} or missing"
+        else:
+            try:
+                from .rocm_triton_conv2d import conv2d as mod
+            except Exception as exc:  # noqa: BLE001 - no Triton: MIOpen stays
+                mod = None
+                _STATE["import_error"] = repr(exc)[:300]
+        _STATE["mod"] = mod
+        return mod
+
+
+def _run(mod: Any, route: str, x, w, b) -> Any:
+    if route == "1x1":
+        return mod.conv2d_1x1(x, w, b, (1, 1), (0, 0))
+    return mod.conv2d_3x3_cblocked(x, w, b, (1, 1), (1, 1), (1, 1))
+
+
+# Self-check cases: 1x1, 3x3 with C a multiple of the 64-channel block, 3x3 with a padded last block.
+_SELFCHECK_CASES = (
+    ("1x1", (1, 64, 6, 7), (48, 64, 1, 1)),
+    ("3x3", (1, 64, 6, 6), (64, 64, 3, 3)),
+    ("3x3", (1, 80, 5, 9), (24, 80, 3, 3)),
+)
+
+
+def _selfcheck(torch: Any, mod: Any, device: Any, dtype: Any) -> bool:
+    key = ("selfcheck", str(device), str(dtype))
+    if key in _STATE:
+        return _STATE[key]
+    ok = True
+    if (os.environ.get(SELFCHECK_ENV) or "").strip().lower() not in _FALSE:
+        import torch.nn.functional as F
+        gen = torch.Generator(device = "cpu").manual_seed(0)
+        try:
+            with torch.no_grad():
+                for route, xs, ws in _SELFCHECK_CASES:
+                    x = torch.randn(xs, generator = gen).to(device = device, dtype = dtype)
+                    w = (torch.randn(ws, generator = gen) * 0.05).to(device = device, dtype = dtype)
+                    b = torch.randn(ws[0], generator = gen).to(device = device, dtype = dtype)
+                    y = _run(mod, route, x, w, b)
+                    ref = F.conv2d(x.float(), w.float(), b.float(), padding = ws[2] // 2)
+                    rel = float((y.float() - ref).norm() / ref.norm())
+                    if not (y.shape == ref.shape and rel < SELFCHECK_REL_L2):
+                        ok = False
+                        _STATE["selfcheck_error"] = f"{xs}x{ws}: rel L2 {rel:.3g}"
+                        break
+        except torch.OutOfMemoryError:
+            raise
+        except Exception as exc:  # noqa: BLE001 - no Triton HIP backend, compile failure, ...
+            ok = False
+            _STATE["selfcheck_error"] = repr(exc)[:300]
+    _STATE[key] = ok
+    return ok
+
+
+def _make_conv_forward(module: Any, original: Any, logger: Any):
+    import torch
+
+    def _conv_forward(input, weight, bias):
+        if (
+            torch.compiler.is_compiling()
+            or not _on_gpu(input)
+            or _c3._capturing(torch)
+            or input.dim() != 4
+            or input.dtype != torch.bfloat16
+            or weight.dtype != input.dtype
+            or (bias is not None and bias.dtype != input.dtype)
+            or module.groups != 1
+            or module.padding_mode != "zeros"
+            or not isinstance(module.padding, tuple)
+            or (torch.is_grad_enabled() and (input.requires_grad or weight.requires_grad))
+            or not _device_ok(torch, input.device.index)
+        ):
+            return original(input, weight, bias)
+        x_shape, w_shape = tuple(input.shape), tuple(weight.shape)
+        route = route_for(
+            x_shape,
+            w_shape,
+            module.stride,
+            module.padding,
+            module.dilation,
+            str(input.dtype).replace("torch.", ""),
+        )
+        if route is None:
+            COUNTS["skipped_table"] += 1
+            return original(input, weight, bias)
+        if not input.is_contiguous() or not weight.is_contiguous():
+            COUNTS["fallback_layout"] += 1  # channels_last was not measured
+            return original(input, weight, bias)
+        mod = _kernels()
+        if mod is None:
+            return original(input, weight, bias)
+        gated = _gated()
+        if gated and not _selfcheck_ready(input):
+            COUNTS["fallback_cold"] += 1
+            return original(input, weight, bias)
+        if not _selfcheck(torch, mod, input.device, input.dtype):
+            return original(input, weight, bias)
+        key = (x_shape, w_shape, input.dtype, input.device.index)
+        if key in _FAILED:
+            COUNTS["fallback_error"] += 1
+            return original(input, weight, bias)
+        extra, biggest = plan_bytes(route, x_shape, w_shape, input.element_size())
+        if biggest > _INT32_MAX:
+            COUNTS["skipped_table"] += 1
+            return original(input, weight, bias)
+        if extra >= MEM_CHECK_MIN_BYTES:
+            free, total = _c3._free_bytes(torch, input.device)
+            if extra + max(MEM_MARGIN_BYTES, int(total * MEM_MARGIN_FRACTION)) > free:
+                COUNTS["fallback_memory"] += 1
+                return original(input, weight, bias)
+        if gated and not _variant_ready(route, input, weight, bias):
+            COUNTS["fallback_cold"] += 1
+            return original(input, weight, bias)
+        try:
+            y = _run(mod, route, input, weight, bias)
+        except Exception as exc:  # noqa: BLE001 - MIOpen for this shape from now on
+            if _c3._reraise(torch, exc):
+                raise
+            _FAILED.add(key)
+            COUNTS["fallback_error"] += 1
+            if logger is not None:
+                logger.warning(
+                    "diffusion.rocm_triton_conv2d: Triton conv2d failed for x=%s w=%s, MIOpen from now on: %s",
+                    x_shape,
+                    w_shape,
+                    repr(exc)[:300],
+                )
+            return original(input, weight, bias)
+        COUNTS["routed"] += 1
+        return y
+
+    _conv_forward._unsloth_triton_conv2d = True
+    return _conv_forward
+
+
+def prebuild_enabled() -> bool:
+    if (os.environ.get(PREBUILD_ENV) or "").strip().lower() in _FALSE:
+        return False
+    try:
+        from . import diffusion_vae_prebuild
+    except Exception:  # noqa: BLE001
+        return False
+    return diffusion_vae_prebuild.enabled()
+
+
+def _source_digest() -> str:
+    import hashlib
+
+    h = hashlib.sha256()
+    root = os.path.join(os.path.dirname(os.path.abspath(__file__)), "rocm_triton_conv2d")
+    for name in sorted(os.listdir(root)):
+        if name.endswith(".py"):
+            with open(os.path.join(root, name), "rb") as f:
+                h.update(name.encode() + b"\0" + f.read())
+    return h.hexdigest()[:16]
+
+
+def _manifest_path() -> Optional[str]:
+    """One manifest per (kernel source, torch, Triton, arch, TRITON_* env), beside the Triton cache."""
+    with _PB_LOCK:
+        if "path" in _PB:
+            return _PB["path"]
+        path = None
+        try:
+            import hashlib
+            import json
+
+            import torch
+            import triton
+
+            from . import diffusion_vae_prebuild
+
+            root = diffusion_vae_prebuild._triton_cache_dir()
+            if root:
+                key = json.dumps(
+                    [
+                        _source_digest(),
+                        str(torch.__version__),
+                        str(triton.__version__),
+                        _c3._device_arch(torch, None).split(":")[0],
+                        sorted((k, v) for k, v in os.environ.items() if k.startswith("TRITON_")),
+                    ]
+                )
+                digest = hashlib.sha256(key.encode()).hexdigest()[:32]
+                path = os.path.join(
+                    root, diffusion_vae_prebuild._MARKER_DIR, f"rocm_conv2d_{digest}.json"
+                )
+        except Exception:  # noqa: BLE001 - no Triton / cache dir: compile inline
+            path = None
+        _PB["path"] = path
+        return path
+
+
+def _gated() -> bool:
+    return prebuild_enabled() and _manifest_path() is not None
+
+
+def _refresh(force: bool = False) -> None:
+    path = _manifest_path()
+    if path is None:
+        return
+    now = time.monotonic()
+    with _PB_LOCK:
+        if not force and now - _PB.get("polled", -1e9) < MANIFEST_POLL_S:
+            return
+        _PB["polled"] = now
+        try:
+            mtime = os.stat(path).st_mtime_ns
+        except OSError:
+            return
+        if not force and mtime == _PB.get("mtime"):
+            return
+        data = _c3._read_manifest(path)
+        _PB["mtime"] = mtime
+        _READY.update(k for k in data.get("keys", []) if isinstance(k, str))
+        _PB.setdefault("selfcheck", {}).update(
+            {k: bool(v) for k, v in (data.get("selfcheck") or {}).items()}
+        )
+
+
+def _index(torch: Any, device: Any) -> int:
+    return int(device.index if device.index is not None else torch.cuda.current_device())
+
+
+def _selfcheck_ready(input: Any) -> bool:
+    import torch
+
+    if ("selfcheck", str(input.device), str(input.dtype)) in _STATE:
+        return True
+    sk = str(input.dtype)
+    if sk not in _PB.get("selfcheck", {}):
+        _refresh()
+    ok = _PB.get("selfcheck", {}).get(sk)
+    if ok is None:
+        _note_pending(
+            "selfcheck|" + sk,
+            {"selfcheck": sk.replace("torch.", ""), "device": _index(torch, input.device)},
+        )
+        return False
+    if not ok:
+        _STATE[("selfcheck", str(input.device), str(input.dtype))] = False
+    return True
+
+
+def variant_key(
+    route: str, x_shape, w_shape, dtype_name: str, has_bias: bool, aligned: bool
+) -> str:
+    """The compiled variants of a call: H / W / channels are constexprs, so the key is the exact shape (stride 1,
+    padding k // 2, dilation 1 are implied by the table) plus bias presence and the input's 16-byte alignment."""
+    import json
+    return json.dumps(
+        [
+            route,
+            [int(v) for v in x_shape],
+            [int(v) for v in w_shape],
+            dtype_name,
+            bool(has_bias),
+            bool(aligned),
+        ]
+    )
+
+
+def _spec(route, x_shape, w_shape, dtype_name, has_bias, aligned, device) -> dict:
+    return {
+        "route": route,
+        "x": [int(v) for v in x_shape],
+        "w": [int(v) for v in w_shape],
+        "dtype": dtype_name,
+        "bias": bool(has_bias),
+        "aligned": bool(aligned),
+        "device": int(device),
+    }
+
+
+def _variant_ready(route: str, input: Any, weight: Any, bias: Any) -> bool:
+    import torch
+
+    dtype_name = str(input.dtype).replace("torch.", "")
+    aligned = input.data_ptr() % 16 == 0
+    vk = variant_key(route, input.shape, weight.shape, dtype_name, bias is not None, aligned)
+    if vk in _READY:
+        return True
+    _refresh()
+    if vk in _READY:
+        return True
+    _note_pending(
+        vk,
+        _spec(
+            route,
+            input.shape,
+            weight.shape,
+            dtype_name,
+            bias is not None,
+            aligned,
+            _index(torch, input.device),
+        ),
+    )
+    return False
+
+
+def _note_pending(vk: str, spec: dict) -> None:
+    with _PB_LOCK:
+        if vk in _PENDING:
+            if _PB.get("timer") is None and not _PB.get("live"):
+                _arm_timer()
+            return
+        if vk in _READY or vk in _PB.get("inflight", ()):
+            return
+        if _ATTEMPTS.get(vk, 0) >= MAX_ATTEMPTS:
+            return
+        _PENDING[vk] = spec
+        _arm_timer()
+
+
+def _arm_timer() -> None:
+    with _PB_LOCK:
+        old = _PB.get("timer")
+        if old is not None:
+            old.cancel()
+        t = threading.Timer(KICK_DEBOUNCE_S, _kick)
+        t.daemon = True
+        _PB["timer"] = t
+        t.start()
+
+
+def _kick(logger: Any = None) -> bool:
+    """Hand the pending variants of one device to a prebuild child (one child at a time). Never raises."""
+    try:
+        import torch
+
+        from . import diffusion_vae_prebuild
+
+        with _PB_LOCK:
+            _PB["timer"] = None
+            logger = logger or _PB.get("logger")
+            if _PB.get("live") or not _PENDING:
+                return False
+            device = next(iter(_PENDING.values()))["device"]
+            free, _total = torch.cuda.mem_get_info(device)
+            if free < PREBUILD_MIN_FREE:
+                return False  # stays pending: the next cold call re-arms
+            batch = {k: s for k, s in _PENDING.items() if s["device"] == device}
+            for k in batch:
+                del _PENDING[k]
+                _ATTEMPTS[k] = _ATTEMPTS.get(k, 0) + 1
+            job = {
+                "name": "rocm conv2d",
+                "owner": "image",
+                "device": device,
+                "manifest": _manifest_path(),
+                "selfcheck": sorted({s["selfcheck"] for s in batch.values() if "selfcheck" in s}),
+                "specs": [dict(s, key = k) for k, s in batch.items() if "x" in s],
+            }
+            _PB["live"] = True
+            _PB["inflight"] = set(batch)
+        ok = diffusion_vae_prebuild._spawn(
+            job,
+            logger,
+            target = (__name__, "_prebuild_child"),
+            timeout = PREBUILD_TIMEOUT_S,
+            on_exit = _child_exit,
+        )
+        if not ok:
+            _child_exit(None)
+        return ok
+    except Exception as exc:  # noqa: BLE001 - a prebuild, never a failed decode
+        with _PB_LOCK:
+            _PB["live"] = False
+            _PB["inflight"] = set()
+        if logger is not None:
+            logger.info(
+                "diffusion.rocm_triton_conv2d: prebuild skipped (%s: %s)", type(exc).__name__, exc
+            )
+        return False
+
+
+def _child_exit(_exitcode: Any = None) -> None:
+    with _PB_LOCK:
+        _PB["live"] = False
+        _PB["inflight"] = set()
+    _refresh(force = True)
+    with _PB_LOCK:
+        for k in [k for k in _PENDING if k in _READY]:
+            del _PENDING[k]
+        if _PENDING:
+            _arm_timer()
+
+
+def cancel_pending() -> None:
+    """Unload: no new child (``diffusion_vae_prebuild.cancel_all`` kills a live one)."""
+    with _PB_LOCK:
+        t = _PB.get("timer")
+        if t is not None:
+            t.cancel()
+        _PB["timer"] = None
+        _PENDING.clear()
+
+
+def trace_decoder_calls(vae: Any, latent_hw: tuple, dtype: Any) -> list:
+    """(x_shape, w_shape, has_bias) of every Conv2d call of a 1-image decode at ``latent_hw``, traced on a
+    weightless meta-device copy of ``vae`` (same class and config): no memory, no kernels, no Studio patches."""
+    import torch
+
+    config = dict(getattr(vae, "config", None) or {})
+    latent = config.get("latent_channels")
+    if not isinstance(latent, int):
+        return []
+    with torch.device("meta"):
+        meta = type(vae).from_config(config)
+    meta = meta.to(dtype = dtype).eval()
+    calls: list = []
+
+    def hook(m, args):
+        x = args[0] if args else None
+        if hasattr(x, "shape"):
+            calls.append((tuple(x.shape), tuple(m.weight.shape), m.bias is not None))
+
+    hooks = [
+        m.register_forward_pre_hook(hook) for m in meta.modules() if isinstance(m, torch.nn.Conv2d)
+    ]
+    try:
+        z = torch.empty((1, latent, *latent_hw), device = "meta", dtype = dtype)
+        with torch.no_grad():
+            pq = getattr(meta, "post_quant_conv", None)
+            if pq is not None:
+                z = pq(z)
+            meta.decoder(z)
+    finally:
+        for h in hooks:
+            h.remove()
+    return calls
+
+
+def _default_latent_hw(vae: Any) -> Optional[tuple]:
+    blocks = (getattr(vae, "config", None) or {}).get("block_out_channels")
+    if not isinstance(blocks, (list, tuple)) or not blocks:
+        return None
+    side = PREBUILD_OUTPUT_SIDE // (2 ** (len(blocks) - 1))
+    return (side, side)
+
+
+def prebuild(vae: Any, logger: Any = None) -> int:
+    """After the image load: queue the default-resolution decode's routed variants (meta-device trace) plus the
+    self-check for a prebuild child and start it. Returns the number of variants queued. Never blocks, never raises."""
+    try:
+        if vae is None or not _gated() or not _installed(vae):
+            return 0
+        import torch
+
+        if _kernels() is None:
+            return 0
+        weight = next(
+            (
+                m.weight
+                for m in vae.modules()
+                if getattr(m.__dict__.get("_conv_forward"), "_unsloth_triton_conv2d", False)
+            ),
+            None,
+        )
+        if weight is None or not _on_gpu(weight) or weight.dtype != torch.bfloat16:
+            return 0
+        if not _device_ok(torch, weight.device.index):
+            return 0
+        device = _index(torch, weight.device)
+        dtype_name = str(weight.dtype).replace("torch.", "")
+        _refresh(force = True)
+        queued: dict = {}
+        sk = str(weight.dtype)
+        if sk not in _PB.get("selfcheck", {}):
+            queued["selfcheck|" + sk] = {"selfcheck": dtype_name, "device": device}
+        hw = _default_latent_hw(vae)
+        calls = trace_decoder_calls(vae, hw, weight.dtype) if hw else []
+        for x_shape, w_shape, has_bias in calls:
+            route = route_for(x_shape, w_shape, (1, 1), (w_shape[2] // 2,) * 2, (1, 1), dtype_name)
+            if route is None:
+                continue
+            vk = variant_key(route, x_shape, w_shape, dtype_name, has_bias, True)
+            if vk in _READY or vk in queued:
+                continue
+            queued[vk] = _spec(route, x_shape, w_shape, dtype_name, has_bias, True, device)
+        with _PB_LOCK:
+            for vk, spec in queued.items():
+                if vk not in _PENDING and _ATTEMPTS.get(vk, 0) < MAX_ATTEMPTS:
+                    _PENDING[vk] = spec
+            if logger is not None:
+                _PB["logger"] = logger
+        n = sum(1 for k in queued if not k.startswith("selfcheck|"))
+        if queued:
+            _kick(logger)
+            if logger is not None:
+                logger.info(
+                    "diffusion.rocm_triton_conv2d: prebuilding %d conv2d variants in a child", n
+                )
+        return n
+    except Exception as exc:  # noqa: BLE001 - a prebuild, never a failed load
+        if logger is not None:
+            logger.info(
+                "diffusion.rocm_triton_conv2d: prebuild skipped (%s: %s)", type(exc).__name__, exc
+            )
+        return 0
+
+
+def _prebuild_child(job: dict) -> None:
+    """Child side: self-check first, then each variant on zeros (no weights); the manifest grows per variant."""
+    import torch
+
+    dev = _c3._child_device(torch, int(job["device"]))
+    mod = _kernels()
+    if mod is None:
+        return
+    path = job["manifest"]
+    for name in job.get("selfcheck", []):
+        dtype = getattr(torch, name)
+        ok = _selfcheck(torch, mod, dev, dtype)
+        _c3._merge_manifest(path, selfcheck = {str(dtype): ok})
+    with torch.no_grad():
+        for spec in job.get("specs", []):
+            dtype = getattr(torch, spec["dtype"])
+            x_shape, w_shape = tuple(spec["x"]), tuple(spec["w"])
+            try:
+                numel = 1
+                for v in x_shape:
+                    numel *= v
+                if spec.get("aligned", True):
+                    x = torch.zeros(x_shape, device = dev, dtype = dtype)
+                else:  # one element past a fresh allocation: the misaligned variant
+                    x = torch.zeros(numel + 8, device = dev, dtype = dtype)[1 : numel + 1].view(x_shape)
+                aligned = x.data_ptr() % 16 == 0
+                if (
+                    variant_key(
+                        spec["route"], x_shape, w_shape, spec["dtype"], spec["bias"], aligned
+                    )
+                    != spec["key"]
+                ):
+                    continue
+                w = torch.zeros(w_shape, device = dev, dtype = dtype)
+                b = torch.zeros(w_shape[0], device = dev, dtype = dtype) if spec["bias"] else None
+                _run(mod, spec["route"], x, w, b)
+                torch.cuda.synchronize(dev)
+                del x, w, b
+            except torch.OutOfMemoryError:
+                torch.cuda.empty_cache()
+                continue
+            except Exception:  # noqa: BLE001 - this variant stays on MIOpen
+                continue
+            _c3._merge_manifest(path, keys = (spec["key"],))
+
+
+def _installed(vae: Any) -> bool:
+    return any(
+        getattr(m.__dict__.get("_conv_forward"), "_unsloth_triton_conv2d", False)
+        for m in getattr(vae, "modules", lambda: [])()
+    )
+
+
+def install(vae: Any, logger: Any = None) -> int:
+    """Wrap every eligible ``nn.Conv2d`` of ``vae`` (per instance). Returns the number wrapped; 0 when off, not ROCm
+    gfx11, not a default VAE (env unset), or Triton is missing. The device is checked again per call."""
+    if vae is None or not requested() or not callable(getattr(vae, "modules", None)):
+        return 0
+    if _env_mode() is None and type(vae).__name__ not in DEFAULT_ON_VAES:
+        return 0
+    try:
+        import torch
+
+        from .rocm_bf16 import is_rocm_torch
+    except Exception:  # noqa: BLE001
+        return 0
+    if not is_rocm_torch(torch) or not torch.cuda.is_available():
+        return 0
+    arch = _c3._device_arch(torch, None)
+    if not arch_enabled(arch):
+        return 0
+    if _kernels() is None:
+        if logger is not None:
+            logger.info(
+                "diffusion.rocm_triton_conv2d: Triton conv2d unavailable (%s)",
+                _STATE.get("import_error"),
+            )
+        return 0
+    n = 0
+    for m in vae.modules():
+        if not isinstance(m, torch.nn.Conv2d) or m.groups != 1 or m.padding_mode != "zeros":
+            continue
+        k = tuple(m.kernel_size)
+        if (m.in_channels, m.out_channels, k[0]) not in SHAPE_TABLE or k[0] != k[1]:
+            continue  # never routable: leave the module untouched
+        current = m._conv_forward
+        if getattr(current, "_unsloth_triton_conv2d", False):
+            continue
+        m._conv_forward = _make_conv_forward(m, current, logger)
+        n += 1
+    if n and logger is not None:
+        logger.info(
+            "diffusion.rocm_triton_conv2d: %d %s Conv2d routed to the Triton conv2d on %s (measured shapes only)",
+            n,
+            type(vae).__name__,
+            arch,
+        )
+    return n
+
+
+def uninstall(vae: Any) -> int:
+    cancel_pending()
+    n = 0
+    for m in getattr(vae, "modules", lambda: [])():
+        fwd = m.__dict__.get("_conv_forward")
+        if getattr(fwd, "_unsloth_triton_conv2d", False):
+            del m.__dict__["_conv_forward"]
+            n += 1
+    if n and _STATE.get("mod") is not None:
+        try:
+            _STATE["mod"].clear_conv2d_weight_pack_caches()
+        except Exception:  # noqa: BLE001
+            pass
+    return n
+
+
+def status(vae: Any) -> Optional[dict]:
+    """Engagement for the load's status (None when nothing is wrapped: the key is then omitted)."""
+    wrapped = sum(
+        1
+        for m in getattr(vae, "modules", lambda: [])()
+        if getattr(m.__dict__.get("_conv_forward"), "_unsloth_triton_conv2d", False)
+    )
+    if not wrapped:
+        return None
+    return {"wrapped": wrapped, "ready_variants": len(_READY), **counts()}
