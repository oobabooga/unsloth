+                "BLOCK_C": 32,
+                "BLOCK_M": 64,
+                "num_warps": 4,
+                "num_stages": 1,
+            },
+        },
+        "M_LEQ_131072": {"BLOCK_C": 64, "BLOCK_M": 64, "num_warps": 8, "num_stages": 1},
+        "M_LEQ_65536": {
+            "BLOCK_C": 32,
+            "BLOCK_M": 128,
+            "waves_per_eu": 2,
+            "num_warps": 8,
+            "num_stages": 1,
+        },
+        "M_LEQ_1024": {"BLOCK_C": 32, "BLOCK_M": 32, "num_warps": 4, "num_stages": 1},
+        "M_LEQ_64": {
+            "BLOCK_C": 32,
+            "BLOCK_M": 128,
+            "waves_per_eu": 2,
+            "num_warps": 8,
+            "num_stages": 1,
+        },
+        "any": {"BLOCK_C": 32, "BLOCK_M": 128, "waves_per_eu": 2, "num_warps": 8, "num_stages": 1},
+    },
+}
+
+
+def format_shape_key(
+    N: int,
+    C: int,
+    H: int,
+    W: int,
+    K: int,
+    R: int,
+    S: int,
+    sh: int,
+    sw: int,
+    ph: int,
+    pw: int,
+    dh: int,
+    dw: int,
+) -> str:
+    """Canonical string key for a user-visible conv2d call."""
+    return (
+        f"N={N},C={C},H={H},W={W},K={K},R={R},S={S},"
+        f"sh={sh},sw={sw},ph={ph},pw={pw},dh={dh},dw={dw}"
+    )
+
+
+def format_prepack_shape_key(N: int, C: int, H: int, W: int, CB: int) -> str:
+    """Canonical key for an NCHW-to-NCHWc activation pack."""
+    return f"N={N},C={C},H={H},W={W},CB={CB}"
+
+
+@functools.lru_cache(maxsize = 512)
+def _get_conv_config_cached(
+    config_name: str, shape_key: str | None, M: int | None, variants: tuple[str, ...]
+) -> dict:
+    """Config walk: variant shape entries, generic shape, M bucket, any."""
+    config_dict = TABLES[config_name]
+    if shape_key is not None:
+        for variant in variants:
+            shapes = config_dict.get(f"shapes_{variant}", {})
+            if shape_key in shapes:
+                return shapes[shape_key]
+    shapes = config_dict.get("shapes", {})
+    if shape_key is not None and shape_key in shapes:
+        return shapes[shape_key]
+    if M is not None and M >= 0:
+        for bound in CONV_STANDARD_M_BOUNDS:
+            key = f"M_LEQ_{bound}"
+            if M <= bound and key in config_dict:
+                return config_dict[key]
+    return config_dict["any"]
+
+
+def get_conv_config(
+    config_name: str,
+    shape_key: str | None = None,
+    M: int | None = None,
+    variants: tuple[str, ...] = (),
+) -> dict:
+    """A fresh shallow copy of the config for this call."""
+    return dict(_get_conv_config_cached(config_name, shape_key, M, variants))
