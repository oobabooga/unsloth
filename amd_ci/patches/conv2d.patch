+def _klein_calls(side = 128):
+    if _diffusers is None:
+        pytest.skip("diffusers missing")
+    vae = _diffusers.AutoencoderKLFlux2.from_config(FLUX2_VAE_CONFIG)
+    return R.trace_decoder_calls(vae, (side, side), torch.bfloat16)
