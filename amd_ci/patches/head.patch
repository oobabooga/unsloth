+    model = FluxTransformer2DModel()
+    router, _ = _router(model)
+    _flux_loop(model, 2, 3)
+    router.end_render()
+    before = router.stats["batch_splits"]
+    _flux_loop(model, 2, 3)
+    assert router.stats["batch_splits"] - before == 3
+
