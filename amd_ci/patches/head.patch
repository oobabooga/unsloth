+        cwd = str(Path(__file__).resolve().parents[1]),
+        env = env,
+        capture_output = True,
+        text = True,
+        timeout = 300,
+    )
+    line = [ln for ln in proc.stdout.splitlines() if ln.startswith("H3PROBE ")]
+    assert proc.returncode == 0 and line, proc.stderr[-2000:]
+    got = json.loads(line[-1][len("H3PROBE ") :])
+    print(got)
+    assert got["torch_calls"] == []
+    assert got["cards"] and got["count"] == len(got["cards"]) == got["pci"]
+    for card in got["cards"]:
+        free, total = card["budget"]
+        if card["target"] in hardware._ROCM_DISCRETE_ONLY_ARCHES:
