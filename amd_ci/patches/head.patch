+def test_h3_budget_probe_on_a_real_rocm_host():
+    """Real KFD + sysfs: the no-context probe counts every card, never calls torch, reads a discrete card's total
+    close to torch's and leaves an APU (unlisted target) unread instead of reporting its carve-out."""
+    import json
