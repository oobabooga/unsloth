+def test_native_int8_compiles_without_graph_breaks():
+    m = _native_model()
+    dfu.install(m)
+    torch._dynamo.reset()
+    try:
+        explain = torch._dynamo.explain(m.blocks[0])(torch.randn(2, 4, 64, dtype = torch.bfloat16))
+    finally:
+        torch._dynamo.reset()
+    assert explain.graph_break_count == 0
+    assert explain.graph_count == 1
