+class _Log:
+    def __init__(self):
+        self.lines = []
+
+    def info(self, msg, *a):
+        self.lines.append(("info", msg % a))
+
+    def warning(self, msg, *a):
+        self.lines.append(("warning", msg % a))
+
+    debug = info
