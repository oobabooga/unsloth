+    name: hardware.name || "NPU",
+    driver: driver || null,
+    model: row ? row.label || row.name : null,
+    residentGb: row?.residentMib ? row.residentMib / 1024 : null,
+    loadPercent: Number.isFinite(loadPercent) ? (loadPercent as number) : null,
+  };
