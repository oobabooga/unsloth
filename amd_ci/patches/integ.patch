+// SPDX-License-Identifier: AGPL-3.0-only
+// Copyright 2026-present the Unsloth AI Inc. team. All rights reserved. See /studio/LICENSE.AGPL-3.0
+
+import assert from "node:assert/strict";
+import { register } from "node:module";
+import test from "node:test";
+
+import { installLocalStorageFake } from "./helpers/kit.ts";
+
+const { store: storage } = installLocalStorageFake();
+register("./store-settings-resolver.mjs", import.meta.url);
+
+const { useChatRuntimeStore } = await import(
+  "../src/features/chat/stores/chat-runtime-store.ts"
+);
+const { applyActiveModelStatusToStore } = await import(
+  "../src/features/chat/lib/apply-inference-status-to-store.ts"
+);
+
+const NPU = "lemonade:qwen3.8-tk-4b-FLM";
+const GPU = "unsloth/Qwen3-8B";
+
+function loadWithTools(modelId: string) {
+  storage.delete("unsloth_chat_tools_enabled");
+  storage.delete("unsloth_chat_code_tools_enabled");
+  useChatRuntimeStore.setState({
+    modelLoading: false,
+    toolsEnabled: true,
+    codeToolsEnabled: true,
+    params: { ...useChatRuntimeStore.getState().params, checkpoint: modelId },
+  });
+  return {
+    active_model: modelId,
+    model_identifier: modelId,
+    supports_tools: true,
+  } as never;
+}
+
+test("an NPU model loads with Search and Code off when the user never chose", () => {
+  applyActiveModelStatusToStore(loadWithTools(NPU), { previousCheckpoint: GPU });
+  assert.equal(useChatRuntimeStore.getState().supportsTools, true);
+  assert.equal(useChatRuntimeStore.getState().toolsEnabled, false);
+  assert.equal(useChatRuntimeStore.getState().codeToolsEnabled, false);
+});
+
+test("a GPU model with tools still loads with Search and Code on", () => {
+  applyActiveModelStatusToStore(loadWithTools(GPU), { previousCheckpoint: NPU });
+  assert.equal(useChatRuntimeStore.getState().toolsEnabled, true);
+  assert.equal(useChatRuntimeStore.getState().codeToolsEnabled, true);
+});
+
+test("an NPU model keeps a saved explicit choice to turn the pills on", () => {
+  const status = loadWithTools(NPU);
+  useChatRuntimeStore.getState().setToolsEnabled(true);
+  useChatRuntimeStore.getState().setCodeToolsEnabled(true);
+  applyActiveModelStatusToStore(status, { previousCheckpoint: GPU });
+  assert.equal(useChatRuntimeStore.getState().toolsEnabled, true);
+  assert.equal(useChatRuntimeStore.getState().codeToolsEnabled, true);
+});
diff --git a/studio/frontend/tests/npu-tools-new-chat.test.ts b/studio/frontend/tests/npu-tools-new-chat.test.ts
new file mode 100644
index 000000000..f874745e5
--- /dev/null
+++ b/studio/frontend/tests/npu-tools-new-chat.test.ts
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+// Copyright 2026-present the Unsloth AI Inc. team. All rights reserved. See /studio/LICENSE.AGPL-3.0
+
+import assert from "node:assert/strict";
+import { register } from "node:module";
+import test, { type TestContext } from "node:test";
+import type * as chatRuntime from "../src/features/chat/stores/chat-runtime-store.ts";
+import { installLocalStorageFake } from "./helpers/kit.ts";
+
+const { store: storage } = installLocalStorageFake();
+register("./thread-sampling-resolver.mjs", import.meta.url);
+const { settingsHttp } = await import("./helpers/store-stubs/settings-http.ts");
+const { threadRows } = await import("./helpers/store-stubs/chat-history-storage.ts");
+const runtimeUrl = new URL(
+  "../src/features/chat/stores/chat-runtime-store.ts",
+  import.meta.url,
+).href;
+const { applyActiveModelStatusToStore } = await import(
+  "../src/features/chat/lib/apply-inference-status-to-store.ts"
+);
+
+const GPU = "unsloth/Qwen3-8B";
+const NPU = "lemonade:qwen3.8-tk-4b-FLM";
+
+async function newChatAfterLoading(t: TestContext, model: string, saved?: boolean) {
+  storage.clear();
+  storage.set("unsloth_chat_settings_imported_to_studio_db", "true");
+  if (saved !== undefined) storage.set("unsloth_chat_tools_enabled", String(saved));
+  settingsHttp.settings = { rememberParamsPerModel: false };
+  threadRows.reset();
+  const runtime = (await import(
+    `${runtimeUrl}?scenario=${encodeURIComponent(t.name)}`
+  )) as typeof chatRuntime;
+  const store = runtime.useChatRuntimeStore;
+  t.after(async () => {
+    await runtime.flushPendingChatSettings();
+    await runtime.awaitStartedThreadScopedSettingsWrites();
+  });
+  await store.getState().hydratePersistedSettings();
+  store.getState().setCheckpoint(GPU, null);
+  store.setState({ supportsTools: true, ...runtime.resolveToolsEnabledOnLoad(true, GPU) });
+  // A chat opened under the GPU model captures its Search-on default.
+  store.getState().setActiveThreadId("gpu-chat");
+  store.getState().applyThreadScopedSettings("gpu-chat", null);
+  await runtime.awaitThreadScopedSettingsWrite("gpu-chat");
+  store.getState().setCheckpoint(model, null);
+  applyActiveModelStatusToStore(
+    { active_model: model, model_identifier: model, supports_tools: true } as never,
+    { previousCheckpoint: GPU },
+  );
+  store.getState().setActiveThreadId(null);
+  store.getState().applyThreadScopedSettings(null, null);
+  const composer = store.getState().toolsEnabled;
+  store.getState().setActiveThreadId("new-chat");
+  store.getState().applyThreadScopedSettings("new-chat", null);
+  await runtime.awaitThreadScopedSettingsWrite("new-chat");
+  return {
+    composer,
+    live: store.getState().toolsEnabled,
+    code: store.getState().codeToolsEnabled,
+    stored: threadRows.rows.get("new-chat")?.toolsEnabled,
+  };
+}
+
+test("a new chat on an NPU model starts with Search and Code off", async (t) => {
+  assert.deepEqual(await newChatAfterLoading(t, NPU), {
+    composer: false,
+    live: false,
+    code: false,
+    stored: false,
+  });
+});
+
+test("a new chat on a GPU model still starts with Search and Code on", async (t) => {
+  assert.deepEqual(await newChatAfterLoading(t, "unsloth/gemma-4-E2B-it"), {
+    composer: true,
+    live: true,
+    code: true,
+    stored: true,
+  });
+});
+
+test("a new chat on an NPU model keeps a saved choice to turn Search on", async (t) => {
+  const result = await newChatAfterLoading(t, NPU, true);
+  assert.equal(result.live, true);
+  assert.equal(result.stored, true);
+  assert.equal(result.code, false);
+});
+
+test("a new GPU chat after an NPU-first chat still starts with Search and Code on", async (t) => {
+  storage.clear();
+  storage.set("unsloth_chat_settings_imported_to_studio_db", "true");
+  settingsHttp.settings = { rememberParamsPerModel: false };
+  threadRows.reset();
+  const runtime = (await import(
+    `${runtimeUrl}?scenario=${encodeURIComponent(t.name)}`
+  )) as typeof chatRuntime;
+  const store = runtime.useChatRuntimeStore;
+  t.after(async () => {
+    await runtime.flushPendingChatSettings();
+    await runtime.awaitStartedThreadScopedSettingsWrites();
+  });
+  await store.getState().hydratePersistedSettings();
+  store.getState().setCheckpoint(NPU, null);
+  store.setState({ supportsTools: true, ...runtime.resolveToolsEnabledOnLoad(true, NPU) });
+  store.getState().setActiveThreadId("npu-chat");
+  store.getState().applyThreadScopedSettings("npu-chat", null);
+  await runtime.awaitThreadScopedSettingsWrite("npu-chat");
+  assert.equal(threadRows.rows.get("npu-chat")?.toolsEnabled, false);
+  store.getState().setCheckpoint(GPU, null);
+  applyActiveModelStatusToStore(
+    { active_model: GPU, model_identifier: GPU, supports_tools: true } as never,
+    { previousCheckpoint: NPU },
+  );
+  store.getState().setActiveThreadId(null);
+  store.getState().applyThreadScopedSettings(null, null);
+  store.getState().setActiveThreadId("gpu-chat");
+  store.getState().applyThreadScopedSettings("gpu-chat", null);
+  await runtime.awaitThreadScopedSettingsWrite("gpu-chat");
+  assert.equal(store.getState().toolsEnabled, true);
+  assert.equal(store.getState().codeToolsEnabled, true);
+  assert.equal(threadRows.rows.get("gpu-chat")?.toolsEnabled, true);
+});
