+def test_rocm_listed_arch_races_the_triton_kernel(card, monkeypatch):
+    """ROCm runs only the Triton kernel, so the CUDA-only rule does not apply there: on a ROCM_AUTO_ARCHS card a
+    ROCM_AUTO_DITS family races it with the switch unset (timed, never forced); an unlisted family does not."""
+    from core.inference import rocm_bf16
+
+    monkeypatch.setattr(rocm_bf16, "is_rocm_torch", lambda *a, **k: True)
+    monkeypatch.setattr(
+        torch.cuda, "get_device_properties", lambda *a, **k: types.SimpleNamespace(gcnArchName = "gfx1151")
+    )
+    monkeypatch.setattr(
+        I, "implementation", lambda index, head_dim: "triton" if head_dim in (64, 128) else None
+    )
+    card.found = {"ok": True, "min_tokens": 0, "impl": "triton"}
+    pipe = _pipe()
+    assert I.install_auto(pipe, _TARGET) == 3
+    assert _flags(pipe) == [(True, D.MIN_TOKENS)] * 3 + [(False, 0)]
+    assert card.seen and all(timed for *_, timed in card.seen)
+    card.seen.clear()
+    monkeypatch.setattr(D, "ROCM_AUTO_DITS", D.ROCM_AUTO_DITS - {"Flux3Transformer2DModel"})
+    pipe = _pipe()
+    assert I.install_auto(pipe, _TARGET) == 0 and not card.seen
+    assert _flags(pipe) == [(False, 0)] * 4
+
