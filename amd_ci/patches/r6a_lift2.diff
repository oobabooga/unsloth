diff --git a/studio/backend/core/inference/diffusion_rocm_aiter_conv3d.py b/studio/backend/core/inference/diffusion_rocm_aiter_conv3d.py
new file mode 100644
index 0000000000..f5117828a1
--- /dev/null
+++ b/studio/backend/core/inference/diffusion_rocm_aiter_conv3d.py
@@ -0,0 +1,143 @@
+# SPDX-License-Identifier: AGPL-3.0-only
+# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved. See /studio/LICENSE.AGPL-3.0
+
+"""gfx1151 (opt-in): route the Wan VAE's causal Conv3d calls through AITER's Triton direct / Winograd conv3d
+(ROCm/aiter #5952 + #8215, gfx1151 configs #6973) instead of MIOpen. Measured on AMD CI Linux gfx1151 (Wan 2.2
+TI2V-5B VAE, 704x1280x49 decode): 51.9 -> 32.3 s, PSNR 54.7 dB vs MIOpen, peak 11.8 -> 18.7 GiB, every conv routed.
+
+Needs an AITER checkout (``UNSLOTH_AITER_DIR``, its ``aiter/ops/triton/conv`` is pure Triton, imported through stub
+packages so no HIP build runs). ``UNSLOTH_DIFFUSION_ROCM_AITER_CONV3D=1`` turns it on; anything failing keeps MIOpen
+for that call (counted in ``COUNTS``)."""
+
+from __future__ import annotations
+
+import os
+import threading
+from typing import Any, Optional
+
+ENABLE_ENV = "UNSLOTH_DIFFUSION_ROCM_AITER_CONV3D"
+AITER_DIR_ENV = "UNSLOTH_AITER_DIR"
+ARCHES = ("gfx1151",)
+COUNTS = {"aiter": 0, "fallback": 0}
+_LOCK = threading.Lock()
+_MOD: dict = {}
+
+
+def enabled() -> bool:
+    return (os.environ.get(ENABLE_ENV) or "").strip().lower() in ("1", "true", "yes", "on")
+
+
+def _conv3d_module() -> Optional[Any]:
+    """aiter.ops.triton.conv.conv3d through stub parent packages (skips aiter/__init__.py and its HIP JIT)."""
+    with _LOCK:
+        if "mod" in _MOD:
+            return _MOD["mod"]
+        mod = None
+        root = os.environ.get(AITER_DIR_ENV) or ""
+        try:
+            import importlib.machinery
+            import importlib.util
+            import sys
+
+            if root and os.path.isfile(
+                os.path.join(root, "aiter", "ops", "triton", "conv", "conv3d.py")
+            ):
+                for name, sub in (
+                    ("aiter", "aiter"),
+                    ("aiter.ops", "aiter/ops"),
+                    ("aiter.ops.triton", "aiter/ops/triton"),
+                ):
+                    if name not in sys.modules:
+                        spec = importlib.machinery.ModuleSpec(name, None, is_package = True)
+                        spec.submodule_search_locations = [os.path.join(root, sub)]
+                        sys.modules[name] = importlib.util.module_from_spec(spec)
+                from aiter.ops.triton.conv import conv3d as mod  # type: ignore[no-redef]
+        except Exception:  # noqa: BLE001
+            mod = None
+        _MOD["mod"] = mod
+        return mod
+
+
+def _arch_ok(device: Any) -> bool:
+    try:
+        import torch
+
+        from .rocm_bf16 import is_rocm_torch
+
+        if not is_rocm_torch(torch):
+            return False
+        name = getattr(torch.cuda.get_device_properties(device), "gcnArchName", "") or ""
+        return name.split(":")[0] in ARCHES
+    except Exception:  # noqa: BLE001
+        return False
+
+
+def install(vae: Any, logger: Any = None) -> int:
+    """Route every WanCausalConv3d of ``vae`` (per instance). Returns the number routed; 0 when off / not eligible."""
+    if vae is None or not enabled():
+        return 0
+    try:
+        import torch
+        import torch.nn.functional as F
+        from diffusers.models.autoencoders import autoencoder_kl_wan as W
+    except Exception:  # noqa: BLE001
+        return 0
+    # speed optims run before placement (the VAE can still be on the CPU here): the card is checked at call time
+    if not _arch_ok(0):
+        return 0
+    conv = _conv3d_module()
+    if conv is None:
+        if logger is not None:
+            logger.info(
+                "diffusion.rocm_aiter_conv3d: no AITER conv3d at %s=%r",
+                AITER_DIR_ENV,
+                os.environ.get(AITER_DIR_ENV),
+            )
+        return 0
+    n = 0
+    for m in vae.modules():
+        if not isinstance(m, W.WanCausalConv3d) or getattr(m, "_unsloth_aiter", False):
+            continue
+
+        def fwd(
+            x,
+            cache_x = None,
+            _m = m,
+        ):
+            padding = list(_m._padding)
+            if cache_x is not None and _m._padding[4] > 0:
+                x = torch.cat([cache_x.to(x.device), x], dim = 2)
+                padding[4] -= cache_x.shape[2]
+            x = F.pad(x, padding)
+            if (
+                x.is_cuda
+                and x.dtype in (torch.bfloat16, torch.float16)
+                and _m.groups == 1
+                and _m.padding_mode == "zeros"
+            ):
+                try:
+                    y = conv.conv3d(
+                        x,
+                        _m.weight,
+                        _m.bias,
+                        stride = _m.stride,
+                        padding = _m.padding,
+                        dilation = _m.dilation,
+                    )
+                    COUNTS["aiter"] += 1
+                    return y
+                except torch.OutOfMemoryError:
+                    raise
+                except Exception:  # noqa: BLE001 -- MIOpen for this call
+                    pass
+            COUNTS["fallback"] += 1
+            return torch.nn.Conv3d.forward(_m, x)
+
+        m.forward = fwd
+        m._unsloth_aiter = True
+        n += 1
+    if n and logger is not None:
+        logger.info(
+            "diffusion.rocm_aiter_conv3d: %d Wan VAE Conv3d routed to AITER Triton conv3d", n
+        )
+    return n
diff --git a/studio/backend/core/inference/diffusion_rocm_weight_pitch.py b/studio/backend/core/inference/diffusion_rocm_weight_pitch.py
new file mode 100644
index 0000000000..c3bedefd20
--- /dev/null
+++ b/studio/backend/core/inference/diffusion_rocm_weight_pitch.py
@@ -0,0 +1,103 @@
+# SPDX-License-Identifier: AGPL-3.0-only
+# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved. See /studio/LICENSE.AGPL-3.0
+
+"""gfx1151 (opt-in): store the denoiser's 16-bit ``nn.Linear`` weights with a padded row pitch (K + P elements, a
+view of an [N, K + P] buffer) so hipBLASLt reads them off the power-of-two strides that alias on this APU's memory
+channels. Bit-identical (same GEMM, another leading dimension). AMD CI Linux gfx1151, untuned hipBLASLt, P = 64:
+block linear sums 1.09x Wan 5B, 1.26x Krea-2, 1.31x Qwen-Image-2.1, 1.30x LTX-2.5, 1.10x FLUX.3 klein; weight memory
++P / K (0.4-2%).
+
+``UNSLOTH_DIFFUSION_ROCM_WEIGHT_PITCH=<P>`` (elements, > 0) turns it on; unset / 0 keeps contiguous weights."""
+
+from __future__ import annotations
+
+import os
+from typing import Any
+
+PITCH_ENV = "UNSLOTH_DIFFUSION_ROCM_WEIGHT_PITCH"
+ARCHES = ("gfx1151",)
+MIN_IN_FEATURES = 1024
+STATS = {"padded": 0, "bytes": 0}
+
+
+def pitch() -> int:
+    raw = (os.environ.get(PITCH_ENV) or "").strip()
+    return int(raw) if raw.isdigit() else 0
+
+
+def _arch_ok(device: Any) -> bool:
+    try:
+        import torch
+
+        from .rocm_bf16 import is_rocm_torch
+
+        if not is_rocm_torch(torch):
+            return False
+        name = getattr(torch.cuda.get_device_properties(device), "gcnArchName", "") or ""
+        return name.split(":")[0] in ARCHES
+    except Exception:  # noqa: BLE001
+        return False
+
+
+def install(module: Any, logger: Any = None) -> int:
+    """Speed optims run before placement, so the re-store waits for the module's first forward (weights on the card
+    by then); returns 1 when the hook is armed."""
+    if (
+        module is None
+        or pitch() <= 0
+        or getattr(module, "_unsloth_weight_pitch_hook", None) is not None
+    ):
+        return 0
+
+    def hook(mod, args):
+        handle = getattr(mod, "_unsloth_weight_pitch_hook", None)
+        if handle is not None:
+            handle.remove()
+        mod._unsloth_weight_pitch_hook = False
+        pad_weights(mod, logger)
+
+    module._unsloth_weight_pitch_hook = module.register_forward_pre_hook(hook)
+    return 1
+
+
+def pad_weights(module: Any, logger: Any = None) -> int:
+    """Re-store every eligible plain ``nn.Linear`` weight of ``module`` with the padded pitch. Returns the count."""
+    p = pitch()
+    if module is None or p <= 0:
+        return 0
+    import torch
+
+    n = 0
+    checked = {}
+    with torch.no_grad():
+        for m in module.modules():
+            if type(m) is not torch.nn.Linear:
+                continue
+            w = m.weight
+            if (
+                not isinstance(w, torch.nn.Parameter)
+                or type(w.data) is not torch.Tensor
+                or w.dim() != 2
+                or w.device.type != "cuda"
+                or w.dtype not in (torch.bfloat16, torch.float16)
+                or not w.is_contiguous()
+                or w.shape[1] < MIN_IN_FEATURES
+            ):
+                continue
+            idx = w.device.index or 0
+            if idx not in checked:
+                checked[idx] = _arch_ok(w.device)
+            if not checked[idx]:
+                continue
+            N, K = w.shape
+            buf = torch.empty((N, K + p), dtype = w.dtype, device = w.device)
+            buf[:, :K].copy_(w.data)
+            m.weight.data = buf[:, :K]
+            n += 1
+            STATS["bytes"] += N * p * w.element_size()
+    STATS["padded"] += n
+    if logger is not None:
+        logger.info(
+            "diffusion.rocm_weight_pitch: %d Linear weights re-stored with row pitch K + %d", n, p
+        )
+    return n
