     } else {
         $env:UNSLOTH_ROCM_TORCH_INSTALLED = "1"
         try {
@@ -8325,7 +8344,8 @@ if (-not $ROCmIndexUrl -and -not $XpuIndexUrl -and ($CuTag -eq "cpu" -or $ROCmCp
