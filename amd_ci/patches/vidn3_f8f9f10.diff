+# SPDX-License-Identifier: AGPL-3.0-only
+# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved. See /studio/LICENSE.AGPL-3.0
+
+"""MiniMax-H3 int8 keep list: the text path (token_refiner + condition_proj) runs at bf16 from the released weights,
+as ComfyUI's published int8_convrot DiT keeps it."""
+
+from __future__ import annotations
+
+import json
+import struct
+
+import pytest
+
+torch = pytest.importorskip("torch")
+diffusers = pytest.importorskip("diffusers")
+
+
+def _tiny_h3():
+    torch.manual_seed(0)
+    return diffusers.MiniMaxH3Transformer3DModel(
+        num_attention_heads = 2,
+        attention_head_dim = 16,
+        hidden_size = 32,
+        num_layers = 1,
+        num_refiner_layers = 2,
+        ffn_dim = 64,
+        text_dim = 24,
+    ).to(torch.bfloat16)
+
+
+def _released_from(model):
+    """Original (ComfyUI) layout of the model's text path: the inverse of h3_comfy_key_map, built by hand."""
+    sd = model.state_dict()
+    out = {}
+    for i in range(2):
+        d = f"token_refiner.refiner_blocks.{i}"
+        o = f"token_refiner.blocks.{i}"
+        out[f"{o}.attn.qkv_proj.weight"] = torch.cat([sd[f"{d}.attn.to_{p}.weight"] for p in "qkv"], 0)
+        out[f"{o}.attn.out_proj.weight"] = sd[f"{d}.attn.to_out.0.weight"]
+        v, g = sd[f"{d}.ff.net.0.proj.weight"].chunk(2, 0)  # diffusers SwiGLU [value; gate]
+        out[f"{o}.mlp.fc1.weight"] = torch.cat([g, v], 0)  # ComfyUI [gate; value]
+        out[f"{o}.mlp.fc2.weight"] = sd[f"{d}.ff.net.2.weight"]
+    out["condition_proj.weight"] = sd["context_embedder.weight"]
+    out["condition_proj.bias"] = sd["context_embedder.bias"]
+    return out
+
+
+def test_released_text_path_maps_back_onto_the_diffusers_model():
+    from core.inference.video_minimax_h3_keep import to_diffusers
+
+    model = _tiny_h3()
+    mapped = to_diffusers(_released_from(model))
+    sd = model.state_dict()
+    assert len(mapped) == 2 * 6 + 2
+    for k, v in mapped.items():
+        assert torch.equal(sd[k], v), k
+
+
+def test_kept_linears_are_swapped_for_plain_ones_with_the_released_weights():
+    from core.inference.video_minimax_h3_keep import restore_dense_keep, to_diffusers
+
+    ref = _tiny_h3()
+    model = _tiny_h3()
+    with torch.no_grad():  # stand-in for the quantized text path: the same weights up to a small error
+        for name, mod in model.named_modules():
+            if (name.startswith("token_refiner") or name == "context_embedder") and isinstance(mod, torch.nn.Linear):
+                mod.weight.mul_(1.01)
+    n = restore_dense_keep(model, to_diffusers(_released_from(ref)), dtype = torch.bfloat16)
+    assert n == 2 * 6 + 1
+    for name, mod in model.named_modules():
+        if name.startswith("token_refiner") or name == "context_embedder":
+            if isinstance(mod, torch.nn.Linear):
+                assert type(mod) is torch.nn.Linear and mod.weight.dtype == torch.bfloat16
+                assert torch.equal(mod.weight, ref.get_submodule(name).weight), name
+    # the block stack is untouched
+    assert torch.equal(
+        model.transformer_blocks[0].attn.to_q.weight, ref.transformer_blocks[0].attn.to_q.weight
+    )
+
+
+def _safetensors_bytes(tensors: dict) -> bytes:
+    header, blobs, off = {}, [], 0
+    for k, t in tensors.items():
+        raw = t.contiguous().view(torch.uint8).numpy().tobytes()
+        header[k] = {"dtype": {torch.bfloat16: "BF16", torch.float32: "F32"}[t.dtype], "shape": list(t.shape),
+                     "data_offsets": [off, off + len(raw)]}
+        blobs.append(raw)
+        off += len(raw)
+    h = json.dumps(header).encode()
+    return struct.pack("<Q", len(h)) + h + b"".join(blobs)
+
+
+def test_ranged_reads_take_only_the_asked_tensors():
+    from core.inference.video_minimax_h3_keep import _read_ranged
+
+    tensors = {"token_refiner.blocks.0.attn.out_proj.weight": torch.randn(4, 4).to(torch.bfloat16),
+               "blocks.0.mlp.fc1.weight": torch.randn(64, 32).to(torch.bfloat16)}
+    blob = _safetensors_bytes(tensors)
+    asked = []
+
+    def read(start, end):
+        asked.append((start, end))
+        return blob[start : end + 1]
+
+    got = _read_ranged(read, ["token_refiner.blocks.0.attn.out_proj.weight"])
+    assert torch.equal(got["token_refiner.blocks.0.attn.out_proj.weight"], tensors["token_refiner.blocks.0.attn.out_proj.weight"])
+    read_bytes = sum(e - s + 1 for s, e in asked)
+    assert read_bytes < len(blob) // 2  # the block weight was never read
+
+
+def test_kill_switch_and_failures_keep_the_int8_model(monkeypatch):
+    from core.inference import video_minimax_h3_keep as K
+
+    model = _tiny_h3()
+    before = {k: v.clone() for k, v in model.state_dict().items()}
+    monkeypatch.setenv(K.H3_INT8_KEEP_ENV, "0")
+    assert K.apply_h3_int8_keep(model, "unsloth/MiniMax-H3", ("FL2VA/transformer",), dtype = torch.bfloat16) == 0
+    monkeypatch.delenv(K.H3_INT8_KEEP_ENV)
+
+    def boom(*a, **k):
+        raise OSError("offline")
+
+    monkeypatch.setattr(K, "fetch_keep_tensors", boom)
+    assert K.apply_h3_int8_keep(model, "unsloth/MiniMax-H3", ("FL2VA/transformer",), dtype = torch.bfloat16) == 0
+    assert all(torch.equal(before[k], v) for k, v in model.state_dict().items())
+
+
+def test_cached_weights_are_reused_offline(tmp_path, monkeypatch):
+    from core.inference import diffusion_prequant_cache as C
+    from core.inference import video_minimax_h3_keep as K
+    from safetensors.torch import save_file
+
+    monkeypatch.setenv(C.ENV_DIR, str(tmp_path))
+    path = K._cache_file("unsloth/MiniMax-H3", "FL2VA/transformer", None)
+    path.parent.mkdir(parents = True)
+    ref = _tiny_h3()
+    save_file(_released_from(ref), str(path))
+    got = K.fetch_keep_tensors("unsloth/MiniMax-H3", "FL2VA/transformer", local_files_only = True)
+    assert set(got) == set(_released_from(ref))
+
+
+def test_a_wrong_mapping_is_refused():
+    from core.inference.video_minimax_h3_keep import restore_dense_keep, to_diffusers
+
+    ref = _tiny_h3()
+    model = _tiny_h3()
+    released = _released_from(ref)
+    # fc1 rows in the wrong order (a layout mistake): the swapped SwiGLU disagrees with the module it replaces
+    k = "token_refiner.blocks.0.mlp.fc1.weight"
+    released[k] = torch.cat(released[k].chunk(2, 0)[::-1], 0)
+    assert restore_dense_keep(model, to_diffusers(released), dtype = torch.bfloat16) == 0
+    assert all(torch.equal(model.state_dict()[n], ref.state_dict()[n]) for n in ref.state_dict())
