--- /dev/null
+++ b/studio/backend/core/inference/video_minimax_h3_keep.py
@@ -0,0 +1,291 @@
+# SPDX-License-Identifier: AGPL-3.0-only
+# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved. See /studio/LICENSE.AGPL-3.0
+
+"""MiniMax-H3 int8 denoiser keep list: the text side path (``token_refiner`` + ``condition_proj``, 13 Linears, 0.4 GB)
+runs at bfloat16, as ComfyUI's published int8_convrot DiT keeps it. The hosted int8 checkpoint quantized those too; at
+640x352x124 they carried most of its drift from the bf16 reference. Their released bf16 weights are read from the
+released transformer shard (ranged reads of just those tensors, or the cached shard), cached once beside the prequant
+cache, and swapped in as plain Linears before placement. ``UNSLOTH_H3_INT8_KEEP_BF16=0`` keeps the int8 ones."""
+
+from __future__ import annotations
+
+import json
+import os
+import struct
+import time
+from pathlib import Path
+from typing import Any, Optional
+
+H3_INT8_KEEP_ENV = "UNSLOTH_H3_INT8_KEEP_BF16"
+# Original (ComfyUI) layout prefixes of the Linears kept dense, as the published int8_convrot DiT header shows.
+H3_KEEP_PREFIXES = ("token_refiner.", "condition_proj.")
+_INDEX = "model.safetensors.index.json"
+_RANGE_DEADLINE_S = 600.0
+_DTYPES = {"BF16": "bfloat16", "F16": "float16", "F32": "float32"}
+
+
+def h3_int8_keep_enabled() -> bool:
+    return str(os.environ.get(H3_INT8_KEEP_ENV, "")).strip().lower() not in ("0", "off", "false", "no")
+
+
+def _keep_key(key: str) -> bool:
+    return key.startswith(H3_KEEP_PREFIXES) and key.endswith((".weight", ".bias"))
+
+
+def _cache_file(repo: str, subfolder: str, revision: Optional[str]) -> Path:
+    from .diffusion_prequant_cache import cache_root
+
+    tag = "_".join(x for x in (repo.replace("/", "--"), subfolder.replace("/", "--"), (revision or "main")[:12]) if x)
+    return cache_root() / "h3_keep" / f"{tag}.safetensors"
+
+
+def _tensor_from(raw: bytes, dtype_tag: str, shape: list) -> Any:
+    import torch
+
+    dtype = getattr(torch, _DTYPES[dtype_tag])
+    return torch.frombuffer(bytearray(raw), dtype = dtype).reshape(shape).clone()
+
+
+def _read_ranged(read: Any, wanted: list) -> dict:
+    """``{key: tensor}`` of ``wanted`` from one safetensors file through ``read(start, end)`` (inclusive)."""
+    n = struct.unpack("<Q", read(0, 7))[0]
+    header = json.loads(read(8, 8 + n - 1))
+    base = 8 + n
+    out = {}
+    for key in wanted:
+        entry = header.get(key)
+        if not isinstance(entry, dict) or entry.get("dtype") not in _DTYPES:
+            raise ValueError(f"{key}: not a readable tensor in the released shard")
+        begin, end = (int(v) for v in entry["data_offsets"])
+        out[key] = _tensor_from(read(base + begin, base + end - 1), entry["dtype"], entry["shape"])
+    return out
+
+
+def _fs_range_reader(repo: str, path: str, revision: Optional[str], hf_token: Optional[str]) -> Any:
+    """``read(start, end)`` (inclusive) through ``HfFileSystem.cat_file`` (its own redirect / Xet handling)."""
+    from huggingface_hub import HfFileSystem
+
+    fs = HfFileSystem(token = hf_token)
+    target = f"{repo}@{revision}/{path}" if revision else f"{repo}/{path}"
+
+    def _read(start: int, end: int) -> bytes:
+        data = fs.cat_file(target, start = start, end = end + 1)
+        if len(data) != end - start + 1:
+            raise OSError(f"short read: {len(data)} of {end - start + 1} bytes")
+        return data
+
+    return _read
+
+
+def fetch_keep_tensors(
+    repo: str,
+    subfolder: str,
+    *,
+    revision: Optional[str] = None,
+    hf_token: Optional[str] = None,
+    cache_dir: Optional[str] = None,
+    local_files_only: bool = False,
+    logger: Any = None,
+) -> Optional[dict]:
+    """Original-layout ``{key: tensor}`` of the kept Linears from ``repo``/``subfolder``'s released shards, or None."""
+    cached = _cache_file(repo, subfolder, revision)
+    if cached.is_file():
+        from safetensors.torch import load_file
+
+        return load_file(str(cached))
+    from huggingface_hub import hf_hub_download, hf_hub_url, try_to_load_from_cache
+
+    index_path = hf_hub_download(
+        repo,
+        f"{subfolder}/{_INDEX}",
+        revision = revision,
+        token = hf_token,
+        cache_dir = cache_dir,
+        local_files_only = local_files_only,
+    )
+    weight_map = json.loads(Path(index_path).read_text(encoding = "utf-8")).get("weight_map") or {}
+    by_shard: dict = {}
+    for key, shard in weight_map.items():
+        if _keep_key(key):
+            by_shard.setdefault(shard, []).append(key)
+    if not by_shard:
+        return None
+    tensors: dict = {}
+    t0 = time.perf_counter()
+    for shard, keys in sorted(by_shard.items()):
+        local = try_to_load_from_cache(repo, f"{subfolder}/{shard}", cache_dir = cache_dir, revision = revision)
+        if isinstance(local, str):
+            from safetensors import safe_open
+
+            with safe_open(local, framework = "pt") as fh:
+                tensors.update({k: fh.get_tensor(k) for k in keys})
+            continue
+        if local_files_only:
+            return None
+        from huggingface_hub.utils import build_hf_headers
+
+        from .prequant_header_probe import _hub_range_reader
+
+        url = hf_hub_url(repo, f"{subfolder}/{shard}", revision = revision)
+        read = _hub_range_reader(url, build_hf_headers(token = hf_token), time.monotonic() + _RANGE_DEADLINE_S)
+        try:
+            tensors.update(_read_ranged(read, keys))
+        except Exception as exc:  # noqa: BLE001 - second transport below
+            if logger is not None:
+                logger.info("video.h3_int8_keep: ranged read of %s failed (%r); retrying through HfFileSystem", shard, exc)
+            tensors.update(_read_ranged(_fs_range_reader(repo, f"{subfolder}/{shard}", revision, hf_token), keys))
+    try:
+        from safetensors.torch import save_file
+
+        cached.parent.mkdir(parents = True, exist_ok = True)
+        tmp = cached.with_suffix(".tmp")
+        save_file({k: v.contiguous() for k, v in tensors.items()}, str(tmp))
+        os.replace(tmp, cached)
+    except Exception as exc:  # noqa: BLE001 - a later load fetches again
+        if logger is not None:
+            logger.warning("video.h3_int8_keep: could not cache the kept weights: %s", exc)
+    if logger is not None:
+        logger.info(
+            "video.h3_int8_keep: read %d released bf16 tensors (%.2f GB) from %s/%s in %.1f s",
+            len(tensors),
+            sum(t.numel() * t.element_size() for t in tensors.values()) / 1e9,
+            repo,
+            subfolder,
+            time.perf_counter() - t0,
+        )
+    return tensors
+
+
+def to_diffusers(tensors: dict) -> dict:
+    """Original-layout tensors -> diffusers names (fused qkv split, SwiGLU fc1 rows reordered), via the ComfyUI map."""
+    import torch
+
+    from .video_minimax_h3_comfy import h3_comfy_key_map
+
+    out = {}
+    for key, tensor in tensors.items():
+        for name, rows in h3_comfy_key_map(key, tuple(tensor.shape)):
+            out[name] = (
+                tensor
+                if rows is None
+                else torch.cat([tensor[start : start + n] for start, n in rows], dim = 0)
+            )
+    return out
+
+
+# A swapped Linear must agree with the quantized one it replaces (same weights up to int8 error) on a probe input;
+# below this cosine the mapping is wrong and every swap is refused.
+_AGREE_MIN_COSINE = 0.98
+
+
+def _agreement(old: Any, new: Any) -> Optional[float]:
+    """Cosine of ``old(x)`` and ``new(x)`` on one random batch, or None when ``old`` cannot run here."""
+    import torch
+
+    try:
+        g = torch.Generator().manual_seed(0)
+        x = torch.randn(16, new.in_features, generator = g).to(new.weight.dtype)
+        with torch.no_grad():
+            a = old(x).float().flatten()
+            b = new(x).float().flatten()
+        return float(torch.nn.functional.cosine_similarity(a, b, dim = 0))
+    except Exception:  # noqa: BLE001 - a quantized forward that needs the device
+        return None
+
+
+def restore_dense_keep(transformer: Any, weights: dict, *, dtype: Any, logger: Any = None) -> int:
+    """Swap each kept quantized Linear for a plain Linear at ``dtype`` holding the released weights. Returns swaps.
+    Every swap is checked first against the module it replaces; one disagreement refuses them all."""
+    import torch
+    from torch import nn
+
+    plan = []
+    worst = None
+    stems = sorted({k[: -len(".weight")] for k in weights if k.endswith(".weight")})
+    for stem in stems:
+        parent_name, _, attr = stem.rpartition(".")
+        try:
+            parent = transformer.get_submodule(parent_name) if parent_name else transformer
+            old = getattr(parent, attr)
+        except (AttributeError, KeyError):
+            continue
+        weight = weights[f"{stem}.weight"]
+        out_f, in_f = weight.shape
+        bias = weights.get(f"{stem}.bias")
+        if bias is None:
+            old_bias = getattr(old, "bias", None)
+            bias = old_bias.detach() if isinstance(old_bias, torch.Tensor) else None
+        new = nn.Linear(in_f, out_f, bias = bias is not None, device = "cpu", dtype = dtype)
+        with torch.no_grad():
+            new.weight.copy_(weight.to(dtype))
+            if bias is not None:
+                new.bias.copy_(bias.to(device = "cpu", dtype = dtype))
+        new.requires_grad_(False)
+        agree = _agreement(old, new)
+        if agree is not None:
+            worst = agree if worst is None else min(worst, agree)
+            if agree < _AGREE_MIN_COSINE:
+                if logger is not None:
+                    logger.warning(
+                        "video.h3_int8_keep: %s disagrees with the quantized module (cosine %.4f); kept int8",
+                        stem,
+                        agree,
+                    )
+                return 0
+        plan.append((parent, attr, new))
+    for parent, attr, new in plan:
+        setattr(parent, attr, new)
+    swapped = len(plan)
+    if logger is not None and worst is not None:
+        logger.info("video.h3_int8_keep: swapped Linears agree with the int8 ones (min cosine %.4f)", worst)
+    if logger is not None:
+        logger.info(
+            "video.h3_int8_keep: %d text-path Linears (token_refiner, context_embedder) run at %s, as ComfyUI's "
+            "int8_convrot DiT keeps them",
+            swapped,
+            str(dtype).replace("torch.", ""),
+        )
+    return swapped
+
+
+def apply_h3_int8_keep(
+    transformer: Any,
+    repo: str,
+    subfolders: tuple,
+    *,
+    dtype: Any,
+    revision: Optional[str] = None,
+    hf_token: Optional[str] = None,
+    cache_dir: Optional[str] = None,
+    local_files_only: bool = False,
+    logger: Any = None,
+) -> int:
+    """Never raises: any failure keeps the int8 Linears (the hosted model as before)."""
+    if not h3_int8_keep_enabled():
+        return 0
+    errors: list = []
+    for subfolder in subfolders:
+        try:
+            tensors = fetch_keep_tensors(
+                repo,
+                subfolder,
+                revision = revision,
+                hf_token = hf_token,
+                cache_dir = cache_dir,
+                local_files_only = local_files_only,
+                logger = logger,
+            )
+        except Exception as exc:  # noqa: BLE001
+            errors.append(f"{subfolder}: {exc!r}")
+            continue
+        if tensors:
+            try:
+                return restore_dense_keep(transformer, to_diffusers(tensors), dtype = dtype, logger = logger)
+            except Exception as exc:  # noqa: BLE001
+                errors.append(f"{subfolder}: {exc!r}")
+                break
+    if logger is not None:
+        logger.info(
+            "video.h3_int8_keep: kept the int8 text path (%s)", "; ".join(errors) or "no released shard index"
+        )
+    return 0
