+    row2, dz2 = fl._jsd_body(s.double(), t.double(), f.double(), beta, 1 / 0.9, *tf, True, torch.float64)
+    torch.testing.assert_close(row.cpu().double(), row2, rtol = 1e-5, atol = 1e-6)
