+"""`higher_precision_softmax` appends `.to(<first argument>.dtype)`: a compound first argument
+(Falcon's `scores + mask`, SLANet's `torch.stack(xs, dim=1)`) must be left as written."""
+
+import ast
+
+import pytest
+import torch
+import torch.nn.functional as F
+
+from unsloth_zoo import compiler
+
+
+FALCON_LINES = [
+    "attention_scores = F.softmax(attention_scores + attention_mask, dim=-1, dtype=hidden_states.dtype)\n",
+    "attention_probs = F.softmax(attention_logits + attention_mask, dim=-1, dtype=hidden_states.dtype)\n",
+]
