+        return -(fused_linear_logprobs(h, w, t, mask = mask)).sum() / mask.sum()
+
+    compiled = torch.compile(step, backend = cnt, fullgraph = True)
+    n = fl.CALLS["flash"]
+    hc = h.clone().requires_grad_(True)
