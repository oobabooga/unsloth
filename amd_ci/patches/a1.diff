+@pytest.mark.parametrize("device", DEVICES)
+@pytest.mark.parametrize("path", ["qkv", "mlp"])
+@pytest.mark.parametrize("alphas", ["equal", "mixed"])
+def test_fp16_shares_the_lora_gemms_in_the_base_then_lora_order(device, path, alphas, monkeypatch):
+    # fp16 keeps the base-then-LoRA order but shares X @ [A...] and the LoRA backward GEMMs; the rank-r
+    # dX term is added after the base GEMMs. Outputs, dX and LoRA grads stay within 1.5x of the unshared
+    # order's error against an fp64 oracle; UNSLOTH_LORA_SHARED_FP16=0 is the unshared order bit for bit.
+    if device == "cpu" and path == "mlp":
+        pytest.skip("the SwiGLU kernels are Triton")
+    pattern = {"k_proj": 16, "up_proj": 16} if alphas == "mixed" else None
+    model, block = _model(device, torch.float16, pattern)
+    X0 = torch.randn(3, 5, H, device = device, dtype = torch.float16)
+    _set(monkeypatch, True)
+    runs = {}
+    for shared in (False, True):
+        monkeypatch.setattr(kernel_utils, "LORA_SHARED_FP16", shared)
+        fast_lora.LORA_SHARED_STATS.clear()
+        runs[shared] = _run(PATHS[path][0](block), model, X0)
+        engaged = dict(fast_lora.LORA_SHARED_STATS)
+        # Mixed alphas share only the forward X @ [A...]; the backward needs one scale.
+        want = {"xa": 1, "bwd": 1} if alphas == "equal" else {"xa": 1}
+        assert engaged == (want if shared else {}), (shared, engaged)
+    _set(monkeypatch, False)
+    ref = _run(PATHS[path][0](block), model, X0)
+    (out0, dX0, g0), (out1, dX1, g1) = runs[False], runs[True]
+    assert all(torch.equal(a, b) for a, b in zip(out0, ref[0])) and torch.equal(dX0, ref[1])
+    assert all(torch.equal(g0[n], ref[2][n]) for n in g0)
+    oracle_model = copy.deepcopy(model).double()
+    o_out, o_dX, o_g = _run(
+        PATHS[path][1](oracle_model.base_model.model), oracle_model, X0.double()
+    )
+    tol = 2e-3
+    for a, b, o in zip(out1, out0, o_out):
+        assert _err(a, o) <= max(tol, 1.5 * _err(b, o)), (_err(a, o), _err(b, o))
+    assert _err(dX1, o_dX) <= max(tol, 1.5 * _err(dX0, o_dX)), (_err(dX1, o_dX), _err(dX0, o_dX))
+    assert set(g1) == set(g0) == set(o_g)
+    for n in g1:
+        assert _err(g1[n], o_g[n]) <= max(tol, 1.5 * _err(g0[n], o_g[n])), (n, _err(g1[n], o_g[n]))
+
