+    assert ok(w16, None, torch.float16)
+    assert not ok(w16, None, torch.bfloat16) and not ok(w16.float(), None, torch.float16)
+    assert not ok(torch.zeros(I, H, dtype = torch.float8_e4m3fn), torch.ones(1), torch.float16)
+    monkeypatch.setattr(kernel_utils, "LORA_SHARED_FP16", False)
