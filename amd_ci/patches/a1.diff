+    torch._dynamo.reset()
+    compiled = torch.compile(PATHS["qkv"][0](block), backend = "aot_eager", fullgraph = True)
+    traced = _run(compiled, model, X0)
+    torch._dynamo.reset()
+    for a, b in zip(traced[0], eager[0]):
+        assert _err(a, b) <= 1e-5
+    assert _err(traced[1], eager[1]) <= 1e-5
+    assert all(_err(traced[2][n], eager[2][n]) <= 1e-5 for n in eager[2])
