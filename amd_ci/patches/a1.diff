+def test_fp16_shared_paths_trace_without_a_graph_break(monkeypatch):
+    # The shared fp16 forward and backward compile as one graph (no closure cells or deleted free
+    # variables in the backward: Dynamo has no DELETE_DEREF) and match the eager shared order.
+    _set(monkeypatch, True)
+    monkeypatch.setattr(kernel_utils, "LORA_SHARED_FP16", True)
+    model, block = _model("cpu", torch.float16)
+    X0 = torch.randn(3, 5, H, dtype = torch.float16)
+    eager = _run(PATHS["qkv"][0](block), model, X0)
+    torch._dynamo.reset()
+    compiled = torch.compile(PATHS["qkv"][0](block), backend = "aot_eager", fullgraph = True)
+    traced = _run(compiled, model, X0)
+    torch._dynamo.reset()
+    for a, b in zip(traced[0], eager[0]):
+        assert _err(a, b) <= 2e-3
+    assert _err(traced[1], eager[1]) <= 2e-3
+    assert set(traced[2]) == set(eager[2])
+    assert all(_err(traced[2][n], eager[2][n]) <= 2e-3 for n in eager[2])
+
+
