+def test_symbolic_length_guards_the_bucket_not_the_length(monkeypatch, compiled):
+    # comparisons only: on a SymInt each one is a range guard, never int() specialisation
+    class Sym:
+        def __init__(self, n):
+            self.n, self.compared = n, []
+
+        def __ge__(self, other):
+            self.compared.append(other)
+            return self.n >= other
+
+        def __int__(self):
+            raise AssertionError("specialised")
+
+        __index__ = __int__
+
+    n = Sym(27280)
+    assert att._rocm_flash_bucket(n) == 16384 and n.compared == [2048, 4096, 8192, 16384, 32768]
+    dit, guarded, ran, timed = _length_env(monkeypatch, {4096: 70.0})
+    monkeypatch.setattr(att, "_compiling", lambda: compiled)
+    att._ROCM_FLASH_ACTIVE[0] = (0, getattr(dit, att.ROCM_FLASH_GATE_ATTR))
+    if not compiled:
+        att._ROCM_FLASH_ACTIVE[0] = (__import__("threading").get_ident(), att._ROCM_FLASH_ACTIVE[0][1])
+    q = types.SimpleNamespace(shape = (1, Sym(27280), 2, 16), device = "cuda:0", dtype = "torch.bfloat16")
+    k = types.SimpleNamespace(shape = (1, Sym(27280), 2, 16))
+    monkeypatch.setattr(att, "_rocm_flash_capturing", lambda: compiled)
+    # an untimed bucket under compile runs native and is not timed; eager times it
+    reason = att._rocm_flash_length_reason(q, k)
+    att._ROCM_FLASH_ACTIVE[0] = None
+    if compiled:
+        assert reason == "untimed length" and timed == [4096]
+    else:
+        assert timed == [4096, 16384] and reason == "slower or inexact at this length"
+
+
+# What Studio reports follows what ran: masked calls run native call by call, unmasked ones flash, nothing is switched
+# or remembered across loads.
+
+
+class _Dit:
+    """A DiT whose forward makes attention calls (masked or not) through the guarded FLASH backend."""
+
+    def __init__(self):
+        torch = pytest.importorskip("torch")
+        self.inner = torch.nn.Module()
+        self.backends = []
+        self.inner.heads = 2
+        self.inner.to_q = torch.nn.Linear(32, 32, bias = False)
+        self.hooks = {"pre": [], "post": []}
+
+    def modules(self):
+        return iter([self.inner])
+
+    def set_attention_backend(self, name):
+        self.backends.append(name)
+
+    def register_forward_pre_hook(self, fn):
+        self.hooks["pre"].append(fn)
+        return fn
+
+    def register_forward_hook(self, fn, always_call = False):
+        self.hooks["post"].append(fn)
+        return fn
+
+    def run(self, guarded, specs):
+        """One forward making a call per ``(q_tokens, kv_tokens or None)``, unmasked."""
+        import torch
+
+        for fn in self.hooks["pre"]:
+            fn(self, ())
+        for tokens, kv in specs:
+            q = torch.zeros(1, tokens, 2, 16, dtype = torch.bfloat16)
+            k = torch.zeros(1, kv or tokens, 2, 16, dtype = torch.bfloat16)
+            guarded(q, k, k, None)
+        for fn in self.hooks["post"]:
+            fn(self, (), None)
+
+    def __call__(self, guarded, masks):
+        import torch
+
+        for fn in self.hooks["pre"]:
+            fn(self, ())
+        q = torch.zeros(1, 4096, 2, 16, dtype = torch.bfloat16)
+        for masked in masks:
+            guarded(q, q, q, attn_mask = torch.ones(1, 1, 8, 8, dtype = torch.bool) if masked else None)
+        for fn in self.hooks["post"]:
+            fn(self, (), None)
+
+
+def _guarded_flash(monkeypatch):
+    ad = pytest.importorskip("diffusers.models.attention_dispatch")
+    backends = ad._AttentionBackendRegistry._backends
+    ran = []
+
+    def fake_flash(query, key, value, attn_mask = None, **kw):
+        if attn_mask is not None:
+            raise ValueError("`attn_mask` is not supported for flash-attn 2.")
+        ran.append("flash")
+        return query
+
+    def fake_native(query, key, value, attn_mask = None, **kw):
+        ran.append("native")
+        return query
+
+    monkeypatch.setitem(backends, ad.AttentionBackendName.FLASH, fake_flash)
+    monkeypatch.setitem(backends, ad.AttentionBackendName.NATIVE, fake_native)
+    assert att._install_rocm_flash_dispatch_guard() is True
+    return backends[ad.AttentionBackendName.FLASH], ran
+
+
+def _state(pipe, backend):
+    import dataclasses
+
+    @dataclasses.dataclass(frozen = True)
+    class State:
+        pipe: object
+        attention_backend: object
+        resolved: dict
+
+    resolved = {"attention_backend": {"source": "auto", "value": backend or "native", "reason": "load"}}
+    return State(pipe, backend, resolved)
+
+
+def _load(monkeypatch):
+    dit = _Dit()
+    pipe = types.SimpleNamespace(transformer = dit)
+    assert att.apply_attention_backend(pipe, att.ROCM_FLASH_CANDIDATE, target = _target()) == "flash"
+    return dit, pipe, _state(pipe, "flash")
+
+
+@pytest.mark.parametrize(
+    "masks, backend, phrase",
+    [
+        ([True, True], None, "every attention call ran native SDPA (attn_mask: 2)"),
+        ([False, False], "flash", "on every attention call"),
+        ([True, False], "flash", "on 1 of 2 attention calls; the rest ran native SDPA (attn_mask: 1)"),
+    ],
+)
+def test_reported_backend_follows_what_ran(monkeypatch, masks, backend, phrase):
+    _rocm(monkeypatch)
+    guarded, ran = _guarded_flash(monkeypatch)
+    _apply_env(monkeypatch)
+    timed = []
+    monkeypatch.setattr(att, "_time_rocm_flash_block", _timer(timed))
+    dit, pipe, state = _load(monkeypatch)
+    att.sync_attention_state(state)
+    assert state.attention_backend == "flash"  # nothing ran yet: the load-time pick stands
+    dit(guarded, masks)
+    att.sync_attention_state(state)
+    assert ran == ["native" if m else "flash" for m in masks]
+    assert state.attention_backend == backend
+    entry = state.resolved["attention_backend"]
+    assert entry["value"] == (backend or "native") and phrase in entry["reason"] and entry["source"] == "auto"
+    # nothing was switched: the DiT keeps the flash backend, and the next unmasked call runs flash
+    assert dit.backends == ["flash"]
+    ran.clear()
+    dit(guarded, [False])
+    assert ran == ["flash"]
+
+
+def test_mixed_mask_model_keeps_flash_for_unmasked_calls_across_loads(monkeypatch, tmp_path):
+    # HunyuanVideo 1.5 style: padded batches mask, unpadded ones do not. A masked-only first run changes nothing for
+    # the next load, which serves its unmasked calls on flash.
+    _rocm(monkeypatch)
+    guarded, ran = _guarded_flash(monkeypatch)
+    _apply_env(monkeypatch)
+    timed = []
+    monkeypatch.setattr(att, "_time_rocm_flash_block", _timer(timed))
+    dit, pipe, state = _load(monkeypatch)
+    dit(guarded, [True, True])
+    att.sync_attention_state(state)
+    assert state.attention_backend is None
+    _restart(monkeypatch)
+    dit2, pipe2, state2 = _load(monkeypatch)
+    assert len(timed) == 1 and dit2.backends == ["flash"]
+    ran.clear()
+    dit2(guarded, [False, True])
+    att.sync_attention_state(state2)
+    assert ran == ["flash", "native"] and state2.attention_backend == "flash"
+    assert not list((tmp_path / "rocm_flash").glob("masked*"))
+
+
+
+def test_each_generation_reports_its_own_calls(monkeypatch):
+    # run 1 flash, run 2 masked only: run 2 reports native, not a lifetime "flash"
+    _rocm(monkeypatch)
+    guarded, ran = _guarded_flash(monkeypatch)
+    _apply_env(monkeypatch)
+    monkeypatch.setattr(att, "_time_rocm_flash_block", _timer([]))
+    dit, pipe, state = _load(monkeypatch)
+    att.begin_attention_run(state)
+    dit(guarded, [False, False])
+    att.sync_attention_state(state)
+    assert state.attention_backend == "flash"
+    att.begin_attention_run(state)
+    assert state.attention_backend == "flash"  # settled on run 1, tally zeroed
+    dit(guarded, [True, True])
+    att.sync_attention_state(state)
+    assert state.attention_backend is None
+    assert "every attention call ran native SDPA (attn_mask: 2)" in state.resolved["attention_backend"]["reason"]
+    # a later boundary settles on run 2, then run 3 is flash again
+    att.begin_attention_run(state)
+    assert state.attention_backend is None
+    dit(guarded, [False])
+    att.sync_attention_state(state)
+    assert state.attention_backend == "flash" and "on every attention call" in state.resolved["attention_backend"]["reason"]
+
+
+@pytest.mark.parametrize("module", ["core.inference.diffusion", "core.inference.video"])
+def test_both_generate_paths_mark_the_generation_boundary(module):
+    import ast
+    import importlib
+    import inspect
+
+    src = inspect.getsource(importlib.import_module(module))
+    tree = ast.parse(src)
+    gens = [n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef) and n.name == "generate"]
+    assert gens and any(
+        isinstance(c, ast.Call) and getattr(c.func, "id", None) == "begin_attention_run"
+        for g in gens
+        for c in ast.walk(g)
+    )
