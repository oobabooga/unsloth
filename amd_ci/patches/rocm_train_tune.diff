diff --git a/studio/backend/core/training/diffusion_dit_trainer.py b/studio/backend/core/training/diffusion_dit_trainer.py
index ed3daa36b7..1ca5778992 100644
--- a/studio/backend/core/training/diffusion_dit_trainer.py
+++ b/studio/backend/core/training/diffusion_dit_trainer.py
@@ -3790,6 +3790,29 @@ def _compile_engagement_warning(before, after) -> Optional[str]:
     return None
 
 
+def _install_rocm_tunableop(device) -> bool:
+    """ROCm: read the shipped / cached TunableOp GEMM tables for this run (hipBLASLt's default pick is slow at DiT
+    shapes). Read only, validator-gated, off with UNSLOTH_DIFFUSION_ROCM_TUNABLEOP=0 or any PYTORCH_TUNABLEOP_* set."""
+    if device != "cuda" or not torch_is_rocm():
+        return False
+    import logging
+
+    try:
+        from core.inference import diffusion_rocm_tunableop as rocm_tunableop
+        return bool(rocm_tunableop.install_for_training(None, logging.getLogger(__name__)))
+    except Exception as exc:  # noqa: BLE001 - keep torch's default GEMM pick
+        logging.getLogger(__name__).warning("rocm tunableop: %s", exc)
+        return False
+
+
+def _release_rocm_tunableop() -> None:
+    try:
+        from core.inference import diffusion_rocm_tunableop as rocm_tunableop
+        rocm_tunableop.release_training()
+    except Exception:  # noqa: BLE001
+        pass
+
+
 def run_dit_lora_training(
     config: DiffusionLoraConfig,
     *,
@@ -3927,6 +3950,7 @@ def run_dit_lora_training(
             )
     # Restore TF32 / cudnn.benchmark on exit, so in-process callers see no lasting change.
     perf_snap = _apply_perf_flags(cfg, device)
+    tunableop = _install_rocm_tunableop(device)
     failed = True
     try:
         out = _train_dit(
@@ -3947,6 +3971,8 @@ def run_dit_lora_training(
         return out
     finally:
         _restore_perf_flags(perf_snap)
+        if tunableop:
+            _release_rocm_tunableop()
         if launched is not None:
             launched.close(failed = failed)
 
diff --git a/studio/backend/tests/test_diffusion_rocm_tunableop.py b/studio/backend/tests/test_diffusion_rocm_tunableop.py
index 4ffc5cfcf6..c9b848e14e 100644
--- a/studio/backend/tests/test_diffusion_rocm_tunableop.py
+++ b/studio/backend/tests/test_diffusion_rocm_tunableop.py
@@ -356,3 +356,99 @@ def test_windows_and_linux_gfx1151_builds_each_get_their_own_table():
                 assert other_path not in rt.shipped_tables("gfx1151", validators)
     windows = by_hip["714"][1]
     assert windows["PT_VERSION"] == "2.11.0" and windows["HIPBLASLT_VERSION"].startswith("100401-")
+
+
+def _write_table(
+    tmp_path,
+    fake,
+    name = "gfx1151_train.csv",
+):
+    rt._STATE["owners"].clear()  # earlier tests' pipes may still hold claims
+    d = tmp_path / "tables"
+    d.mkdir(exist_ok = True)
+    rows = [f"Validator,{k},{v}" for k, v in fake.get_validators()]
+    rows.append(
+        "GemmTunableOp_BFloat16_NN,nn_3072_3840_3072_ld_3072_3072_3072,Gemm_Hipblaslt_386,1.96"
+    )
+    (d / name).write_text("\n".join(rows) + "\n", encoding = "utf-8")
+    return d / name
+
+
+def test_training_reads_the_shipped_table_never_tunes_and_release_restores(
+    fake, tmp_path, monkeypatch
+):
+    monkeypatch.delenv(rt.TUNABLEOP_ENV)
+    table = _write_table(tmp_path, fake)
+    assert rt.install_for_training()
+    assert fake.enabled and not fake.tuning
+    assert ("read", str(table)) in fake.calls
+    assert rt.is_active()
+    rt.release_training()
+    assert not fake.enabled and not rt.is_active()
+
+
+def test_training_without_a_matching_table_leaves_torch_alone(fake, monkeypatch):
+    monkeypatch.delenv(rt.TUNABLEOP_ENV)
+    assert not rt.install_for_training()
+    assert not fake.enabled and not rt.is_active()
+
+
+def test_training_release_keeps_a_pipe_claim(fake, tmp_path, monkeypatch):
+    monkeypatch.delenv(rt.TUNABLEOP_ENV)
+    _write_table(tmp_path, fake)
+    pipe = _pipe(fake)
+    assert rt.install_for_pipe(pipe)
+    assert rt.install_for_training()
+    rt.release_training()
+    assert rt.is_active() and fake.enabled  # the render pipe still owns the table
+    rt.release(pipe)
+    assert not rt.is_active() and not fake.enabled
+
+
+@pytest.mark.parametrize("why", ["kill", "user", "arch"])
+def test_training_declines(fake, tmp_path, monkeypatch, why):
+    monkeypatch.delenv(rt.TUNABLEOP_ENV)
+    _write_table(tmp_path, fake)
+    if why == "kill":
+        monkeypatch.setenv(rt.TUNABLEOP_ENV, "0")
+    elif why == "user":
+        monkeypatch.setenv("PYTORCH_TUNABLEOP_ENABLED", "1")
+    else:
+        monkeypatch.setattr(rt, "_arch", lambda device = None: "gfx1100")
+    assert not rt.install_for_training()
+    assert not fake.enabled
