+    monkeypatch.setattr(ddt, "torch_is_rocm", lambda: True)
+    assert not ddt._install_rocm_tunableop("cpu")
+    assert seen == []
+    assert ddt._install_rocm_tunableop("cuda")
+    ddt._release_rocm_tunableop()
+    assert seen == ["i", "r"]
