+++ b/tests/test_fp8_rowwise_rocm_out_dtype.py
@@ -0,0 +1,21 @@
+"""ROCm rowwise torch._scaled_mm writes bf16 only (torch 2.14.0 ScaledBlas.cpp: "hipblaslt rowwise _scaled_mm only
+supports BFloat16 output"), so fp16 / fp32 FP8 rowwise calls on ROCm must keep the dequant path on every torch."""
+
+import pytest
+
+from unsloth.kernels import fp8 as F8
+
+
+@pytest.mark.parametrize(
+    "version, hip, broken",
+    [
+        ("2.13.1", None, True),
+        ("2.14.0", None, False),
+        ("2.15.0", None, False),
+        ("2.13.1", "6.4", True),
+        ("2.14.0", "7.0", True),
+        ("2.15.0", "7.1", True),
+    ],
+)
+def test_fp16_out_counts_as_broken_on_rocm(version, hip, broken):
+    assert F8._scaled_mm_fp16_out_broken(version, hip) is broken
diff --git a/unsloth/kernels/fp8.py b/unsloth/kernels/fp8.py
index 031bcdcdde..f969dba346 100644
--- a/unsloth/kernels/fp8.py
