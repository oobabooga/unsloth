+        dev = driver.active.get_current_device()
+        fast = plan.setdefault("fast", {}).get((name, dev))
+        if fast and all(t.data_ptr() % 16 == 0 for t in tensors):
+            compiled, template = fast
+            args = list(template)
+            args[: len(tensors)] = tensors
