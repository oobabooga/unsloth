+    monkeypatch.setattr(torch.cuda, "get_device_properties", boom)
+    F8._probe_fp8_l2_cache_bytes.cache_clear()
+    try:
+        assert F8._probe_fp8_l2_cache_bytes(torch.device("cuda", 0)) == 0
+    finally:
+        F8._probe_fp8_l2_cache_bytes.cache_clear()
+
