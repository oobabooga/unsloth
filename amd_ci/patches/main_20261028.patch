+L2 = 48 * 1024 * 1024  # L4
+SMALL = (6144, 2048)  # Qwen3-1.7B MLP: 24 MiB in bf16, L2 resident
+LARGE = (14336, 4096)  # Llama-3.1-8B MLP: 112 MiB in bf16
