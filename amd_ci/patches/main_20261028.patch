+            w = torch.empty(N, K, device = "cuda", dtype = torch.float8_e4m3fn)
+            s = torch.empty(N, 1, device = "cuda", dtype = torch.float32)
+            return F8._fp8_rowwise_direct_route(X, w, s)
+
+    return run
