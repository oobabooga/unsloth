+class _NoReceiverTensor(torch.Tensor):
+    # A subclass that refuses to be the receiver of an in-place GEMM, though it may be an operand.
+    def addmm_(self, *args, **kwargs):
+        raise RuntimeError("not an addmm_ receiver")
+
