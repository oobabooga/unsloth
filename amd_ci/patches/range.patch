+    model.layers[3].gate_proj = _projection(5, inputs = HIDDEN, outputs = CHANNELS)
+    assert len(keys) == 2 and len({ane._machine_key(model.layers[i], TILE, r) for i in (0, 1, 2, 3) for r in "ab"}) == 8
