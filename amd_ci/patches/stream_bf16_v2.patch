-def _empty_chunk(tokenizer: Any) -> tuple[list[int], list[float]]:
-    bos, eos, pad, _ = _special_ids(tokenizer)
-    return [bos, eos] + [pad] * CHUNK_TOKENS, [1.0] * (CHUNK_TOKENS + 2)
