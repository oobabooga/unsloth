-the penultimate layer there; matches webui-forge minimal_clip_skip). On SDXL it moves CLIP-L and OpenCLIP-G
-together, as ComfyUI's CLIPSetLastLayer (sdxl_clip.SDXLClipModel.set_clip_options) and Forge's
-StableDiffusionXL.set_clip_skip do. Variation seeds follow webui modules/rng.py;
-the base noise is still drawn by prepare_latents, so the generator advances exactly as before.
-"""
-
-from __future__ import annotations
-
-import contextlib
-import inspect
-from dataclasses import dataclass
-from typing import Any, Iterator, Optional, Sequence
-
-from .diffusion_prompt_weighting import (
-    encode_weighted_prompts,
-    exceeds_one_chunk,
-    has_prompt_syntax,
-)
-
-# A1111 CLIP skip at or below this = the family's default layer (SD 1.x would be 1).
-_CLIP_SKIP_BASE: dict[str, int] = {"sdxl": 2}
-CLIP_SKIP_MAX = 12
-GUIDANCE_RESCALE_MAX = 1.0
-# arXiv 2305.08891 sec 3.4; a recommendation only, never a load default.
-GUIDANCE_RESCALE_VPRED_HINT = 0.7
-VARY_STRENGTH = 0.15
-
-
-@dataclass(frozen = True)
-class SdControls:
-    """Request values. ``None`` everywhere = today's behaviour."""
