+        stride_y_p: tl.constexpr = Q
+        stride_y_o: tl.constexpr = P * Q
+        stride_y_k: tl.constexpr = OD * P * Q
+        stride_y_n: tl.constexpr = K_out * OD * P * Q
+    else:
