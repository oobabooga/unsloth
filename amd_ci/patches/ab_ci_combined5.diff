+    base_id = o_idx * stride_d - pad_d
+    base_ih = p_idx * stride_h - pad_h
+    base_iw = q_idx * stride_w - pad_w
+    stride_x_dd = dil_d * stride_x_d
+    stride_x_dh = dil_h * stride_x_h
+    stride_x_dw = dil_w * stride_x_w
+
