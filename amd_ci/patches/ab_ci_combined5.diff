+    x_base = (
+        X + n_idx * stride_x_n + base_id * stride_x_d + base_ih * stride_x_h + base_iw * stride_x_w
+    )
+    # Weight base: W[K_out, K_pad]
+    w_base = W + offs_n[None, :] * stride_w_kout
