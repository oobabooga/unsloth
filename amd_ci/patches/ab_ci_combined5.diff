+    y32 = _apply_activation_from_str(y32, ACTIVATION)
+    y33 = _apply_activation_from_str(y33, ACTIVATION)
+
+    if n_valid:
+        for r in tl.static_range(4):
+            p = p_start + r
+            if p < P:
+                for s in tl.static_range(4):
+                    q = q_start + s
+                    if q < Q:
+                        if r == 0:
+                            if s == 0:
+                                val = y00
+                            elif s == 1:
+                                val = y01
+                            elif s == 2:
+                                val = y02
+                            else:
