+        b = tl.load(BIAS + offs_n, mask = offs_n < K_out, other = 0.0).to(tl.float32)
+        acc += b[None, :]
+
+    acc = _apply_activation_from_str(acc, ACTIVATION)
+
+    y_ptrs = (
+        Y
+        + n_idx * stride_y_n
+        + offs_n[None, :] * stride_y_k
+        + od_idx * stride_y_o
+        + p_idx * stride_y_p
+        + q_idx * stride_y_q
+    )
+    tl.store(y_ptrs, acc, mask = (m_mask[:, None] & kout_mask[None, :]))
