+    def grid(meta):
+        return (
+            triton.cdiv(spatial, meta["BLOCK_M"]),
+            triton.cdiv(C_pad, meta["BLOCK_C"]),
+            N,
+        )
+
+    _ncx_to_cblocked_kernel[grid](
+        x,
+        x_blocked,
+        C,
+        spatial,
+        C_PAD = C_pad,
+        CB = block_c,
+        **config,
+    )
