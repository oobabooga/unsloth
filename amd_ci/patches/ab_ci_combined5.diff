+    (1, 8, 3, 6, 6, 16, (3, 3, 3), 1, 1),
+    (1, 64, 3, 6, 6, 64, (3, 3, 3), 1, (0, 1, 1)),
+    (1, 160, 3, 28, 28, 96, (3, 3, 3), 1, (1, 1, 1)),
+    (1, 16, 3, 8, 8, 16, (1, 3, 3), (1, 2, 2), 0),
+]:
+    x = torch.randn(N, c, D, H, W, dtype = torch.float16)
