+C._validate_conv_devices = lambda *a, **k: None
+C._is_amd_wave32 = lambda: True
+torch.cuda.device = lambda d: contextlib.nullcontext()
+torch.manual_seed(0)
+seen = set()
+for (N, c, D, H, W, K, k, s, p) in [
