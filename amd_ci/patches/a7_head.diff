diff --git a/studio/backend/core/inference/video_vae_rocm_unfold.py b/studio/backend/core/inference/video_vae_rocm_unfold.py
new file mode 100644
index 0000000000..7ffec6d0f5
--- /dev/null
+++ b/studio/backend/core/inference/video_vae_rocm_unfold.py
@@ -0,0 +1,166 @@
+# SPDX-License-Identifier: AGPL-3.0-only
+# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved. See /studio/LICENSE.AGPL-3.0
+
+"""ROCm: run the Wan VAE decoder's temporal Conv3d as one batched Conv2d over the temporally unfolded input.
+
+A Conv3d with kernel ``[Co, C, kt, kh, kw]`` (stride 1 in time, no dilation, one group) equals a Conv2d with kernel
+``[Co, kt * C, kh, kw]`` over ``[N * T_out, kt * C, H, W]``, the ``kt`` input frames of each output frame stacked on
+the channel axis. MIOpen's Conv3d solvers on gfx1151 are far slower than its Conv2d ones on the Wan decoder's shapes,
+so the decoder runs the unfolded Conv2d instead (one launch per conv, not one per tap). The unfolded copy is chunked
+over output frames to stay under ``UNFOLD_BYTES``. Not bit-identical to the stock Conv3d (another reduction order).
+UNSLOTH_VIDEO_VAE_ROCM_UNFOLD=0 turns it off (read per call)."""
+
+from __future__ import annotations
+
+import os
+import types
+from typing import Any
+
+UNFOLD_ENV = "UNSLOTH_VIDEO_VAE_ROCM_UNFOLD"
+# The unfolded input of one Conv2d call stays under this; longer clips run in output-frame chunks.
+UNFOLD_BYTES = 2**30
+_VAE_CLASSES = frozenset({"AutoencoderKLWan"})
+_MARK = "_unsloth_rocm_unfold"
+_CALLS = "_unsloth_rocm_unfold_calls"
+_WEIGHT = "_unsloth_rocm_unfold_weight"
+
+
+def unfold_setting() -> str:
+    return (os.environ.get(UNFOLD_ENV) or "").strip().lower()
+
+
+def unfold_disabled() -> bool:
+    # A7 measurement head: on only when the env asks for it.
+    return unfold_setting() not in ("1", "true", "yes", "on")
+
+
+def platform_applies(torch: Any) -> bool:
+    from .rocm_bf16 import is_rocm_torch
+
+    return is_rocm_torch(torch)
+
+
+def _unfold_weight(conv: Any, weight: Any) -> Any:
+    """``[Co, C, kt, kh, kw]`` -> ``[Co, kt * C, kh, kw]`` (tap-major channels), cached per weight version."""
+    key = (weight.data_ptr(), weight._version, tuple(weight.shape), weight.dtype)
+    cached = getattr(conv, _WEIGHT, None)
+    if cached is not None and cached[0] == key:
+        return cached[1]
+    co, c, kt, kh, kw = weight.shape
+    w2 = weight.detach().permute(0, 2, 1, 3, 4).reshape(co, kt * c, kh, kw).contiguous()
+    setattr(conv, _WEIGHT, (key, w2))
+    return w2
+
+
+def unfold_conv3d(x: Any, weight: Any, bias: Any, w2: Any, stride: tuple, padding: tuple) -> Any:
+    """``F.conv3d(x, weight, bias, stride, padding)`` for ``stride[0] == 1``, no dilation, one group, zero padding."""
+    import torch
+    import torch.nn.functional as F
+
+    kt = int(weight.shape[2])
+    pt, ph, pw = (int(v) for v in padding)
+    if pt:
+        x = F.pad(x, (0, 0, 0, 0, pt, pt))
+    n, c, t, h, w = x.shape
+    t_out = t - kt + 1
+    per_frame = n * kt * c * h * w * x.element_size()
+    step = max(1, min(t_out, UNFOLD_BYTES // max(per_frame, 1)))
+    outs = []
+    for t0 in range(0, t_out, step):
+        t1 = min(t_out, t0 + step)
+        xs = x[:, :, t0 : t1 + kt - 1]
+        xu = xs.unfold(2, kt, 1).permute(0, 2, 5, 1, 3, 4).reshape(n * (t1 - t0), kt * c, h, w)
+        y = F.conv2d(xu, w2, bias, (int(stride[1]), int(stride[2])), (ph, pw))
+        del xu
+        outs.append(y.view(n, t1 - t0, *y.shape[1:]))
+    y = outs[0] if len(outs) == 1 else torch.cat(outs, 1)
+    return y.permute(0, 2, 1, 3, 4).contiguous()
+
+
+def _autocast_on(torch: Any, device_type: str) -> bool:
+    try:
+        return bool(torch.is_autocast_enabled(device_type))
+    except TypeError:  # torch < 2.4: no device_type argument
+        return bool(torch.is_autocast_enabled())
+
+
+def _eligible(conv: Any, x: Any, weight: Any) -> bool:
+    import torch
+
+    # is_compiling first: a traced env read guards on the env value and recompiles when it flips
+    if torch.compiler.is_compiling() or unfold_disabled():
+        return False
+    if x.dim() != 5 or x.device.type != "cuda" or isinstance(conv.padding, str):
+        return False
+    if _autocast_on(torch, x.device.type):
+        return False
+    if torch.is_grad_enabled() and (x.requires_grad or weight.requires_grad):
+        return False
+    return x.dtype == weight.dtype
+
+
+def _conv_forward(self: Any, x: Any, weight: Any, bias: Any) -> Any:
+    import torch
+
+    if not _eligible(self, x, weight):
+        return torch.nn.Conv3d._conv_forward(self, x, weight, bias)
+    setattr(self, _CALLS, getattr(self, _CALLS, 0) + 1)
+    return unfold_conv3d(x, weight, bias, _unfold_weight(self, weight), self.stride, self.padding)
+
+
+def _convertible(module: Any) -> bool:
+    return (
+        int(module.kernel_size[0]) > 1
+        and int(module.stride[0]) == 1
+        and tuple(int(d) for d in module.dilation) == (1, 1, 1)
+        and int(module.groups) == 1
+        and module.padding_mode == "zeros"
+        and not isinstance(module.padding, str)
+    )
+
+
+def install(vae: Any, logger: Any = None) -> int:
+    """Patch the temporal Conv3d of ``vae.decoder`` on ROCm; returns how many carry the patch. Idempotent; skips
+    convs whose ``_conv_forward`` something else already replaced."""
+    if unfold_disabled() or type(vae).__name__ not in _VAE_CLASSES:
+        return 0
+    decoder = getattr(vae, "decoder", None)
+    if decoder is None:
+        return 0
+    import torch
+
+    if not platform_applies(torch):
+        return 0
+    patched = 0
+    for module in decoder.modules():
+        if not isinstance(module, torch.nn.Conv3d) or not _convertible(module):
+            continue
+        if getattr(module, _MARK, False):
+            patched += 1
+            continue
+        if "_conv_forward" in module.__dict__:
+            continue
+        module._conv_forward = types.MethodType(_conv_forward, module)
+        setattr(module, _MARK, True)
+        patched += 1
+    if patched and logger is not None:
+        logger.info(
+            "video.vae_rocm_unfold: %s decoder runs %d temporal Conv3d as one unfolded Conv2d each",
+            type(vae).__name__,
+            patched,
+        )
+    return patched
+
+
+def install_on_pipe(pipe: Any, target: Any, logger: Any = None) -> int:
+    if getattr(target, "device", None) != "cuda":
+        return 0
+    return install(getattr(pipe, "vae", None), logger)
+
+
+def unfold_calls(vae: Any) -> int:
+    """How many decoder Conv3d calls took the unfolded path since load."""
+    decoder = getattr(vae, "decoder", None)
+    if decoder is None:
+        return 0
+    return sum(int(getattr(m, _CALLS, 0)) for m in decoder.modules())
