+def _tiny_h3(h3, head_dim: int = 32):
+    torch.manual_seed(0)
+    return h3.MiniMaxH3Transformer3DModel(
+        num_attention_heads = 2,
+        attention_head_dim = head_dim,
+        hidden_size = 2 * head_dim,
+        num_layers = 2,
+        num_refiner_layers = 1,
+        ffn_dim = 128,
+        in_channels = 4,
+        audio_in_channels = 4,
+        patch_size = (1, 2, 2),
+        text_dim = 32,
+        freq_dim = 32,
+        time_embed_hidden_dim = 64,
+        time_embed_dim = 32,
+        rope_freq_dim = 4,
+    ).eval()
