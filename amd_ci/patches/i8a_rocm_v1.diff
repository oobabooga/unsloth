+@pytest.mark.parametrize(
+    "raw,expected",
+    [
+        (None, "auto"),
+        ("", "auto"),
+        ("auto", "auto"),
+        ("0", "off"),
+        ("off", "off"),
+        ("1", "force"),
+        ("force", "force"),
+    ],
+)
+def test_env_switch(monkeypatch, raw, expected):
+    if raw is None:
+        monkeypatch.delenv(I.INT8_ATTENTION_ENV, raising = False)
+    else:
+        monkeypatch.setenv(I.INT8_ATTENTION_ENV, raw)
+    assert I.mode() == expected
