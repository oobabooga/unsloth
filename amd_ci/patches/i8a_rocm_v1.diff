+    )
+    if not callable(dispatch):
+        raise RuntimeError("no attention dispatcher to time SageAttention with")
+
+    def sage(q: Any, k: Any, v: Any) -> Any:
+        return dispatch(
+            q,
+            k,
+            v,
+            attn_mask = None,
+            dropout_p = 0.0,
+            is_causal = False,
+            backend = backend,
+            parallel_config = None,
+        )
+
