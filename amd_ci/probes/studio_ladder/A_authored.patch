+
+test("cold provenance restores the exact 16,384/16,385-unit source and policy", () => {
+  for (const target of [
+    MAX_AUTO_HIGHLIGHT_SOURCE_CODE_UNITS,
+    MAX_AUTO_HIGHLIGHT_SOURCE_CODE_UNITS + 1,
