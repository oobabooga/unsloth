++    for temporary_patch in TEMPORARY_PATCHES:
++        try:
++            if "phase" in inspect.signature(temporary_patch).parameters:
++                temporary_patch(phase="pre_compile")
++            else:
++                temporary_patch()
++        except Exception:
++            pass
