++            else:
++                getattr(modeling_file, container)[key] = value
++        except Exception:
++            pass
++    vars(modeling_file).pop("__UNSLOTH_PATCHED__", None)
++    from unsloth_zoo.temporary_patches import TEMPORARY_PATCHES
