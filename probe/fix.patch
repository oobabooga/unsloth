+    @staticmethod
+    def _windows_apu_ceiling_is_host_ram(shared: bool, available_mib: Optional[int]) -> bool:
+        """Whether available system RAM alone already decides this device's budget, so
+        the driver does not have to be asked.
+
+        True only for a unified-memory APU on Windows, with system RAM readable.
+        ``mem_get_info`` is the last call on this path that initializes HIP on the device;
+        everything else the ROCm branch touches -- ``is_available``, ``device_count``,
+        ``get_device_properties`` -- has already run during hardware detection, so on a
+        backend that has been serving for minutes it is the one native call still being
+        made for the first time. On a Strix Halo (gfx1151) with AMD's Windows ROCm wheels
+        it has ended the backend with exit status 3, the MSVC ``abort()`` status: no
+        exception for the handler below to catch, the process simply gone, and the desktop
+        app reporting "Server stopped unexpectedly" the moment the model dropdown asked
+        what would fit.
+
+        Here it is also the one reading that decides nothing. Windows HIP reports
+        free == total on a shared pool (#7072, and ``rocm_windows_free_is_untrusted``
+        records AMD's own note that free "only accounts for memory allocated by this
+        process"), so it describes the pool rather than what is left of it, and the caller
+        takes the smaller of it and available system RAM. System RAM is what a
+        unified-memory APU actually loads into -- llama.cpp runs it with
+        GGML_CUDA_ENABLE_UNIFIED_MEMORY, which is why the total published for these
+        devices is 0 -- so it is the honest ceiling, and the only one of the two that
+        moves when something else on the host takes memory.
+
+        Everything else keeps the driver reading. Off Windows free tracks real residency,
+        so a genuinely smaller one is a floor this must not raise; a discrete card needs
+        the driver's total, which system RAM says nothing about; and an unreadable
+        MemAvailable leaves no ceiling to publish at all.
+        """
+        from utils.hardware import rocm_windows_free_is_untrusted
+
+        return shared and available_mib is not None and rocm_windows_free_is_untrusted()
+
