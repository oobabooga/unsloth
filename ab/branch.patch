+    monkeypatch.setenv("FAKE_FLM_VERSION", "1.0.3")
+    restarted = _move_the_pins(npu, monkeypatch)
+    restarted.installer.installed_version = lambda lemond: (
+        "2026.41.1" if restarted.installer.current else "11.9.0"
