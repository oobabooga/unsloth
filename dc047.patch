diff --git a/studio/frontend/src/hooks/tauri-repair-context.ts b/studio/frontend/src/hooks/tauri-repair-context.ts
index baf86048b4..5bae28a590 100644
--- a/studio/frontend/src/hooks/tauri-repair-context.ts
+++ b/studio/frontend/src/hooks/tauri-repair-context.ts
@@ -27,3 +27,23 @@ export const TauriRepairContext = createContext<TauriRepairController | null>(
 export function useTauriRepairController(): TauriRepairController | null {
   return useContext(TauriRepairContext);
 }
+
+/**
+ * Whether a click can turn this Chat only install into a full one. Only a measured `no_torch`
+ * verdict qualifies: that install left PyTorch out by request, and the manual repair reruns the
+ * installer with it. Off Mac the backend reports `no_torch` only when its PyTorch-free GPU
+ * inventory finds a card a GPU build could use; a CPU-only host reports `no_gpu`. Every other
+ * chat-only reason keeps its own hint.
+ */
+export function canUpgradeToFullInstall(
+  chatOnlyReason: string | null,
+  verdictMeasured: boolean,
+  repair: TauriRepairController | null,
+): boolean {
+  return (
+    verdictMeasured &&
+    chatOnlyReason === "no_torch" &&
+    repair !== null &&
+    !repair.isExternalServer
+  );
+}
diff --git a/studio/frontend/src/hooks/use-full-install-upgrade.ts b/studio/frontend/src/hooks/use-full-install-upgrade.ts
new file mode 100644
index 0000000000..73ff8c2789
--- /dev/null
+++ b/studio/frontend/src/hooks/use-full-install-upgrade.ts
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+// Copyright 2026-present the Unsloth AI Inc. team. All rights reserved. See /studio/LICENSE.AGPL-3.0
+
+import { usePlatformStore } from "@/config/env";
+import {
+  type TauriRepairController,
+  canUpgradeToFullInstall,
+  useTauriRepairController,
+} from "./tauri-repair-context";
+
+/** The repair controller when this Desktop install is Chat only by request, else null. */
+export function useFullInstallUpgrade(): TauriRepairController | null {
+  const repair = useTauriRepairController();
+  const chatOnlyReason = usePlatformStore((s) => s.chatOnlyReason);
+  const verdictMeasured = usePlatformStore(
+    (s) => s.isChatOnly() && !s.capabilitiesUnknown(),
+  );
+  return canUpgradeToFullInstall(chatOnlyReason, verdictMeasured, repair) ? repair : null;
+}
