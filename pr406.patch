diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index cf00d5357..8e27052f5 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4202,6 +4202,215 @@ static bool ggml_cuda_match_moe_weighted_reduction(
 }
 
 
+// one-query attention over stacked RMS-normalized states (depth mix): for each token t,
+//   x = rms_norm(cur_t), p = softmax(scale*[S_t,0..n_prev-1 . q_t, x . q_t]), out_t = sum_b p_b*S_t,b + p_n*x
+#define DEPTH_MIX_NMAX 15
+template <int NP>
+static __global__ void k_depth_mix1(
+        const float * __restrict__ cur, const int64_t cur_s2,
+        const float * __restrict__ S, const int64_t S_s1, const int64_t S_s2,
+        const float * __restrict__ q, const int64_t q_s2,
+        float * __restrict__ out, const int64_t out_s2,
+        const int E, const float eps, const float scale) {
+    extern __shared__ float smem[];
+    float * xs  = smem;                 // E
+    float * red = smem + E;             // nwarps*(NP + 1)
+
+    const int t      = blockIdx.x;
+    const int tid    = threadIdx.x;
+    const int lane   = tid % WARP_SIZE;
+    const int warp   = tid / WARP_SIZE;
+    const int nwarps = blockDim.x / WARP_SIZE;
+
+    const float * c  = cur + t*cur_s2;
+    const float * St = S   + t*S_s2;
+    const float * qt = q   + t*q_s2;
+
+    // one pass: the squares of cur and the products of the stacked states and q
+    float acc[NP + 2];
+#pragma unroll
+    for (int b = 0; b < NP + 2; ++b) {
+        acc[b] = 0.0f;
+    }
+    for (int e = tid; e < E; e += blockDim.x) {
+        const float v  = c[e];
+        const float qe = qt[e];
+        xs[e] = v;
+        acc[NP + 1] += v*v;
+        acc[NP]     += v*qe;
+#pragma unroll
+        for (int b = 0; b < NP; ++b) {
+            acc[b] += St[b*S_s1 + e]*qe;
+        }
+    }
+#pragma unroll
+    for (int b = 0; b < NP + 2; ++b) {
+        const float v = warp_reduce_sum(acc[b]);
+        if (lane == 0) {
+            red[warp*(NP + 2) + b] = v;
+        }
+    }
+    __syncthreads();
+
+    float r[NP + 2];
+#pragma unroll
+    for (int b = 0; b < NP + 2; ++b) {
+        r[b] = 0.0f;
+        for (int w = 0; w < nwarps; ++w) {
+            r[b] += red[w*(NP + 2) + b];
+        }
+    }
+    // rms_norm(cur) . q = rs*(cur . q)
+    const float rs = rsqrtf(r[NP + 1]/E + eps);
+    r[NP] *= rs;
+
+    float mx = -INFINITY;
+#pragma unroll
+    for (int b = 0; b <= NP; ++b) {
+        r[b] *= scale;
+        mx = fmaxf(mx, r[b]);
+    }
+    float sum = 0.0f;
+#pragma unroll
+    for (int b = 0; b <= NP; ++b) {
+        r[b] = expf(r[b] - mx);
+        sum += r[b];
+    }
+    const float inv = 1.0f/sum;
+#pragma unroll
+    for (int b = 0; b <= NP; ++b) {
+        r[b] *= inv;
+    }
+    const float px = r[NP]*rs;
+
+    float * ot = out + t*out_s2;
+    for (int e = tid; e < E; e += blockDim.x) {
+        float v = 0.0f;
+#pragma unroll
+        for (int b = 0; b < NP; ++b) {
+            v += St[b*S_s1 + e]*r[b];
+        }
+        ot[e] = v + xs[e]*px;
+    }
+}
+
+// true if st is the transposed stack of s built by the same concats: st = concat(.., reshape(x), 0) for
+// s = concat(.., x, 1), down to single [1, E, T] reshapes of [E, 1, T] states
+static bool ggml_cuda_depth_mix_same_stack(const ggml_tensor * st, const ggml_tensor * s, int depth) {
+    if (depth > DEPTH_MIX_NMAX) {
+        return false;
+    }
+    if (st->op == GGML_OP_RESHAPE || st->op == GGML_OP_VIEW) {
+        return st->view_src == s && st->view_offs == 0 && st->ne[0] == 1 && s->ne[1] == 1 && st->ne[1] == s->ne[0] &&
+               st->ne[2] == s->ne[2] && ggml_is_contiguous(s);
+    }
+    if (st->op == GGML_OP_CONCAT && s->op == GGML_OP_CONCAT &&
+        ggml_get_op_params_i32(st, 0) == 0 && ggml_get_op_params_i32(s, 0) == 1) {
+        return ggml_cuda_depth_mix_same_stack(st->src[0], s->src[0], depth + 1) &&
+               ggml_cuda_depth_mix_same_stack(st->src[1], s->src[1], depth + 1);
+    }
+    return false;
+}
+
+// RMS_NORM(cur) -> RESHAPE -> CONCAT(S_t, normed_t, 0) -> CONCAT(S, normed, 1) -> MUL_MAT(states, q) -> SOFT_MAX
+// -> MUL(states_t, p) -> SUM_ROWS: the one-query depth mix
+static int ggml_cuda_try_fuse_depth_mix(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
+    static const ggml_op ops[8] = { GGML_OP_RMS_NORM, GGML_OP_RESHAPE, GGML_OP_CONCAT, GGML_OP_CONCAT, GGML_OP_MUL_MAT,
+                                    GGML_OP_SOFT_MAX, GGML_OP_MUL, GGML_OP_SUM_ROWS };
+    const int n = 8;
+    if (i + n > cgraph->n_nodes) {
+        return 0;
+    }
+    ggml_tensor ** nd = cgraph->nodes + i;
+    for (int k = 0; k < n; ++k) {
+        if (nd[k]->op != ops[k] || nd[k]->type != GGML_TYPE_F32) {
+            return 0;
+        }
+    }
+    ggml_tensor * norm = nd[0], * norm_t = nd[1], * cat_t = nd[2], * cat = nd[3], * scores = nd[4], * sm = nd[5],
+                * prod = nd[6], * outp = nd[7];
+    const ggml_tensor * cur = norm->src[0];
+    const ggml_tensor * S_t = cat_t->src[0];
+    const ggml_tensor * S   = cat->src[0];
+    const ggml_tensor * q   = scores->src[1];
+    if (norm_t->view_src != norm || cat_t->src[1] != norm_t || cat->src[1] != norm || scores->src[0] != cat ||
+        sm->src[0] != scores || sm->src[1] != nullptr || prod->src[0] != cat_t || prod->src[1] != sm || outp->src[0] != prod) {
+        return 0;
+    }
+    if (ggml_get_op_params_i32(cat_t, 0) != 0 || ggml_get_op_params_i32(cat, 0) != 1) {
+        return 0;
+    }
+    // the kernel reads the stacked states once, in the [E, n_prev, T] layout of S, so S_t must hold the same values
+    if (!ggml_cuda_depth_mix_same_stack(S_t, S, 0)) {
+        return 0;
+    }
+    const int64_t E = norm->ne[0], T = norm->ne[2], n_prev = S->ne[1];
+    if (norm->ne[1] != 1 || norm->ne[3] != 1 || cur->nb[0] != sizeof(float) || cur->ne[1] != 1 ||
+        n_prev < 1 || n_prev > DEPTH_MIX_NMAX || E > 8192 ||
+        S->type != GGML_TYPE_F32 || S->ne[0] != E || S->ne[2] != T || S->ne[3] != 1 || S->nb[0] != sizeof(float) ||
+        S_t->ne[0] != n_prev || S_t->ne[1] != E || S_t->ne[2] != T ||
+        q->type != GGML_TYPE_F32 || q->ne[0] != E || q->ne[1] != 1 || (q->ne[2] != 1 && q->ne[2] != T) || q->ne[3] != 1 ||
+        q->nb[0] != sizeof(float) || scores->ne[0] != n_prev + 1 || scores->ne[1] != 1 || scores->ne[2] != T ||
+        outp->ne[0] != 1 || outp->ne[1] != E || outp->ne[2] != T || !ggml_is_contiguous(outp)) {
+        return 0;
+    }
+    float sm_scale, sm_max_bias;
+    memcpy(&sm_scale,    (const float *) sm->op_params + 0, sizeof(float));
+    memcpy(&sm_max_bias, (const float *) sm->op_params + 1, sizeof(float));
+    if (sm_max_bias != 0.0f || sm->src[2] != nullptr) {
+        return 0;
+    }
+    // intermediates used inside the chain only
+    const int uses[7] = { 2, 1, 1, 1, 1, 1, 1 };
+    for (int k = 0; k < 7; ++k) {
+        if (ggml_node_get_use_count(cgraph, i + k) != uses[k] || (nd[k]->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            return 0;
+        }
+    }
+    auto overlap = [](const ggml_tensor * a, const ggml_tensor * b) {
+        const char * a0 = (const char *) a->data, * a1 = a0 + ggml_nbytes(a);
+        const char * b0 = (const char *) b->data, * b1 = b0 + ggml_nbytes(b);
+        return a0 < b1 && b0 < a1;
+    };
+    if (overlap(outp, cur) || overlap(outp, S) || overlap(outp, q)) {
+        return 0;
+    }
+    float eps;
+    memcpy(&eps, norm->op_params, sizeof(float));
+
+    const int threads = 512;
+    const size_t smem = (E + (threads/WARP_SIZE)*(DEPTH_MIX_NMAX + 2))*sizeof(float);
+    const size_t f = sizeof(float);
+    const float * cur_d = (const float *) cur->data;
+    const float * S_d   = (const float *) S->data;
+    const float * q_d   = (const float *) q->data;
+    float       * out_d = (float *) outp->data;
+    const int64_t q_s2  = q->ne[2] == 1 ? 0 : q->nb[2]/f;
+    auto launch = [&](auto NP) {
+        k_depth_mix1<decltype(NP)::value><<<T, threads, smem, cuda_ctx->stream()>>>(
+            cur_d, cur->nb[2]/f, S_d, S->nb[1]/f, S->nb[2]/f, q_d, q_s2, out_d, outp->nb[2]/f, (int) E, eps, sm_scale);
+    };
+    switch (n_prev) {
+        case  1: launch(std::integral_constant<int,  1>{}); break;
+        case  2: launch(std::integral_constant<int,  2>{}); break;
+        case  3: launch(std::integral_constant<int,  3>{}); break;
+        case  4: launch(std::integral_constant<int,  4>{}); break;
+        case  5: launch(std::integral_constant<int,  5>{}); break;
+        case  6: launch(std::integral_constant<int,  6>{}); break;
+        case  7: launch(std::integral_constant<int,  7>{}); break;
+        case  8: launch(std::integral_constant<int,  8>{}); break;
+        case  9: launch(std::integral_constant<int,  9>{}); break;
+        case 10: launch(std::integral_constant<int, 10>{}); break;
+        case 11: launch(std::integral_constant<int, 11>{}); break;
+        case 12: launch(std::integral_constant<int, 12>{}); break;
+        case 13: launch(std::integral_constant<int, 13>{}); break;
+        case 14: launch(std::integral_constant<int, 14>{}); break;
+        case 15: launch(std::integral_constant<int, 15>{}); break;
+        default: GGML_ABORT("unsupported depth mix size");
+    }
+    return n - 1;
+}
+
