+// one-query attention over a stack of RMS-normalized states (inkling2 depth mix), built like the model:
+// the stack row-major and transposed by the same concats, the current state last
+struct test_depth_mix : public test_case {
+    const int64_t E, n_prev, T;
+    const bool q_per_token;
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "DEPTH_MIX";
