diff --git a/ggml/src/ggml-cuda/fattn-common.cuh b/ggml/src/ggml-cuda/fattn-common.cuh
index ed065b4d0..0c5fc3feb 100644
--- a/ggml/src/ggml-cuda/fattn-common.cuh
+++ b/ggml/src/ggml-cuda/fattn-common.cuh
@@ -1028,6 +1028,19 @@ static __global__ void flash_attn_combine_results(
     dst[tid] = VKQ_numerator / VKQ_denominator;
 }
 
+// banded MMA on AMD: expand sinks [n_head, n_q or 1, n_seq or 1] to a dense [n_seq, n_q, n_head] block after rel
+static __global__ void fattn_banded_sinks_expand(const float * __restrict__ src, float * __restrict__ dst,
+        const int n_head, const int64_t n_q, const int64_t n, const int64_t s1, const int64_t s2) {
+    const int64_t i = int64_t(blockIdx.x)*blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+    const int64_t h = i % n_head;
+    const int64_t q = (i / n_head) % n_q;
+    const int64_t b = i / (int64_t(n_head)*n_q);
+    dst[i] = src[h + q*s1 + b*s2];
+}
+
 template <int DV, int ncols1, int ncols2>
 void launch_fattn(
     ggml_backend_cuda_context & ctx, ggml_tensor * dst, fattn_kernel_t fattn_kernel, const int nwarps, const size_t nbytes_shared,
@@ -1302,6 +1315,24 @@ void launch_fattn(
         max_bias = -float(rel->ne[0]);
     }
 
+    // banded with sinks (AMD MMA path): rel then sinks in one pool buffer, m1 > 1.5 tells the kernel
+    const char * sinks_data = sinks ? (const char *) sinks->data : nullptr;
+    const ggml_tensor * banded_sinks = rel ? dst->src[4] : nullptr;
+    ggml_cuda_pool_alloc<float> rel_sinks(pool);
+    if (banded_sinks) {
+        GGML_ASSERT(banded_sinks->type == GGML_TYPE_F32 && banded_sinks->ne[0] == Q->ne[2]);
+        const int64_t n_rel = ggml_nelements(rel);
+        const int64_t n_snk = Q->ne[1]*Q->ne[2]*Q->ne[3];
+        rel_sinks.alloc(n_rel + n_snk);
+        CUDA_CHECK(cudaMemcpyAsync(rel_sinks.ptr, rel->data, n_rel*sizeof(float), cudaMemcpyDeviceToDevice, main_stream));
+        const int64_t s1 = banded_sinks->ne[1] > 1 ? int64_t(banded_sinks->nb[1] / sizeof(float)) : 0;
+        const int64_t s2 = banded_sinks->ne[2] > 1 ? int64_t(banded_sinks->nb[2] / sizeof(float)) : 0;
+        fattn_banded_sinks_expand<<<(n_snk + 255)/256, 256, 0, main_stream>>>(
+            (const float *) banded_sinks->data, rel_sinks.ptr + n_rel, int(Q->ne[2]), Q->ne[1], n_snk, s1, s2);
+        CUDA_CHECK(cudaGetLastError());
+        sinks_data = (const char *) rel_sinks.ptr;
+    }
+
     if (logit_softcap != 0.0f) {
         scale /= logit_softcap;
     }
@@ -1311,7 +1342,7 @@ void launch_fattn(
 
     // m0/m1 are unused for banded bias; the negative tag would otherwise blow up the exponent
     const float m0 = rel ? 1.0f : powf(2.0f, -(max_bias       ) / n_head_log2);
-    const float m1 = rel ? 1.0f : powf(2.0f, -(max_bias / 2.0f) / n_head_log2);
+    const float m1 = rel ? (banded_sinks ? 2.0f : 1.0f) : powf(2.0f, -(max_bias / 2.0f) / n_head_log2);
 
     // TODO other tensor dimensions after removal of WMMA kernel:
     const uint3 ne01 = init_fastdiv_values(Q->ne[1]);
@@ -1324,7 +1355,7 @@ void launch_fattn(
         K_data,
         V_data,
         mask ? ((const char *) mask->data) : nullptr,
-        sinks ? ((const char *) sinks->data) : nullptr,
+        sinks_data,
         KV_max.ptr,
         kv_rows ? (const int *) kv_rows->data : nullptr,
         !stream_k && parallel_blocks > 1 ? dst_tmp.ptr : (float *) KQV->data, dst_tmp_meta.ptr,
diff --git a/ggml/src/ggml-cuda/fattn-mma-f16.cuh b/ggml/src/ggml-cuda/fattn-mma-f16.cuh
index e09bc5153..debb08380 100644
--- a/ggml/src/ggml-cuda/fattn-mma-f16.cuh
+++ b/ggml/src/ggml-cuda/fattn-mma-f16.cuh
@@ -1624,7 +1624,15 @@ static __device__ __forceinline__ void flash_attn_ext_f16_process_tile(
 #pragma unroll
         for (int col = 0; col < cols_per_thread; ++col) {
             const int jc = (threadIdx.y/np)*cols_per_warp + (cols_per_warp == 8 ? T_C_KQ::get_j(col) : T_C_KQ::get_i(2*col));
-            const float sink = sinks_f[jc % ncols2];
+            float sink;
+            if (rel_f) {
+                // banded: one sink per query and head; padding columns get a finite floor to avoid NaN
+                const int64_t q_idx = int64_t(jt)*ncols1 + jc/ncols2;
+                const int     head  = head_q0 + jc % ncols2;
+                sink = q_idx < ne01.z && head < ne02 ? sinks_f[q_idx*ne02 + head] : -1e30f;
+            } else {
+                sink = sinks_f[jc % ncols2];
+            }
 
             const float KQ_max_new = fmaxf(KQ_max[col], sink);
             const float KQ_max_diff = KQ_max[col] - KQ_max_new;
@@ -2029,6 +2037,8 @@ static __global__ void flash_attn_ext_f16(
     float2     * GGML_CUDA_RESTRICT dst_meta       = dst_meta_ptr;
     const bool banded_bias = max_bias < 0.0f;
     const int  rel_extent  = banded_bias ? int(-max_bias) : 0;
+    // banded with sinks: a dense [n_seq, n_q, n_head] sink block follows rel (see launch_fattn)
+    const bool banded_sinks = banded_bias && m1 > 1.5f;
 
     // Skip unused kernel variants for faster compilation:
     if (use_logit_softcap && !(DKQ == 128 || DKQ == 256 || DKQ == 512)) {
@@ -2135,7 +2145,8 @@ static __global__ void flash_attn_ext_f16(
         float2       * dstk   = ((float2 *) dst) + (sequence*ne01.z*ne02 + zt_Q) * (DV/2);
 
         const half2 * V_h2 = V_is_K_view ? K_h2 : (const half2 *) (V + nb23*sequence + nb22*z_KV);
-        const float * sinks_f = sinks && !banded_bias ? (const float *) sinks + zt_Q : nullptr;
+        const float * sinks_f = sinks && !banded_bias ? (const float *) sinks + zt_Q :
+            (banded_sinks ? (const float *) sinks + int64_t(ne03)*ne01.z*ne02*rel_extent + int64_t(sequence)*ne01.z*ne02 : nullptr);
         const float * rel_f = banded_bias ?
             (const float *) sinks + int64_t(sequence)*ne01.z*ne02*rel_extent : nullptr;
         const int32_t * indices = use_sparse ? sparse_indices + (int64_t(sequence % ne33)*iter_j + jt)*ne11 :
@@ -2192,7 +2203,8 @@ static __global__ void flash_attn_ext_f16(
     float2       * dstk   = ((float2 *) dst) + (sequence*ne01.z*ne02 + zt_Q) * (DV/2);
 
     const half2 * V_h2 = V_is_K_view ? K_h2 : (const half2 *) (V + nb23*sequence + nb22*z_KV);
-    const float * sinks_f = sinks && !banded_bias ? (const float *) sinks + zt_Q : nullptr;
+    const float * sinks_f = sinks && !banded_bias ? (const float *) sinks + zt_Q :
+            (banded_sinks ? (const float *) sinks + int64_t(ne03)*ne01.z*ne02*rel_extent + int64_t(sequence)*ne01.z*ne02 : nullptr);
     const float * rel_f = banded_bias ?
         (const float *) sinks + int64_t(sequence)*ne01.z*ne02*rel_extent : nullptr;
     const int32_t * indices = use_sparse ? sparse_indices + (int64_t(sequence % ne33)*iter_j + jt)*ne11 :
diff --git a/ggml/src/ggml-cuda/fattn.cu b/ggml/src/ggml-cuda/fattn.cu
index a328a82fe..3c48d23c5 100644
--- a/ggml/src/ggml-cuda/fattn.cu
+++ b/ggml/src/ggml-cuda/fattn.cu
@@ -590,8 +590,18 @@ bool ggml_cuda_flash_attn_ext_banded_use_mma(const int device, const ggml_tensor
         return false;
     }
 
-    // the MMA kernel passes rel in the sinks slot
-    if (dst->src[4]) {
+    const int cc = ggml_cuda_info().devices[device].cc;
+    // AMD RDNA: the banded branch of the MMA kernel indexes rel through the portable tile layout (get_i/get_j),
+    // so it runs on WMMA too; sinks are appended after rel by launch_fattn. GGML_CUDA_BANDED_AMD_MMA=0 keeps the
+    // scalar banded kernels.
+    static const bool amd_enabled = [] {
+        const char * env = getenv("GGML_CUDA_BANDED_AMD_MMA");
+        return env == nullptr || atoi(env) != 0;
+    }();
+    const bool amd = amd_enabled && amd_wmma_available(cc) && !turing_mma_available(cc);
+
+    // the MMA kernel passes rel in the sinks slot; only the AMD path appends sinks after rel
+    if (dst->src[4] && !amd) {
         return false;
     }
 
@@ -609,7 +619,30 @@ bool ggml_cuda_flash_attn_ext_banded_use_mma(const int device, const ggml_tensor
         return false;
     }
 
-    return turing_mma_available(ggml_cuda_info().devices[device].cc);
+    if (turing_mma_available(cc)) {
+        return true;
+    }
+    if (!amd) {
+        return false;
+    }
+    // the WMMA kernel has device code only for ncols2 >= 2, i.e. when the GQA optimization applies
+    const ggml_tensor * mask = dst->src[3];
+    const int64_t n_kv = dst->src[5] ? dst->src[5]->ne[0] : K->ne[1];
+    if (!mask || mask->ne[2] != 1 || n_kv % FATTN_KQ_STRIDE != 0 || Q->ne[2] / K->ne[2] < 2) {
+        return false;
+    }
+    for (const ggml_tensor * t : {Q, K, V, mask}) {
+        if (ggml_is_quantized(t->type)) {
+            continue;
+        }
+        for (size_t i = 1; i < GGML_MAX_DIMS; ++i) {
+            if (t->nb[i] % 16 != 0) {
+                return false;
+            }
+        }
+    }
+    const ggml_tensor * sinks = dst->src[4];
+    return !sinks || (sinks->type == GGML_TYPE_F32 && sinks->ne[0] == Q->ne[2]);
 }
 
 static best_fattn_kernel ggml_cuda_get_best_fattn_kernel(const int device, const ggml_tensor * dst) {
