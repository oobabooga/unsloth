  },
  "kind": "image",
  "prompts": "image_24",
  "warmup": 1,
  "options": {
   "model_kind": "pipeline",
   "memory_mode": "auto",
   "transformer_cache": "off",
   "local_files_only": true
  }
 },
 "gate": {
  "max_util": 100,
  "min_free_mib": 4000,
  "timeout_s": 300
 },
