   "local": "$WORKSPACE/hf_tiny/tiny-qwenimage21-pipe"
  },
  "tiny_qwenimage_pipe": {
   "repo": "hf-internal-testing/tiny-qwenimage-pipe",
   "local": "$WORKSPACE/hf_tiny/tiny-qwenimage-pipe"
  },
  "tiny_sd3_pipe": {
   "repo": "hf-internal-testing/tiny-sd3-pipe",
   "local": "$WORKSPACE/hf_tiny/tiny-sd3-pipe"
  },
  "tiny_stable_diffusion_xl_pipe": {
   "repo": "hf-internal-testing/tiny-stable-diffusion-xl-pipe",
   "local": "$WORKSPACE/hf_tiny/tiny-stable-diffusion-xl-pipe"
  },
