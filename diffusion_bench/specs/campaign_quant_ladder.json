{
 "name": "campaign_quant_ladder",
 "description": "Transformer quant ladder bf16 / int8 / fp8 / nvfp4 for Z-Image-Turbo (1024, 9 steps, CFG 0), FLUX.1-schnell (1024, 4 steps, CFG 0) and Qwen-Image-2.1 (1024, 25 steps, CFG 1), all at speed_mode default (compiled): eager torchao quant is always slower than bf16, so quant arms are only compared compiled (rule 14); the two *_eager Qwen cells exist to show that, not to rank. Every quant cell is scored against its own model's bf16 in the same framework; the *_bf16_repeat cells set the noise floor (compile noise < ~0.012 LPIPS without the canonical deterministic config). An explicit scheme fails CLOSED, so a BROKEN nvfp4 cell off sm_100 is the right answer, not a harness bug; also check status.transformer_quant on every ok cell (a 'dense fp8' run once had tq=None). The TE axis (text_encoder_quant fp8) is the 'why INT8 takes 26 GB' finding: DiT int8 + bf16 TE keeps 16.33 GiB of TE resident. For n=24 like the Qwen-Image-2.1 campaigns: --set n=24.",
 "models": {
  "flux_schnell": {
   "repo": "black-forest-labs/FLUX.1-schnell",
   "local": "$WORKSPACE/hf_local_bases/black-forest-labs/FLUX.1-schnell"
  },
  "qwen_image_21": {
   "repo": "Qwen/Qwen-Image-2.1",
   "revision": "790c92633540aa0cb11d9abf19eb46d861714758",
   "local": "$WORKSPACE/temp/qwen_image_21"
  },
  "zimage_turbo": {
   "repo": "Tongyi-MAI/Z-Image-Turbo",
   "local": "$WORKSPACE/hf_local_bases/Tongyi-MAI/Z-Image-Turbo"
  }
 },
