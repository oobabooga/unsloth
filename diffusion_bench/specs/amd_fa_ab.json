    "UNSLOTH_DIFFUSION_ALLOW_OVERSIZED_LOAD": "1",
    "UNSLOTH_DIFFUSION_ROCM_COMPILE": "0"
   },
   "guidance": 0.0
  },
  {
   "tag": "zimg_off",
   "backend": "studio",
   "model": "@zimage_turbo",
   "ref": "zimg_nat",
   "width": 1024,
   "height": 1024,
   "steps": 8,
   "short_steps": 2,
   "n": 5,
   "options": {
    "family_override": "z-image",
    "model_kind": "pipeline",
    "speed_mode": "default",
    "attention_backend": "auto"
   },
   "env": {
    "TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL": "1",
    "UNSLOTH_DIFFUSION_ALLOW_OVERSIZED_LOAD": "1",
