 "baseline": {
  "source": "diffusion_bench_knowledge.md section 1.8 (Linux run 35811714004, Windows runs of amd-ci-q21-quant-win, PR 11631, PR 11713, PR 11737)",
  "qwen21_1024_20step_linux": {
   "bf16_s_per_step": 20.81,
   "bf16_peak_gib": 38.68,
   "bf16_repeat_lpips": 0.0,
