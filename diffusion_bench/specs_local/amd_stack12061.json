   "lpips_windows": 0.127
  },
  "pr11713_fbcache_linux": {
   "ref_s_per_image_cold_warm": [
    1021.9,
    219.5
   ],
   "fbcache_s_per_image_cold_warm": [
    174.3,
    176.4
   ],
   "lpips": "0.005-0.007",
   "psnr_db": "40-44"
  },
  "pr11737_static_linux": {
   "ref_s_per_image": 270.8,
   "static_s_per_image": "176.9-190.1",
   "lpips": "0.006 / 0.019"
  },
  "gemm_4096_cubed": {
   "fp16_tflops": 33.25,
   "bf16_tflops": 28.19,
   "int8_int_mm_tops": 29.61,
   "fp8_scaled_mm": "refused (MI300+ only)"
  },
  "cfg_note": "The past Qwen-Image-2.1 AMD arms ran true_cfg 4.0 with negative prompt \" \" (two forwards per step); the heavy_q21_* cells here run CFG 1 like every other harness, so compare their s/step with half the 20.81 figure at most, and treat it as a new baseline.",
  "notes": "No small-model (SDXL-Turbo / Z-Image / Wan 5B) numbers exist from past AMD runs: the first run of this spec is the baseline. Unified memory is not returned promptly after unload, so one cell per process matters even more here.",
  "tiny_note": "tiny cells have no baseline by design: every cell ok with no new sanity flag is the pass"
 },
