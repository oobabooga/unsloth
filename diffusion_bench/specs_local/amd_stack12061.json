   "fp8_native_weight_lpips": 0.147,
   "gguf_q4_k_m_speed_x": 0.93,
   "gguf_q4_k_m_lpips": 0.194,
   "metric": "LPIPS alex vs same-run bf16, 2 prompts"
  },
  "qwen21_windows": {
   "bf16_s_per_step": 25.7,
   "te_fp8_speed_x": 1.3
  },
