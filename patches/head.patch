+ROCM_ROUTES = [
+    # (gcnArchName, triton, route, route with UNSLOTH_FP8_HIP_BYTES_DEQUANT=0 = the old one).
+    # Archs without OCP fp8 take the byte decoder whatever triton can compile.
+    ("gfx1151", "3.6.0", "bytes", "triton_fp8"),  # Strix Halo: fp8e4nv emulated, ~10x slower
+    ("gfx1151", "3.4.0", "bytes", "torch"),  # no fp8e4nv here: was the torch loop
+    ("gfx1100", "3.3.1", "bytes", "torch"),
+    ("gfx1030", "3.5.0", "bytes", "triton_fp8"),
+    ("gfx90a:sramecc+:xnack-", "3.5.0", "bytes", "triton_fp8"),
+    ("gfx942:sramecc+:xnack-", "3.5.0", "bytes", "triton_fp8"),  # fnuz hardware only
+    ("gfx942:sramecc+:xnack-", "3.4.0", "bytes", "triton_fp8"),
+    ("gfx942:sramecc+:xnack-", "3.2.0", "bytes", "torch"),
+    # OCP e4m3fn hardware keeps its route: native kernel when triton has fp8e4nv, else the torch loop.
+    ("gfx950", "3.5.0", "triton_fp8", "triton_fp8"),
+    ("gfx950", "3.2.0", "torch", "torch"),
+    ("gfx1201", "3.4.0", "triton_fp8", "triton_fp8"),
+    ("gfx1201", "3.3.1", "torch", "torch"),
+]
+
