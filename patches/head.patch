+@pytest.mark.skipif(not HIP, reason = "needs a real ROCm device")
+@pytest.mark.parametrize("shape", [(4096, 4096), (14336, 4096), (4096, 14336), (130, 200)])
+@pytest.mark.parametrize("out_dtype", [torch.bfloat16, torch.float16])
+def test_real_rocm_device_takes_bytes_kernel_bit_exact(pre_sm89, monkeypatch, shape, out_dtype):
+    # Unmocked ROCm: archs without OCP fp8 must run the byte decoder, bit-equal to the torch loop
+    # and, where triton compiles fp8e4nv, to the emulated fp8 kernel it replaces.
+    m, n = shape
+    w = _weight(m, n, "cuda")
+    s = _scale(m, n, [128, 128], torch.float32, "cuda")
+    calls = []
+    orig = fp8._e4m3fn_bytes_dequant
+    monkeypatch.setattr(
+        fp8, "_e4m3fn_bytes_dequant", lambda *a, **k: calls.append(1) or orig(*a, **k)
+    )
+    out = fp8.weight_dequant(w, s, out_dtype)
+    if not fp8._rocm_lacks_ocp_fp8(w.device):
+        assert not calls
+        pytest.skip("OCP fp8 hardware: keeps the native kernel")
+    assert calls == [1]
+    _same_bits(out, fp8._torch_blockwise_dequant(w, s, [128, 128], out_dtype))
+    if m % 128 == 0 and n % 128 == 0 and not fp8._fp8_kernel_unsupported(w):
+        # NaN-free: the emulated fp8e4nv cast's NaN handling is not under test (the torch loop is).
+        raw = w.view(torch.uint8)
+        wf = torch.where((raw & 127) == 127, raw - 1, raw).view(torch.float8_e4m3fn)
+        _same_bits(
+            fp8.weight_dequant(wf, s, out_dtype), fp8.weight_dequant_block(wf, s, 128, out_dtype)
+        )
+
