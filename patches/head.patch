+# ROCm archs without OCP fp8 hardware either cannot compile fp8e4nv or emulate it in software, and both
+# routes (torch loop / emulated weight_dequant_kernel) measured up to ~10x slower than one pass over the
+# weight on gfx1151. The e4m3fn byte decoder is bit-identical, so they take it; 0 restores the old routes.
+_HIP_FP8_BYTES_DEQUANT = os.environ.get("UNSLOTH_FP8_HIP_BYTES_DEQUANT", "1") != "0"
+
+
+@functools.lru_cache(maxsize = None)
+def _rocm_lacks_ocp_fp8(device):
+    # OCP e4m3fn hardware: gfx950 (MI350) and gfx12 (RDNA4). Unknown archs keep their current route.
+    try:
+        arch = torch.cuda.get_device_properties(device).gcnArchName.split(":")[0].lower()
+    except Exception:
+        return False
+    return arch.startswith("gfx") and not (arch == "gfx950" or arch.startswith("gfx12"))
+
+
 def _fp8_kernel_unsupported(tensor, kernel_dtype = None):
     """True when triton here cannot compile this fp8 dtype, so kernels taking it must be avoided.
 
@@ -752,6 +768,18 @@ def _blockwise_weight_dequant_any_shape(weight, weight_scale, block_size, out_dt
         # Per-tensor scale: the normal forward stashes the un-expanded scalar, which repeat_interleave
         # cannot grow to (m, n).
         return (weight.to(torch.float32) * weight_scale.float()).to(out_dtype)
+    if (
+        torch.version.hip is not None
+        and _HIP_FP8_BYTES_DEQUANT
+        and weight.is_cuda
+        and weight.dtype == torch.float8_e4m3fn
+        and weight_scale.ndim == 2
+        and _rocm_lacks_ocp_fp8(weight.device)
+    ):
+        # ROCm without OCP fp8 hardware: e4m3fn only (e4m3fnuz / e5m2 keep their routes).
+        return _e4m3fn_bytes_dequant(
+            weight, weight_scale, int(block_size[0]), int(block_size[1]), out_dtype
+        )
