+/// A quarantined bundle script leaves PowerShell nothing to report but a `-File` argument error
+/// and its logo, and the logo's last line used to become the failure reason. Opened rather than
+/// tested with `exists()`: a file held by an on-access scan exists and still cannot be read.
+fn unavailable_script_message(script: &Path) -> Option<String> {
+    let err = std::fs::File::open(script).err()?;
+    let name = script
+        .file_name()
+        .map(|name| name.to_string_lossy().into_owned())
+        .unwrap_or_else(|| script.display().to_string());
+    warn!("[install] cannot open {}: {err}", script.display());
+    Some(format!(
+        "Installation failed: {name}, which Unsloth needs to finish setting up, is missing or \
+         blocked. This usually means security software quarantined it. Restore it from \
+         quarantine or reinstall Unsloth, then try again."
+    ))
+}
+
+/// Checked again after the run, because a scan can take the script when PowerShell opens it. An
+/// AMSI verdict still wins: it is the more precise account of a script that was blocked and then
+/// removed.
+fn failure_message(context: &InstallFailureContext, code: i32, script: &Path) -> String {
+    if context.security_block.is_none() {
+        if let Some(message) = unavailable_script_message(script) {
+            return message;
+        }
+    }
+    context.message(code)
+}
